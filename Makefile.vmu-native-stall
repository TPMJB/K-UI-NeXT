# B scheduling, RAM-only reader timing and gameplay capture.
BUILD ?= build/native-b-stall
include Makefile.vmu-native-background
FLAGS += -DKUI_NATIVE_READER_DIAGNOSTIC=1 -DKUI_NATIVE_STAGE_FAST_CRC=1
NATIVE_FLAGS += -DKUI_VMU_NATIVE_BACKGROUND=1 -DKUI_NATIVE_READER_DIAGNOSTIC=1

STALL_READER_FLAGS = -DKUI_NATIVE_READER_DIAGNOSTIC=1 -DKUI_RETAIL_NATIVE_HYBRID=1 \
 -DKUI_SCI_SD_NO_BLOCK=1 -DKUI_GENERAL_SCI_RESUME_FIX=1 \
 -DKUI_RETAIL_NATIVE_DISC_CHECK=1 -DKUI_RETAIL_NATIVE_DRIVE_STATE=1 \
 -DKUI_RETAIL_ASYNC_TEST=1 -DKUI_SCI_STREAM_TEST=1 \
 -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 -DKUI_RETAIL_TRANSPORT=1
STALL_READER_SRC = src/loader/retail_async.c src/loader/sci_stream.c \
 src/core/retail_cursor.c src/core/retail_image.c src/core/retail_gd.c
.PHONY: stall-host-tests
stall-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_native_reader_capture.c -o $(BUILD)/test-reader-capture
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-reader-capture
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_stage_fast_crc.c src/core/retail_image.c -o $(BUILD)/test-stage-crc
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-stage-crc
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -O2 $(STALL_READER_FLAGS) $(STALL_READER_SRC) tests/test_retail_async_stall.c -o $(BUILD)/test-stall-reader
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-stall-reader
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 tests/test_vmu_native_stall_worker.c $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-stall-worker
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-stall-worker
	python3 tools/compare_native_reader_cadence.py --diagnostic --output $(BUILD)/cadence
