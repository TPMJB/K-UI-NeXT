# SPDX-License-Identifier: GPL-3.0-only
# Exact DOA2 pilot: ordinary UI route, real SDK SCI demand delivery, no VMU.
CC = sh-elf-gcc
OBJCOPY = sh-elf-objcopy
BUILD ?= build/native-standalone-doa2
BUILD_ID ?= $(shell git rev-parse --short=12 HEAD)
CPU = -m4-single -ml -mdiv=call-div1 -mfixed-range=fr0-fr15,fpul-fpul
FLAGS = -std=c11 -Os -g -Wall -Wextra -Werror $(CPU) \
 -ffreestanding -fno-builtin -fno-stack-protector -fno-pic \
 -ffunction-sections -fdata-sections -fno-jump-tables -fstack-usage \
 -Iinclude -Isrc/loader -I$(BUILD) -DKUI_ON_CONSOLE=1 \
 -DKUI_RETAIL_LOW_RESIDENT=1 -DKUI_RETAIL_FAST_IO=1 \
 -DKUI_GENERAL_SCI_RESUME_FIX=1 -DKUI_RETAIL_NATIVE_DISC_CHECK=1 \
 -DKUI_RETAIL_NATIVE_DRIVE_STATE=1 -DKUI_RETAIL_NATIVE_HYBRID=1 \
 -DKUI_NATIVE_READER_DIAGNOSTIC=1 -DKUI_NATIVE_REQUEST_TIMING=1 \
 -DKUI_NATIVE_COOP_PUMP=1 -DKUI_NATIVE_IRQ_REARM=1 -DKUI_NATIVE_LOADER_TIMELINE=1 \
 -DKUI_NATIVE_SDK_SCI_ROUTE=1 -DKUI_NATIVE_SDK_SCI_STRUCTURAL=1 \
 -DKUI_NATIVE_STANDALONE_READER=1 -DKUI_BUILD_ID='"$(BUILD_ID)"'
RESIDENT_FLAGS = $(FLAGS) -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_ASYNC=1 \
 -DKUI_RETAIL_GD_ASYNC=1 -DKUI_SCI_SD_NO_BLOCK=1 -DKUI_RETAIL_MANIFEST_SLOTS=64 \
 -flto -mrelax -fcallgraph-info=su
STAGE_FLAGS = $(FLAGS) -DKUI_NATIVE_STANDALONE_STAGE=1
LINK = $(CPU) -nostdlib -Wl,--gc-sections -Wl,--build-id=none
RESIDENT_SRC = src/loader/retail_resident.c src/core/retail_gd.c src/loader/minic.c \
 src/core/retail_image.c src/loader/retail_display.c src/loader/sci_sd_bus.c \
 src/core/retail_cursor.c src/loader/sci_stream.c src/loader/retail_async.c
STAGE_SRC = src/loader/retail_stage.c src/loader/sd_reader.c src/loader/retail_sd.c \
 src/loader/retail_storage.c src/loader/sci_sd_bus.c src/core/ata.c \
 src/dreamcast/ata_bus.c src/loader/minic.c src/core/retail_image.c \
 src/loader/retail_display.c src/core/hash.c src/core/data.c \
 src/core/native_standalone_admission.c
RESIDENT_OBJ = $(patsubst %.c,$(BUILD)/resident/%.o,$(RESIDENT_SRC)) $(BUILD)/resident_asm.o
STAGE_OBJ = $(patsubst %.c,$(BUILD)/stage/%.o,$(STAGE_SRC)) $(BUILD)/stage_asm.o
.PHONY: all force-config
.DELETE_ON_ERROR:
all: $(BUILD)/retail-standalone-doa2.kui
force-config:
$(BUILD)/config: force-config
	@mkdir -p $(BUILD)
	@printf '%s\n' '$(BUILD_ID)' '$(FLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp
$(RESIDENT_OBJ) $(STAGE_OBJ) $(BUILD)/entry_asm.o: $(BUILD)/config
$(BUILD)/resident/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(RESIDENT_FLAGS) -MMD -MP -c $< -o $@
$(BUILD)/resident_asm.o: src/loader/retail_resident.S
	$(CC) $(RESIDENT_FLAGS) -MMD -MP -c $< -o $@
$(BUILD)/resident-sci.elf: $(RESIDENT_OBJ) src/loader/retail_resident_async_low.ld
	$(CC) -fno-tree-scev-cprop $(filter-out -ffunction-sections -fdata-sections,$(RESIDENT_FLAGS)) $(LINK) -save-temps=obj -Wl,--relax \
	 -Wl,-u,_memcpy -Wl,-u,_memset -Wl,-u,_kui_retail_resident_init \
	 -Wl,-u,_kui_retail_resident_dispatch -Wl,-u,_kui_retail_gd_dispatch \
	 -Wl,-u,_kui_retail_async_irq -Wl,-u,_kui_retail_sdk_sci_entry \
	 -Tsrc/loader/retail_resident_async_low.ld -Wl,-Map,$(BUILD)/resident-sci.map \
	 -o $@ $(RESIDENT_OBJ) -lgcc
$(BUILD)/resident-sci.bin: $(BUILD)/resident-sci.elf
	$(OBJCOPY) -O binary $< $@
$(BUILD)/standalone_symbols.h: $(BUILD)/resident-sci.elf tools/native_standalone_symbols.py
	python3 tools/native_standalone_symbols.py $< $@
$(BUILD)/stage/%.o: %.c $(BUILD)/standalone_symbols.h
	@mkdir -p $(@D)
	$(CC) $(STAGE_FLAGS) -MMD -MP -c $< -o $@
$(BUILD)/stage_asm.o: src/loader/retail_stage.S $(BUILD)/resident-sci.bin
	$(CC) $(STAGE_FLAGS) -DKUI_NATIVE_STANDALONE_RESIDENT_BIN='"$(BUILD)/resident-sci.bin"' \
	 -MMD -MP -c $< -o $@
$(BUILD)/stage.elf: $(STAGE_OBJ) src/loader/retail_stage.ld
	$(CC) $(LINK) -Tsrc/loader/retail_stage.ld -Wl,-Map,$(BUILD)/stage.map -o $@ $(STAGE_OBJ) -lgcc
$(BUILD)/stage.bin: $(BUILD)/stage.elf
	$(OBJCOPY) -O binary $< $@
$(BUILD)/entry_asm.o: src/loader/retail_entry.S $(BUILD)/stage.bin
	$(CC) $(STAGE_FLAGS) -DKUI_RETAIL_STAGE_BIN='"$(BUILD)/stage.bin"' -c $< -o $@
$(BUILD)/entry.elf: $(BUILD)/entry_asm.o src/loader/retail_entry.ld
	$(CC) $(LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,$(BUILD)/entry.map -o $@ $<
	python3 tools/record_build.py $@
$(BUILD)/retail-standalone-doa2.kui: $(BUILD)/entry.elf
	python3 tools/runtime_package.py build $< $@ --build-id $(BUILD_ID)
	python3 tools/runtime_package.py verify $@
-include $(RESIDENT_OBJ:.o=.d) $(STAGE_OBJ:.o=.d)
