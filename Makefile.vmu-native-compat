native-lease-alias-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 tests/test_vmu_native_lease_alias.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-lease-alias
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-lease-alias tests/fixtures/native-cache/sa2.nvr tests/fixtures/native-cache/skies.nvr tests/fixtures/native-cache/evolution1.nvr
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 \
	 -DKUI_VMU_NATIVE_TEST_SELF_ADDRESS=0xac38a880u tests/test_vmu_native_lease_alias.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-lease-alias-ps2
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-lease-alias-ps2 tests/fixtures/native-cache/ps2.nvr
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 \
	 -DKUI_VMU_NATIVE_TEST_SELF_ADDRESS=0xacfc0000u tests/test_vmu_native_lease_alias.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-lease-alias-grandia2
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-lease-alias-grandia2 tests/fixtures/native-cache/grandia2.nvr

native-placement-host-tests: $(BUILD)/stage.elf $(BUILD)/native-worker.bin
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_stage_placement.c \
	 src/core/vmu_native_stage_placement.c -o $(BUILD)/test-stage-placement
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-stage-placement tests/fixtures/native-cache/ps2.nvr \
	 tests/fixtures/native-cache/skies.nvr tests/fixtures/native-cache/sa2.nvr tests/fixtures/native-cache/grandia2.nvr tests/fixtures/native-cache/evolution1.nvr \
	 $(if $(EVOLUTION2_STARTUP),tests/fixtures/native-cache/evolution2.nvr,)
	python3 tests/test_vmu_native_heap_execution.py --build $(BUILD) \
	 $(if $(STARTUP),--ps2 '$(STARTUP)',) $(if $(SKIES_STARTUP),--skies '$(SKIES_STARTUP)',) \
	 $(if $(SA2_STARTUP),--sa2 '$(SA2_STARTUP)',) $(if $(GRANDIA2_STARTUP),--grandia2 '$(GRANDIA2_STARTUP)',) \
	 $(if $(EVOLUTION1_STARTUP),--evolution1 '$(EVOLUTION1_STARTUP)',) $(if $(EVOLUTION2_STARTUP),--evolution2 '$(EVOLUTION2_STARTUP)',)
	python3 tests/test_vmu_native_heap_call_execution.py \
	 $(if $(STARTUP),--ps2 '$(STARTUP)',) $(if $(SKIES_STARTUP),--skies '$(SKIES_STARTUP)',) \
	 $(if $(SA2_STARTUP),--sa2 '$(SA2_STARTUP)',) $(if $(GRANDIA2_STARTUP),--grandia2 '$(GRANDIA2_STARTUP)',) \
	 $(if $(EVOLUTION1_STARTUP),--evolution1 '$(EVOLUTION1_STARTUP)',) $(if $(EVOLUTION2_STARTUP),--evolution2 '$(EVOLUTION2_STARTUP)',) $(if $(JGR_STARTUP),--jgr '$(JGR_STARTUP)',)
	python3 tests/test_vmu_native_stage_stack_artifact.py

compat-host-tests: native-infile-buffers-host-tests native-program-host-tests native-timer-registration-host-tests $(BUILD)/retail-maple-observe.kui persistent-host-tests passive-host-tests readonly-host-tests native-placement-host-tests native-lease-alias-host-tests native-lifetime-prepared-host-tests native-layout-root-host-tests native-controller-fast-host-tests native-phase-host-tests native-cached-stack-host-tests
	KUI_NATIVE_ARTIFACT_DIR=$(BUILD) python3 tests/test_vmu_native_prepared_artifact.py
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_mode.c src/core/vmu_native_mode.c -o $(BUILD)/test-mode
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-mode
	python3 tests/test_vmu_native_mode.py
	KUI_NATIVE_ARTIFACT_DIR=$(BUILD) python3 tests/test_vmu_native_mode_artifact.py
	KUI_NATIVE_ARTIFACT_DIR=$(BUILD) python3 tests/test_vmu_native_lease_only.py
	KUI_NATIVE_ARTIFACT_DIR=$(BUILD) python3 tests/test_vmu_native_hooks_only.py
	KUI_NATIVE_ARTIFACT_DIR=$(BUILD) python3 tests/test_vmu_native_map_refusal_artifact.py
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_heap.c -o $(BUILD)/test-heap
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-heap $(if $(and $(STARTUP),$(HEAP_NEGATIVE)),'$(STARTUP)' '$(HEAP_NEGATIVE)',)
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-layout $(if $(STARTUP),'$(STARTUP)',) $(CACHE_STARTUPS)
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-exit $(if $(STARTUP),'$(STARTUP)',) $(CACHE_STARTUPS)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 tests/test_vmu_native_live.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-live
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-live
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_lifetime_stress.c \
	 src/core/vmu_native_heap.c src/core/vmu_native_lifetime.c -o $(BUILD)/test-lifetime-stress
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-lifetime-stress
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 tests/test_vmu_native_stress.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-native-stress
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-native-stress
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 tests/test_vmu_native_peripherals.c \
	 $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-peripherals
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-peripherals
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_resolution_cache.c \
	 $(COMPAT_CACHE_HOST_SRC) -o $(BUILD)/test-cache
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-cache $(if $(STARTUP),'$(STARTUP)',) $(CACHE_STARTUPS)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_cache_seed.c src/core/vmu_native_cache_seed.c \
	 $(COMPAT_CACHE_HOST_SRC) -o $(BUILD)/test-seed
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-seed tests/fixtures/native-cache/ps2.nvr \
	 tests/fixtures/native-cache/skies.nvr tests/fixtures/native-cache/sa2.nvr
	KUI_NATIVE_STARTUP=$(if $(STARTUP),'$(STARTUP)',) python3 tests/test_vmu_native_resolution_cache_tool.py
	python3 tests/test_vmu_native_cache_seed_artifact.py
	python3 tests/test_package_vmu_native_catalog.py
	$(MAKE) -s -f Makefile test-games-native-cache STARTUP=$(if $(STARTUP),'$(STARTUP)',)

