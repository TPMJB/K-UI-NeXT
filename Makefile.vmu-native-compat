	 tests/test_vmu_native_persistent.c $(COMPAT_WORKER_HOST_SRC) -Wl,--gc-sections -o $(BUILD)/test-persistent-cached-stack
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-persistent-cached-stack
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_EXPERIMENTAL=1 -DKUI_VMU_NATIVE_CACHED_CODE=1 \
