# SPDX-License-Identifier: GPL-3.0-only
# Broader reviewed native SDK families, optional pinned discovery cache.
BUILD ?= build/vmu-native-compat
include Makefile.vmu-native-performance
override TEST_ZIP := K-UI-Native-Compatibility-Test.zip
override TEST_GUIDE := docs/vmu-native-compat-test.md
FLAGS += -DKUI_VMU_NATIVE_CACHE_PROBE=1
override STAGE_SRC += src/core/vmu_native_resolution_cache.c src/core/vmu_native_cache_seed.c src/core/vmu_native_mode.c
# Included profiles append objects after the base Makefile's prerequisite
# expansion. Bind the final object sets to the reader/revision stamp as well.
$(RESIDENT_OBJ) $(STAGE_OBJ) $(NATIVE_OBJ): $(BUILD)/readonly-config
$(BUILD)/stage.elf: $(STAGE_OBJ)

COMPAT_WORKER_HOST_SRC = src/core/vmu_native_heap.c src/core/vmu_native_runtime.c \
 src/core/vmu_native_layout.c src/core/vmu_native_live.c src/core/vmu_native_lifetime.c src/core/vmu_native_profile.c \
 src/core/vmu_native_discovery.c src/core/vmu_native_patch.c src/core/hash.c src/core/data.c \
 src/core/vmu_durable.c src/core/vmu_store.c src/core/vmu_emulation.c src/core/retail_image.c \
 src/loader/vmu_readonly_overlay.c src/loader/vmu_volatile_chain.c src/loader/sd_reader.c \
 src/loader/vmu_backing.c src/dreamcast/sci_sd_storage.c
COMPAT_CACHE_HOST_SRC = src/core/vmu_native_program.c src/core/vmu_native_resolution_cache.c src/core/vmu_native_discovery.c \
 src/core/vmu_native_layout.c src/core/vmu_native_heap.c src/core/vmu_native_exit.c \
 src/core/vmu_native_patch.c src/core/hash.c src/core/data.c

.PHONY: compat-host-tests native-placement-host-tests native-lease-alias-host-tests native-lifetime-prepared-host-tests native-layout-root-host-tests native-evolution-context-host-tests native-evolution-fault-host-tests
.PHONY: native-evolution-trace-host-tests native-evolution-trace-persistent-host-tests
.PHONY: native-exception-capture-host-tests
.PHONY: native-sdk-coherence-install-host-tests
native-sdk-coherence-install-host-tests:
	@test -f '$(EVOLUTION1_STARTUP)' && test -f '$(STARTUP)' && test -f '$(SKIES_STARTUP)' && \
	 test -f '$(SA2_STARTUP)' && test -f '$(GRANDIA2_STARTUP)' || \
	 (echo 'Set EVOLUTION1_STARTUP, STARTUP, SKIES_STARTUP, SA2_STARTUP and GRANDIA2_STARTUP to the five original executables'; exit 2)
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_vmu_native_sdk_coherence.c \
	 src/loader/vmu_native_sdk_coherence.c -o $(BUILD)/test-sdk-coherence-prepare
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-sdk-coherence-prepare \
	 tests/fixtures/native-cache/evolution1.nvr tests/fixtures/native-cache/ps2.nvr \
	 tests/fixtures/native-cache/skies.nvr tests/fixtures/native-cache/sa2.nvr tests/fixtures/native-cache/grandia2.nvr \
	 $(if $(EVOLUTION2_STARTUP),tests/fixtures/native-cache/evolution2.nvr,)
	$(HOST_CC) -std=c11 -O1 -g -Wall -Wextra -Werror -fsanitize=undefined -Iinclude -Isrc/loader \
	 tests/test_vmu_native_sdk_coherence_install.c src/core/vmu_native_program.c src/core/vmu_native_heap.c \
	 src/core/vmu_native_exit.c src/core/vmu_native_patch.c src/core/hash.c src/core/data.c \
	 -o $(BUILD)/test-sdk-coherence-install
	$(BUILD)/test-sdk-coherence-install '$(EVOLUTION1_STARTUP)' '$(STARTUP)' '$(SKIES_STARTUP)' '$(SA2_STARTUP)' '$(GRANDIA2_STARTUP)' $(if $(EVOLUTION2_STARTUP),'$(EVOLUTION2_STARTUP)',)

native-exception-capture-host-tests:
	@mkdir -p $(BUILD)
	python3 tests/test_vmu_native_fault_capture.py
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -DKUI_VMU_NATIVE_FAULT_CAPTURE_HOST_TEST \
	 tests/test_vmu_native_fault_capture.c src/loader/vmu_native_fault_capture.c \
	 src/core/hash.c src/core/data.c -Wl,--gc-sections -o $(BUILD)/test-exception-capture-install
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-exception-capture-install '$(EVOLUTION1_STARTUP)'

.PHONY: native-controller-fast-host-tests
.PHONY: native-cached-stack-host-tests
