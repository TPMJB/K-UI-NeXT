BUILD ?= build/vmu-allocation-rebind-host
HOST_CC ?= cc
.DEFAULT_GOAL := vmu-allocation-rebind-tests
REBIND_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
 -ffunction-sections -fdata-sections -Iinclude -Isrc/loader
REBIND_CORE := src/core/vmu_fs_admission.c src/core/vmu_persist_profile.c \
 src/core/vmu_persist_session.c src/core/vmu_store.c src/core/vmu_image.c \
 src/core/hash.c src/core/retail_image.c src/loader/vmu_persist_stage.c src/core/vmu_durable.c
.PHONY: vmu-allocation-rebind-tests
vmu-allocation-rebind-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(REBIND_FLAGS) tests/test_vmu_allocation_rebind.c $(REBIND_CORE) \
	 -Wl,--gc-sections -o $(BUILD)/test-rebind
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-rebind
