index 0000000000000000000000000000000000000000..e855a5614bde7f6cb4d25005568885be64c84246
--- /dev/null
+++ b/docs/bench-cfgs/t1-ui-census.cfg
@@ -0,0 +1,30 @@
+# TRIP 1 - does the UI thread cost CPU?  (about 4 minutes)
+# Runs the optical, hash and SD benches once per ui_hz value: today's loop
+# ('full'), then 8, 2 and 0 redraws per second while it measures. The one
+# question: how much of each measurement was the UI thread taking?
+#
+# READ FIRST:  BENCH cpu ... ui_pct=   (share of the interval the UI thread ran)
+# THEN:        the same measurement's kib_s / cyc_b across the four passes.
+# See docs/experiment-plan.md, "Trip 1", for what the numbers decide.
+#
+# The screen freezes during the 0 pass by design. B still stops the run.
+# Use a disc whose data track covers optical_fad (any retail GD-ROM does at 45150).
+# Run it twice: once as written and once with ui_hz=0,2,8,full so a warming
+# drive cannot masquerade as a UI effect.
+
+ui_hz=full,8,2,0
+sections=optical,hash,sd
+
+optical_fad=45150
+optical_sectors=4096
+hash_mib=8
+
+# One chunk size, one transport, no preallocation: the point is the UI, not the SD.
+chunks=128
+sd_mib=8
+expand=off
+sd_if=scif
+sd_crc=on
+yield_us=2000
+
+note=T1 ui census. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t2a-optical-chunks.cfg b/docs/bench-cfgs/t2a-optical-chunks.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..7f7821c432b822da898f403051ce6371296dbda0
--- /dev/null
+++ b/docs/bench-cfgs/t2a-optical-chunks.cfg
@@ -0,0 +1,22 @@
+# TRIP 2a - optical read size, DATA track.  (about 1 minute)
+# How does the drive's read rate depend on how many sectors one command asks for?
+# Today's capture uses 32. If bigger reads are faster, the capture chunk is worth
+# raising for the optical side too, not just the SD side.
+#
+# READ: BENCH sweep ... rd=   (KiB/s inside the read command only, gap excluded)
+#       BENCH verify ... OK   (every size must return byte-identical data)
+#       BENCH poll ... n= / ms=  (short calls = CPU spinning, long = the transfer)
+# A MISMATCH line means that read size is NOT safe to use, whatever its speed.
+
+ui_hz=1
+sections=sweep
+
+sweep_fads=45150
+sweep_chunks=8,16,32,64,128
+sweep_sectors=2048
+sweep_verify=on
+sweep_gap_us=0
+sweep_service_us=0
+
+yield_us=2000
+note=T2a optical chunk sweep, data track. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t2b-optical-gap.cfg b/docs/bench-cfgs/t2b-optical-gap.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..05ef095ff80a58cd49dcd06c6f772c2e8ecace17
--- /dev/null
+++ b/docs/bench-cfgs/t2b-optical-gap.cfg
@@ -0,0 +1,23 @@
+# TRIP 2b - does the drive mind being left alone between commands?  (about 1 minute)
+# The capture loop today does ~100 ms of SD/hash work after every read command,
+# during which the drive is not being fed. gap_us spins that long (CPU busy,
+# drive idle) after each command. If the read rate holds up as the gap grows,
+# the drive re-arms cheaply and a pipeline gains only the time it hides.
+# If it collapses, the gap itself is costing revolutions: back-to-back commands
+# (a second thread or DMA) would gain more than the model says.
+#
+# Compare 'rd=' (read-only rate) across gaps at one chunk size, then kib_s (which
+# includes the gaps) to see what the loop really pays.
+
+ui_hz=1
+sections=sweep
+
+sweep_fads=45150
+sweep_chunks=32,128
+sweep_gap_us=0,2000,10000,40000
+sweep_service_us=0
+sweep_sectors=2048
+sweep_verify=off
+
+yield_us=2000
+note=T2b command gap sweep. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t2c-optical-service.cfg b/docs/bench-cfgs/t2c-optical-service.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..d8467b4b4d10ac2961b496c7e2bc187801d76154
--- /dev/null
+++ b/docs/bench-cfgs/t2c-optical-service.cfg
@@ -0,0 +1,23 @@
+# TRIP 2c - how long can the CPU be away between firmware polls?  (about 30 s)
+# A single-threaded pipeline would interleave SD writes and hashing with the
+# drive's PIO service: hash a slice, poll the drive, write a slice, poll again.
+# service_us spins that long after every poll INSIDE a read command (0 = today's
+# yield policy). The value where 'rd=' starts falling is the longest slice of
+# other work a cooperative pipeline can do between polls.
+#
+# Rule of thumb: SHA-256 runs at about 1.8 KB per ms of CPU, so 4 ms of tolerance
+# means slices of ~7 KB, which is fine enough to interleave. Under 1 ms the
+# slices are too small to be worth it and a thread or DMA is needed.
+
+ui_hz=1
+sections=sweep
+
+sweep_fads=45150
+sweep_chunks=32
+sweep_gap_us=0
+sweep_service_us=0,1000,4000,10000
+sweep_sectors=2048
+sweep_verify=off
+
+yield_us=2000
+note=T2c service gap sweep. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t2d-optical-radius.cfg b/docs/bench-cfgs/t2d-optical-radius.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..4e1cf455a7c56d8b0a4171632c22fb70e147c509
--- /dev/null
+++ b/docs/bench-cfgs/t2d-optical-radius.cfg
@@ -0,0 +1,22 @@
+# TRIP 2d - the drive's rate across the disc.  (about 1 minute)
+# GD-ROM's high-density area is constant angular velocity, so the data rate
+# rises with radius. Every earlier optical number came from one radius; this
+# gives the curve, so a prediction made at 45150 is not mistaken for the whole
+# disc's rate.
+#
+# EDIT THE FADs: they must lie inside ONE big data track of your disc. The TOC
+# lines at the top of the report ('T03 ctrl=4 start=... next=...') give its
+# range; pick four points from start+1000 to next-3000. Points the drive
+# cannot read are skipped with a log line rather than ending the run.
+
+ui_hz=1
+sections=sweep
+
+sweep_fads=45150,150000,300000,450000
+sweep_chunks=32
+sweep_gap_us=0
+sweep_sectors=2048
+sweep_verify=on
+
+yield_us=2000
+note=T2d radius sweep. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t2e-optical-audio.cfg b/docs/bench-cfgs/t2e-optical-audio.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..d419f47053364918e079d14e4a17a5f0204ed256
--- /dev/null
+++ b/docs/bench-cfgs/t2e-optical-audio.cfg
@@ -0,0 +1,27 @@
+# TRIP 2e - the AUDIO track regime.  (about 1 minute)
+# The MDK2 evidence (paired-read build, before commit f9e8958) measured an audio
+# track at 57 KiB/s with 88.5% of the time in the drive: each 32-sector command
+# took ~549 ms against 427 ms for 32 sectors at 1x CD speed. That number has not
+# been measured on the current single-read capture. This sweep measures the read
+# itself on audio: does a bigger command amortise the ~120 ms overhead, and does
+# a gap between commands matter?
+#
+# EDIT THE FAD: it must lie at least 1200 sectors inside an AUDIO track. The TOC
+# lines at the top of the report list each track ('T04 ctrl=0 start=62456 ...').
+# 63000 is inside MDK2's track 4.
+#
+# sweep_verify is OFF on purpose: raw audio may legitimately differ between two
+# reads, so a byte comparison across read sizes would report false mismatches.
+
+ui_hz=1
+sections=sweep
+
+sweep_fads=63000
+sweep_chunks=8,32,128
+sweep_gap_us=0,40000
+sweep_service_us=0
+sweep_sectors=1024
+sweep_verify=off
+
+yield_us=2000
+note=T2e audio read sweep. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t3-sd-sizes.cfg b/docs/bench-cfgs/t3-sd-sizes.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..de0adc216e10e03284e9e5c5303426bb86ad960f
--- /dev/null
+++ b/docs/bench-cfgs/t3-sd-sizes.cfg
@@ -0,0 +1,22 @@
+# TRIP 3 - SD write size and alignment.  (about 6 minutes)
+# exFAT here uses 128 KiB clusters, and FatFs splits every write at a cluster
+# boundary. A write of 75,264 bytes (today's 32-sector chunk) straddles boundaries
+# unevenly; 128 KiB and 256 KiB writes align with them. sd_bytes sets write sizes
+# in BYTES so alignment can be tested apart from the sector chunk size.
+#
+# READ: BENCH sd write ... wbytes=   and   BENCH lat write ... p50/p95/max
+# The latency line is the other half: a size can win on average and still stall.
+# 'slow=' counts calls over twice the median; 'slow_ms' is the time they added.
+# The largest max_us is the write-behind buffer a pipeline would need to absorb.
+
+ui_hz=1
+sections=sd
+
+chunks=32,128
+sd_bytes=65536,131072,262144,524288
+sd_mib=8
+expand=on
+sd_if=scif
+sd_crc=on
+
+note=T3 sd sizes. card=<model>
diff --git a/docs/bench-cfgs/t4-capture-ui.cfg b/docs/bench-cfgs/t4-capture-ui.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..3391fbbe2caf7744809e8b24184964126da67b51
--- /dev/null
+++ b/docs/bench-cfgs/t4-capture-ui.cfg
@@ -0,0 +1,22 @@
+# TRIP 4 - the same UI question on a REAL capture.  (2 x 4 minutes)
+# The bench measures stages alone; this checks the prediction on the real thing.
+# Start a NEW capture with this file, let it run about three minutes, press B,
+# and wait for the report. Then change ONLY ui_hz and do it again, on the same
+# disc and card. The last line of each capture report,
+#     BENCH cpu operation (setup+capture+verify) ... ui_pct=
+# gives the UI's share, and the CAPTURE phase average KiB/s is the answer.
+#
+# Change the next line between runs:  full  ->  2   (and 0 if you want the ceiling).
+# At 2 the progress line updates twice a second, which is readable, and the
+# screen is never frozen.
+
+ui_hz=full
+
+chunks=128
+sd_mib=8
+expand=off
+sd_if=scif
+sd_crc=on
+yield_us=2000
+
+note=T4 capture ui. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t5a-capture-matrix.cfg b/docs/bench-cfgs/t5a-capture-matrix.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..ca9aea26b2962dd2cc0be6fa6547cb879480ea9b
--- /dev/null
+++ b/docs/bench-cfgs/t5a-capture-matrix.cfg
@@ -0,0 +1,35 @@
+# TRIP 5a - what do the capture engine's choices actually cost?  (about 10 minutes)
+# Runs the REAL capture engine (not a model of it) on 4096 sectors of your disc at
+# every combination below, once with today's full UI and once at 2 redraws/s, and
+# deletes each job afterwards. For each point it prints:
+#
+#   BENCH capture ... kib_s=          the capture phase alone: the rip rate
+#   BENCH capture total ... total_kib_s=   rip PLUS the end read-back, if on: what
+#                                     the whole job costs per byte
+#   BENCH capture parts ... ms        where the capture phase went: disc, edc, write,
+#                                     read, sha, crc, ckpt (milliseconds)
+#   BENCH resume ... check=full|size  the resume prefix check on the job just made
+#   BENCH cpu capture ... ui_pct=     how much of it the UI thread took
+#
+# The decision it settles: hash=both vs crc32 (SHA-256's real cost), end=on vs off
+# (what the end read-back really adds), and full vs size resume. Compare
+# total_kib_s across rows; that is the number that matters for a finished dump.
+#
+# hash=both with end=off is allowed here (a benchmark publishes nothing) but the
+# real engine only lets CRC-only jobs skip the read-back.
+# capture_fad must be inside a DATA track (data sectors are EDC-checked).
+
+sections=capture
+ui_hz=full,2
+
+capture_hash=both,crc32
+end_readback=on,off
+resume_check=full,size
+sample_readback=0
+
+capture_sectors=4096
+capture_fad=45150
+capture_type=data
+
+yield_us=2000
+note=T5a capture matrix. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t5b-capture-sampling.cfg b/docs/bench-cfgs/t5b-capture-sampling.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..5f188b7875b10147e18de8b22cbff3d2cd5f9afd
--- /dev/null
+++ b/docs/bench-cfgs/t5b-capture-sampling.cfg
@@ -0,0 +1,23 @@
+# TRIP 5b - the price of in-flight read-back sampling.  (about 3 minutes)
+# sample_readback=N re-reads and byte-compares 1 chunk in N right after it is
+# written, so a bad write stops the capture where it happens instead of an hour
+# later at the end. This measures what that early warning costs at each rate.
+# CRC-only, end read-back off: the configuration sampling is meant to replace it in.
+#
+# READ: kib_s on the BENCH capture lines for sample=0 (off), 8, 32, 128, and
+# 'sampled=' on the total line (how many chunks were checked).
+
+sections=capture
+ui_hz=2
+
+capture_hash=crc32
+end_readback=off
+resume_check=size
+sample_readback=0,8,32,128
+
+capture_sectors=4096
+capture_fad=45150
+capture_type=data
+
+yield_us=2000
+note=T5b sampling cost. card=<model> disc=<title>
diff --git a/docs/bench-cfgs/t5c-capture-audio.cfg b/docs/bench-cfgs/t5c-capture-audio.cfg
new file mode 100644
index 0000000000000000000000000000000000000000..c55871ba272a4c09de135465125c72fc953e213e
--- /dev/null
+++ b/docs/bench-cfgs/t5c-capture-audio.cfg
@@ -0,0 +1,24 @@
+# TRIP 5c - the capture engine on an AUDIO track.  (about 3 minutes)
+# Audio is drive-bound: the CPU stages are a small part of the time, so the choices
+# that matter for data (SHA-256, end read-back) should matter far less here. This
+# measures that on the real engine rather than assuming it. Compare the capture
+# rate to T2e's drive-only rate: the gap is the whole cost of the engine.
+#
+# EDIT capture_fad: it must be at least 1500 sectors inside an AUDIO track (see the
+# TOC lines at the top of a report). 63000 is inside MDK2's track 4. Audio sectors
+# have no EDC, so nothing checks a read here except the drive.
+
+sections=capture
+ui_hz=2
+
+capture_hash=both,crc32
+end_readback=on,off
+resume_check=full
+sample_readback=0
+
+capture_sectors=1024
+capture_fad=63000
+capture_type=audio
+
+yield_us=2000
+note=T5c capture on audio. card=<model> disc=<title>
