# K-UI Wi-Fi firmware settings (both boards).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The XIAO's USB-C port is the chip's own USB serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# An update that fails to start goes back to the previous firmware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# READY is set from the SPI interrupt.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y
# 1 ms ticks: the link waits for transfers in 2 ms steps.
CONFIG_FREERTOS_HZ=1000
# Eight slots, a listener per port, lookups.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_LOCAL_HOSTNAME="kui-wifi"
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
