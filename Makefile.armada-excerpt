# Exact Armada CE audio excerpt. This adds one optional loader; normal CE,
# Toy Commander and MDK2 payload files are never build destinations here.
override ARMADA_AUDIO_DIR := build/armada-ce-excerpt
override ARMADA_AUDIO_EXTRA_FLAGS := -DKUI_ARMADA_CE_EXCERPT=1
override ARMADA_AUDIO_EXTRA_STAGE_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_EXCERPT_STAGE=1
override ARMADA_AUDIO_EXTRA_STAGE_DEPS := $(ARMADA_AUDIO_DIR)/bind-probe.bin
override ARMADA_AUDIO_EXTRA_ASM_FLAGS := -DKUI_ARMADA_CE_RAM_BIND_STAGE=1 -DKUI_ARMADA_CE_RAM_BIND_BIN='"$(ARMADA_AUDIO_DIR)/bind-probe.bin"'
override ARMADA_AUDIO_EXTRA_LINK_FLAGS := -Wl,--defsym,_kui_armada_ce_bind_probe=0x8c004000
override ARMADA_AUDIO_EXTRA_CHECK := python3 tools/check_armada_ce_excerpt.py $(ARMADA_AUDIO_DIR)
include Makefile.armada-audio

ARMADA_EXCERPT_FLAGS := $(RETAIL_FLAGS) -DKUI_RETAIL_CE=1 -DKUI_ARMADA_CE_EXCERPT=1 -fcallgraph-info=su
ARMADA_EXCERPT_OBJS := $(ARMADA_AUDIO_DIR)/bind-probe.o $(ARMADA_AUDIO_DIR)/excerpt.o $(ARMADA_AUDIO_DIR)/excerpt-asm.o $(ARMADA_AUDIO_DIR)/excerpt-minic.o

$(ARMADA_AUDIO_DIR)/bind-probe.o: src/loader/armada_ce_excerpt_entry.c include/kui/armada_ce_excerpt_entry.h include/kui/armada_ce_live_sound.h include/kui/armada_ce_excerpt.h
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_EXCERPT_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt.o: src/loader/armada_ce_excerpt.c include/kui/armada_ce_excerpt.h
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_EXCERPT_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt-asm.o: src/loader/armada_ce_excerpt.S
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_EXCERPT_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/excerpt-minic.o: src/loader/minic.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ARMADA_EXCERPT_FLAGS) -MMD -MP -c $< -o $@
$(ARMADA_AUDIO_DIR)/bind-probe.elf: $(ARMADA_EXCERPT_OBJS) src/loader/armada_ce_bind_probe.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/armada_ce_bind_probe.ld -Wl,-Map,$(@:.elf=.map) -o $@ $(ARMADA_EXCERPT_OBJS) -lgcc
$(ARMADA_AUDIO_DIR)/bind-probe.bin: $(ARMADA_AUDIO_DIR)/bind-probe.elf
	sh-elf-objcopy -O binary $< $@
$(ARMADA_AUDIO_DIR)/resident-scia.elf: $(ARMADA_AUDIO_DIR)/bind-probe.elf

-include $(ARMADA_EXCERPT_OBJS:.o=.d)
