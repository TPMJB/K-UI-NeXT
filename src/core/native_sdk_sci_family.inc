static uint16_t u16(const uint8_t *p) {return (uint16_t)p[0]|(uint16_t)p[1]<<8;}
static bool normalized(const uint8_t *p,size_t n,const uint16_t *holes,
    size_t count,const uint8_t expected[32]) {
    static const uint8_t zero[4]={0};
    struct kui_sha256 hash;uint8_t digest[32];size_t at=0u;
    kui_sha256_init(&hash);
    for(size_t i=0u;i<count;i++) {
        size_t hole=holes[i];
        if(hole<at || hole>n || n-hole<4u)return false;
        kui_sha256_update(&hash,p+at,hole-at);kui_sha256_update(&hash,zero,4u);at=hole+4u;
    }
    kui_sha256_update(&hash,p+at,n-at);kui_sha256_digest(&hash,digest);
    return !memcmp(digest,expected,sizeof(digest));
}
static bool image_span(uint32_t address,size_t bytes,uint32_t load,size_t n,size_t *at) {
    if(address<load || address-load>n || bytes>n-(address-load))return false;
    *at=address-load;return true;
}
static bool owner_span(uint32_t address,size_t bytes,uint32_t area,
    uint32_t load,size_t n,size_t *at) {
    return (address&UINT32_C(0xe0000000))==area &&
        image_span((address&UINT32_C(0x1fffffff))|UINT32_C(0x80000000),bytes,load,n,at);
}
/* MOV.L @(disp,PC),Rn, including SH's aligned PC+4 base. The full code
 * fingerprint also pins every use, branch and delay-slot instruction. */
static bool literal_at(const uint8_t *p,uint32_t address,size_t instruction,
    unsigned reg,size_t wanted) {
    uint16_t op=u16(p+instruction);
    return (op&0xff00u)==(uint16_t)(0xd000u|(reg<<8)) &&
        (((address+(uint32_t)instruction+4u)&~3u)+4u*(op&255u))==address+wanted;
}
