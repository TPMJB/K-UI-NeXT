BUILD ?= build/vc2-persist-diagnostic-host
HOST_CC ?= cc
PURE_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -ffunction-sections -fdata-sections -fno-pie -no-pie -Iinclude -Isrc/loader
SNAPSHOT_FLAGS := $(PURE_FLAGS) -fsanitize=address,undefined -fno-sanitize-recover=all \
 -DKUI_ARMADA_CE_VMU_RUNTIME_TEST=1 -DKUI_ARMADA_CE_VMU_WRITE_RUNTIME=1 \
 -DKUI_ARMADA_CE_MAPLE_WRITE_LAYOUT=1 -DKUI_ARMADA_CE_MAPLE_WRITE_STAGING=1
.PHONY: all snapshot-tests render-tests
all: snapshot-tests render-tests
snapshot-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(SNAPSHOT_FLAGS) tests/test_vc2_ce_vmu_runtime_snapshot.c \
	 -Wl,--gc-sections -o $(BUILD)/snapshot
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/snapshot
render-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PURE_FLAGS) -DKUI_NATIVE_OCRAM_BOOTSTRAP=1 \
	 -DKUI_VC2_VMU_PERSIST=1 -DKUI_ARMADA_CE_VMU_WRITE_RUNTIME=1 \
	 -DKUI_ARMADA_CE_MAPLE_WRITE_LAYOUT=1 -DKUI_ARMADA_CE_MAPLE_WRITE_STAGING=1 \
	 -DKUI_BUILD_ID='"PERSIST-TEST"' tests/test_vc2_ce_vmu_diagnostic.c \
	 src/loader/retail_display.c -Wl,--gc-sections -o $(BUILD)/render
	$(BUILD)/render $(BUILD)/page1.ppm $(BUILD)/page2.ppm $(BUILD)/page3.ppm
