# SPDX-License-Identifier: GPL-3.0-only
ifndef KOS_BASE
$(error Source .deps/kos/environ.sh before building)
endif

TARGET := build/kui-diagnostic.elf
RUNTIME := build/kui-runtime.elf
SOURCES := src/core/command.c src/core/data.c src/core/diskio.c src/core/clock.c src/core/storage_error.c src/core/storage_probe.c \
           src/core/storage_policy.c src/core/ata.c src/dreamcast/ata_bus.c \
           src/loader/sd_reader.c src/loader/sci_sd_bus.c src/dreamcast/sci_sd_storage.c \
           src/core/report.c src/core/vmu_lcd.c src/dreamcast/vmu_lcd.c \
           src/dreamcast/main.c src/dreamcast/clock.c src/dreamcast/disc.c src/dreamcast/drive_bus.c src/dreamcast/sd.c
OBJECTS := $(patsubst %.c,build/dc/%.o,$(SOURCES)) build/dc/ff.o build/dc/ffunicode.o
include config/lwext4.mk
LWEXT4_OBJECTS := $(patsubst %.c,build/dc/%.o,$(LWEXT4_SOURCES))
LOADER_OBJECTS := build/dc/src/core/runtime_image.o build/dc/src/core/runtime_file.o build/dc/src/dreamcast/bootstrap.o
LOADER_OBJECTS += build/dc/src/core/boot_volume.o build/dc/src/core/boot_image.o build/dc/src/core/ext4_boot.o $(LWEXT4_OBJECTS)
# The CD recovery menu uses the same benchmark runner as SD Diagnostics.
BENCH_OBJECTS := build/dc/src/core/hash.o build/dc/src/core/capture_plan.o build/dc/src/core/capture.o build/dc/src/core/recovery_sector.o \
    build/dc/src/core/capture_export.o build/dc/src/core/capture_export_file.o build/dc/src/core/capture_cooked.o build/dc/src/core/capture_chd.o \
    build/dc/third_party/miniz/miniz.o build/dc/third_party/minilzo/minilzo.o \
    build/dc/src/core/timing.o build/dc/src/core/destination.o build/dc/src/core/destination_file.o \
    build/dc/src/core/known_dumps.o build/dc/src/core/crc16.o \
    build/dc/src/core/settings.o build/dc/src/core/settings_file.o \
    build/dc/src/core/options.o build/dc/src/core/options_file.o build/dc/src/core/bench.o build/dc/src/dreamcast/bench.o
LOADER_OBJECTS += $(BENCH_OBJECTS)
LOADER_OBJECTS += build/dc/src/core/boot_ui.o build/dc/src/dreamcast/boot_draw.o \
    build/dc/src/dreamcast/shell_font.o build/dc/src/apps/boot_splash.o
RUNTIME_OBJECTS := $(filter-out build/dc/src/dreamcast/main.o build/dc/src/dreamcast/sd.o,$(OBJECTS)) build/dc/main-runtime.o build/dc/sd-runtime.o
RUNTIME_OBJECTS += build/dc/src/dreamcast/sci_async_probe.o build/dc/src/dreamcast/sci_async_heartbeat.o
RUNTIME_OBJECTS += $(BENCH_OBJECTS)
RUNTIME_OBJECTS += build/dc/src/core/storage_test_model.o build/dc/src/core/storage_test.o build/dc/src/core/storage_test_store.o
RUNTIME_OBJECTS += build/dc/src/dreamcast/capture.o
RUNTIME_OBJECTS += build/dc/src/dreamcast/memory.o
RUNTIME_OBJECTS += build/dc/src/core/recovery_manifest.o build/dc/src/core/recovery_scan.o build/dc/src/core/repair_copy.o
RUNTIME_OBJECTS += build/dc/src/core/network_rip.o
RUNTIME_OBJECTS += build/dc/src/core/games_selection.o build/dc/src/core/game_launch_settings.o build/dc/src/core/game_ram_patches.o
RUNTIME_OBJECTS += build/dc/src/core/vmu_launch_package.o
RUNTIME_OBJECTS += build/dc/src/core/vmu_native_cache_seed.o build/dc/src/core/vmu_native_resolution_cache.o \
    build/dc/src/core/vmu_native_discovery.o build/dc/src/core/vmu_native_layout.o \
    build/dc/src/core/vmu_native_heap.o build/dc/src/core/vmu_native_exit.o build/dc/src/core/vmu_native_patch.o
RUNTIME_OBJECTS += build/dc/src/core/game_image.o build/dc/src/core/game_metadata.o
RUNTIME_OBJECTS += build/dc/src/core/zso.o build/dc/src/core/lzo1x.o build/dc/src/core/retail_zso.o
RUNTIME_OBJECTS += build/dc/src/core/game_cover.o build/dc/src/core/pvr_texture.o
RUNTIME_OBJECTS += build/dc/src/core/files_path.o build/dc/src/core/vmu_save_format.o
RUNTIME_OBJECTS += build/dc/src/dreamcast/vmu_read_bounded.o
RUNTIME_OBJECTS += build/dc/src/core/vmu_collection.o build/dc/src/core/vmu_image.o \
    build/dc/src/core/vmu_image_subset.o build/dc/src/core/vmu_save_snapshot.o build/dc/src/core/vmu_image_pack.o \
    build/dc/src/core/vmu_description.o
RUNTIME_OBJECTS += build/dc/src/core/w5500.o build/dc/src/dreamcast/w5500_sci.o build/dc/src/core/ftp_protocol.o
# The SCI port's network adapters: its chip selects, and the Wi-Fi board's
# link, whose library is shared with the board's firmware (MIT).
RUNTIME_OBJECTS += build/dc/src/dreamcast/sci_port.o build/dc/src/dreamcast/wifi_sci.o build/dc/src/core/wifi_text.o
RUNTIME_OBJECTS += build/dc/firmware/kui-wifi/components/kwlink/kwlink.o build/dc/firmware/kui-wifi/components/kwlink/kwhost.o
RUNTIME_OBJECTS += build/dc/src/core/runtime_image.o build/dc/src/core/runtime_file.o build/dc/src/core/loader_probe.o
RUNTIME_OBJECTS += build/dc/src/core/resident_image.o
RUNTIME_OBJECTS += build/dc/src/core/retail_image.o
RUNTIME_OBJECTS += build/dc/src/core/shell.o build/dc/src/dreamcast/shell_draw.o build/dc/src/dreamcast/shell_font.o
RUNTIME_OBJECTS += build/dc/src/core/capture_display.o build/dc/src/core/viewport.o build/dc/src/core/salvage.o build/dc/src/core/recovery_crc.o
APP_SOURCES := $(filter-out src/apps/boot_splash.c,$(wildcard src/apps/*.c))
RUNTIME_OBJECTS += $(patsubst %.c,build/dc/%.o,$(APP_SOURCES))
BUILD_ID ?= $(shell git rev-parse --short=12 HEAD 2>/dev/null || echo local)

.PHONY: all force-build-id wince-cdda native-cdda
all: $(TARGET) $(RUNTIME) build/loader/entry.elf build/loader/image_entry.elf build/retail/entry.elf build/retail-bench/entry.elf build/retail-ce/entry.elf wince-cdda
all: native-zso native-lzo native-cdda
build/dc/src/apps/games_retail.o: src/apps/games_native_cache.inc include/kui/vmu_native_cache_seed.h include/kui/vmu_native_resolution_cache.h
# These separately linked, opt-in music modules retain their tested CE layout
# even when the ordinary native loader uses its lower firmware reservation.
# Explicit arguments also isolate them from a requested native diagnostic.
WINCE_CDDA_BUILD_FLAGS := KUI_RETAIL_LOW_RESIDENT=0 KUI_RETAIL_STARTUP_TRACE=0 KUI_RETAIL_SONIC_STACK_TEST=0 KUI_GENERAL_SCI_RESUME_FIX=0 KUI_CE_SCI_RESUME_FIX=1 KUI_RETAIL_RETURN_TRACE=0 KUI_RETAIL_NATIVE_DISC_CHECK=0 KUI_RETAIL_NATIVE_DRIVE_STATE=0
wince-cdda:
	$(MAKE) -f Makefile.armada-stream build/armada-ce-stream/entry.elf $(WINCE_CDDA_BUILD_FLAGS)
	$(MAKE) -f Makefile.bam4-stream build/bam4-ce-stream/entry.elf $(WINCE_CDDA_BUILD_FLAGS)
	$(MAKE) -f Makefile.worms-stream build/worms-ce-stream/entry.elf $(WINCE_CDDA_BUILD_FLAGS)
	$(MAKE) -f Makefile.wwp-stream build/wwp-ce-stream/entry.elf $(WINCE_CDDA_BUILD_FLAGS)

# Reference builds prove that broader admission leaves native playback intact.
# Only the three experimental compatibility adapters are installation payloads.
native-cdda:
	python3 tools/build_native_cdda_compat.py
include $(KOS_BASE)/Makefile.rules

CPPFLAGS += -Iinclude -Isrc/dreamcast -Isrc/loader -I.deps/fatfs/source -Ifirmware/kui-wifi/components/kwlink/include -DKUI_BUILD_ID='"$(BUILD_ID)"'
CPPFLAGS += -DKUI_RETAIL_EXTENDED_MAP=1
CPPFLAGS += -Ithird_party/miniz -Ithird_party/minilzo -DMINIZ_NO_ARCHIVE_APIS \
    -DMINIZ_NO_STDIO -DMINIZ_NO_TIME -DMINIZ_NO_ZLIB_APIS -DMINIZ_NO_MALLOC -DLZO_CFG_NO_UNALIGNED=1
# Shared freestanding buses also serve the CD bootstrap/runtime. Keep the
# console guard explicit here rather than importing KOS into their headers.
build/dc/src/dreamcast/ata_bus.o build/dc/src/loader/sci_sd_bus.o: CPPFLAGS += -DKUI_ON_CONSOLE=1
build/dc/src/loader/sd_reader.o: CPPFLAGS += -DKUI_RETAIL_FAST_IO=1
# Experimental, never-run-on-hardware code (the GD-ROM DMA probe and its competing thread) is NOT in
# the default build. Opt in with: make diagnostic KUI_EXPERIMENTAL=1
ifdef KUI_EXPERIMENTAL
CPPFLAGS += -DKUI_EXPERIMENTAL_DMA=1
endif

# Refresh the visible source identifier after every commit, even if main.c did
# not change. Relinking also records the exact source state used by packaging.
build/dc/src/dreamcast/main.o build/dc/main-runtime.o: force-build-id
force-build-id:

build/dc/%.o: %.c
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -Werror -MMD -MP $(CPPFLAGS) -c $< -o $@
build/dc/src/apps/vmu.o: src/apps/vmu_collection.inc
build/dc/src/core/ext4_boot.o: CPPFLAGS += $(LWEXT4_CPPFLAGS)
build/dc/third_party/lwext4/src/%.o: third_party/lwext4/src/%.c $(LWEXT4_HEADERS)
	@mkdir -p $(@D)
	kos-cc -std=c11 -Os -Wall -Wextra -ffunction-sections -fdata-sections -MMD -MP $(CPPFLAGS) $(LWEXT4_CPPFLAGS) -c $< -o $@
build/dc/main-runtime.o: src/dreamcast/main.c
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -Werror -MMD -MP $(CPPFLAGS) -DKUI_SD_RUNTIME=1 -c $< -o $@
build/dc/sd-runtime.o: src/dreamcast/sd.c
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -Werror -MMD -MP $(CPPFLAGS) -DKUI_SCI_ASYNC_RUNTIME=1 -c $< -o $@
build/dc/ff.o: .deps/fatfs/source/ff.c .deps/fatfs/source/ffconf.h
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -MMD -MP $(CPPFLAGS) -c $< -o $@
build/dc/ffunicode.o: .deps/fatfs/source/ffunicode.c .deps/fatfs/source/ffconf.h
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -MMD -MP $(CPPFLAGS) -c $< -o $@
$(TARGET): $(OBJECTS) $(LOADER_OBJECTS)
	kos-cc -o $@ $(OBJECTS) $(LOADER_OBJECTS) -Wl,-Map,build/kui-diagnostic.map
	python3 tools/record_build.py $@
$(RUNTIME): $(RUNTIME_OBJECTS)
	kos-cc -o $@ $(RUNTIME_OBJECTS) -lm -Wl,-Map,build/kui-runtime.map
	python3 tools/record_build.py $@

-include $(OBJECTS:.o=.d) $(LOADER_OBJECTS:.o=.d) $(RUNTIME_OBJECTS:.o=.d)

build/splash_pixels.inc build/boot_splash_pixels.inc build/startup_ogg.inc &: tools/build_splash.py resources/branding/startup.png resources/branding/boot-red.png resources/branding/startup-chime.ogg
	python3 tools/build_splash.py

build/dc/src/apps/splash.o: build/splash_pixels.inc
build/dc/src/apps/boot_splash.o: build/boot_splash_pixels.inc
build/dc/src/apps/startup_sound.o: build/startup_ogg.inc

# G3 contains no KOS/newlib runtime. The entry image packs a high resident
# service and a separately linked low client; arch_exec removes KOS first.
PROBE_FLAGS := -std=c11 -Os -g -Wall -Wextra -Werror -m4-single -ml -ffreestanding \
    -fno-builtin -fno-stack-protector -fno-pic -ffunction-sections -fdata-sections \
    -DKUI_ON_CONSOLE=1 -Iinclude -Isrc/loader -DKUI_BUILD_ID='"$(BUILD_ID)"'
PROBE_LINK := -m4-single -ml -nostdlib -Wl,--gc-sections -Wl,--build-id=none
PROBE_COMMON := build/loader/src/core/loader_probe.o build/loader/src/loader/minic.o
PROBE_CLIENT := build/loader/src/loader/client_start.o build/loader/src/loader/client.o build/loader/src/loader/minic.o
PROBE_RESIDENT := build/loader/src/loader/resident_start.o build/loader/src/loader/main.o \
    build/loader/src/loader/display.o build/loader/src/loader/sd_reader.o \
    build/loader/src/dreamcast/shell_font.o $(PROBE_COMMON)

build/loader/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(PROBE_FLAGS) -MMD -MP -c $< -o $@
build/loader/%.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(PROBE_FLAGS) -MMD -MP -c $< -o $@
build/loader/src/loader/display.o: force-build-id
build/loader/client.elf: $(PROBE_CLIENT) src/loader/client.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/client.ld -Wl,-Map,build/loader/client.map -o $@ $(PROBE_CLIENT) -lgcc
build/loader/client.bin: build/loader/client.elf
	sh-elf-objcopy -O binary $< $@
build/loader/src/loader/resident_start.o: build/loader/client.bin
build/loader/resident.elf: $(PROBE_RESIDENT) src/loader/resident.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/resident.ld -Wl,-Map,build/loader/resident.map -o $@ $(PROBE_RESIDENT) -lgcc
build/loader/resident.bin: build/loader/resident.elf
	sh-elf-objcopy -O binary $< $@
build/loader/src/loader/entry.o: build/loader/resident.bin
build/loader/entry.elf: build/loader/src/loader/entry.o src/loader/entry.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/entry.ld -Wl,-Map,build/loader/entry.map -o $@ $<
	python3 tools/record_build.py $@

-include $(PROBE_CLIENT:.o=.d) $(PROBE_RESIDENT:.o=.d) build/loader/src/loader/entry.d

# Selected-GDI BIOS request proof: separate payloads preserve the accepted G3
# fixture probe. The resident hooks the real GD vector; neither binary links KOS.
IMAGE_CLIENT := build/loader/src/loader/image_client_start.o build/loader/src/loader/image_client.o \
    build/loader/src/loader/image_client_call.o build/loader/src/loader/minic.o
IMAGE_RESIDENT := build/loader/src/loader/image_resident_start.o build/loader/src/loader/image_main.o \
    build/loader/src/loader/image_display.o build/loader/src/loader/gd_hook.o \
    build/loader/src/loader/sd_reader.o build/loader/src/dreamcast/shell_font.o \
    build/loader/src/core/resident_image.o build/loader/src/core/gd_service.o build/loader/src/loader/minic.o
build/loader/src/loader/image_display.o: force-build-id
build/loader/image_client.elf: $(IMAGE_CLIENT) src/loader/image_client.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/image_client.ld -Wl,-Map,build/loader/image_client.map -o $@ $(IMAGE_CLIENT) -lgcc
build/loader/image_client.bin: build/loader/image_client.elf
	sh-elf-objcopy -O binary $< $@
build/loader/src/loader/image_resident_start.o: build/loader/image_client.bin
build/loader/image_resident.elf: $(IMAGE_RESIDENT) src/loader/image_resident.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/image_resident.ld -Wl,-Map,build/loader/image_resident.map -o $@ $(IMAGE_RESIDENT) -lgcc
build/loader/image_resident.bin: build/loader/image_resident.elf
	sh-elf-objcopy -O binary $< $@
build/loader/src/loader/image_entry.o: build/loader/image_resident.bin
build/loader/image_entry.elf: build/loader/src/loader/image_entry.o src/loader/image_entry.ld
	sh-elf-gcc $(PROBE_LINK) -Tsrc/loader/image_entry.ld -Wl,-Map,build/loader/image_entry.map -o $@ $<
	python3 tools/record_build.py $@
-include $(IMAGE_CLIENT:.o=.d) $(IMAGE_RESIDENT:.o=.d) build/loader/src/loader/image_entry.d

# First native-GD retail experiment. Every object is independently compiled
# without floating-point instructions; the low resident must preserve whatever
# FPU register bank/precision mode the game has selected. No KOS/newlib startup
# or runtime is linked into these images. The accepted probes keep their flags.
RETAIL_CPU := -m4-single -ml -mdiv=call-div1 -mfixed-range=fr0-fr15,fpul-fpul
KUI_RETAIL_STARTUP_TRACE ?= 0
KUI_RETAIL_SONIC_STACK_TEST ?= 0
# Hardware-confirmed native placement is the normal build. Historical owner
# trace/stack diagnostics use their original layout unless explicitly overridden.
KUI_RETAIL_LOW_RESIDENT ?= $(if $(filter-out 0,$(KUI_RETAIL_STARTUP_TRACE) $(KUI_RETAIL_SONIC_STACK_TEST)),0,1)
# Retain the console-accepted native SCI handoff and mounted-disc behavior
# from 72e3bf049b26. Diagnostic return tracing stays disabled for releases.
KUI_GENERAL_SCI_RESUME_FIX ?= 1
# The ordinary audio-off loader must match the tested CD-music control.
KUI_CE_SCI_RESUME_FIX ?= 1
KUI_RETAIL_RETURN_TRACE ?= 0
KUI_RETAIL_NATIVE_DISC_CHECK ?= 1
KUI_RETAIL_NATIVE_DRIVE_STATE ?= 1
ifneq ($(KUI_RETAIL_NATIVE_DRIVE_STATE),0)
ifneq ($(KUI_RETAIL_NATIVE_DRIVE_STATE),1)
$(error KUI_RETAIL_NATIVE_DRIVE_STATE must be 0 or 1)
endif
endif
ifneq ($(KUI_RETAIL_NATIVE_DISC_CHECK),0)
ifneq ($(KUI_RETAIL_NATIVE_DISC_CHECK),1)
$(error KUI_RETAIL_NATIVE_DISC_CHECK must be 0 or 1)
endif
endif
ifneq ($(filter $(KUI_RETAIL_RETURN_TRACE),0 1 2 3),$(KUI_RETAIL_RETURN_TRACE))
$(error KUI_RETAIL_RETURN_TRACE must be 0, 1, 2 or 3)
endif
ifneq ($(KUI_GENERAL_SCI_RESUME_FIX),0)
ifneq ($(KUI_GENERAL_SCI_RESUME_FIX),1)
$(error KUI_GENERAL_SCI_RESUME_FIX must be 0 or 1)
endif
endif
ifneq ($(KUI_CE_SCI_RESUME_FIX),0)
ifneq ($(KUI_CE_SCI_RESUME_FIX),1)
$(error KUI_CE_SCI_RESUME_FIX must be 0 or 1)
endif
endif
RETAIL_FLAGS := -std=c11 -Os -g -Wall -Wextra -Werror $(RETAIL_CPU) -DKUI_RETAIL_FAST_IO=1 -ffreestanding \
    -DKUI_RETAIL_STARTUP_TRACE=$(KUI_RETAIL_STARTUP_TRACE) \
    -DKUI_RETAIL_SONIC_STACK_TEST=$(KUI_RETAIL_SONIC_STACK_TEST) \
    -DKUI_RETAIL_LOW_RESIDENT=$(KUI_RETAIL_LOW_RESIDENT) \
    -fno-builtin -fno-stack-protector -fno-pic -ffunction-sections -fdata-sections -fno-jump-tables \
    -fstack-usage -DKUI_ON_CONSOLE=1 -Iinclude -Isrc/loader -DKUI_BUILD_ID='"$(BUILD_ID)"'
RETAIL_LINK := $(RETAIL_CPU) -nostdlib -Wl,--gc-sections -Wl,--build-id=none
RETAIL_RESIDENT_LD := src/loader/retail_resident$(if $(filter 1,$(KUI_RETAIL_LOW_RESIDENT)),_low).ld
RETAIL_ASYNC_LD := src/loader/retail_resident_async$(if $(filter 1,$(KUI_RETAIL_LOW_RESIDENT)),_low).ld
# Every CE object retains the tested placement and omits native diagnostics.
RETAIL_LEGACY_FLAGS := $(filter-out -DKUI_RETAIL_LOW_RESIDENT=% -DKUI_RETAIL_STARTUP_TRACE=% -DKUI_RETAIL_SONIC_STACK_TEST=%,$(RETAIL_FLAGS)) -DKUI_RETAIL_LOW_RESIDENT=0 -DKUI_RETAIL_STARTUP_TRACE=0 -DKUI_RETAIL_SONIC_STACK_TEST=0
.PHONY: force-retail-layout
force-retail-layout:
build/retail/layout-config: force-retail-layout
	@mkdir -p $(@D)
	@printf '%s\n' 'LOW=$(KUI_RETAIL_LOW_RESIDENT) TRACE=$(KUI_RETAIL_STARTUP_TRACE) SONIC=$(KUI_RETAIL_SONIC_STACK_TEST) BUILD=$(BUILD_ID)$(if $(filter 1,$(KUI_GENERAL_SCI_RESUME_FIX)), SCI_RESUME_FIX=1)$(if $(filter 1 2 3,$(KUI_RETAIL_RETURN_TRACE)), RETURN_TRACE=$(KUI_RETAIL_RETURN_TRACE))$(if $(filter 3,$(KUI_RETAIL_RETURN_TRACE)), SKIES_READ_DIAGNOSTIC=1)$(if $(filter 1,$(KUI_RETAIL_NATIVE_DISC_CHECK)), NATIVE_DISC_CHECK=1)$(if $(filter 1,$(KUI_RETAIL_NATIVE_DRIVE_STATE)), NATIVE_DRIVE_STATE=1)' > $@.new
	@if ! cmp -s $@.new $@; then mv $@.new $@; else rm $@.new; fi
build/retail-ce/layout-config: force-retail-layout
	@mkdir -p $(@D)
	@printf '%s\n' 'LOW=0 TRACE=0 SONIC=0 BUILD=$(BUILD_ID)$(if $(filter 1,$(KUI_CE_SCI_RESUME_FIX)), CE_SCI_RESUME_FIX=1)' > $@.new
	@if ! cmp -s $@.new $@; then mv $@.new $@; else rm $@.new; fi
# SCI's DMA reader shares the original protected low-memory reservation.
# Cross-unit optimization and SH call relaxation recover code space without
# changing the stack boundary. Keep audited entry points and compiler-emitted
# memory helpers visible; audit the actual LTO-generated stack frames below.
RETAIL_SCI_FLAGS := -flto -mrelax
# The mounted-disc check and logical drive state serve the native residents.
# Terminal return trace remains confined to the standard native SCI resident.
RETAIL_NATIVE_DEFS := -DKUI_RETAIL_NATIVE_DISC_CHECK=$(KUI_RETAIL_NATIVE_DISC_CHECK) -DKUI_RETAIL_NATIVE_DRIVE_STATE=$(KUI_RETAIL_NATIVE_DRIVE_STATE)
RETAIL_NATIVE_SCI_DEFS := $(RETAIL_NATIVE_DEFS) -DKUI_RETAIL_RETURN_TRACE=$(KUI_RETAIL_RETURN_TRACE)
RETAIL_SKIES_DEFS := $(if $(filter 3,$(KUI_RETAIL_RETURN_TRACE)),-DKUI_RETAIL_SKIES_READ_DIAGNOSTIC=1)
RETAIL_SCI_LINK := $(RETAIL_SCI_FLAGS) -Os -fstack-usage -save-temps=obj -Wl,--relax \
    -Wl,-u,_memcpy -Wl,-u,_memset -Wl,-u,_kui_retail_resident_init \
    -Wl,-u,_kui_retail_resident_dispatch -Wl,-u,_kui_retail_gd_dispatch \
    -Wl,-u,_kui_retail_image_read -Wl,-u,_kui_loader_sd_stream_next \
    -Wl,-u,_kui_sci_sd_acquire -Wl,-u,_kui_sci_sd_release
RETAIL_COMMON := build/retail/src/loader/sd_reader.o build/retail/src/loader/retail_sd.o \
    build/retail/src/loader/retail_storage.o build/retail/src/loader/sci_sd_bus.o \
    build/retail/src/core/ata.o build/retail/src/dreamcast/ata_bus.o \
    build/retail/src/loader/minic.o build/retail/src/core/retail_image.o \
    build/retail/src/loader/retail_display.o
# Each resident carries one physical transport. All retain the same low-RAM
# linker bounds; the temporary high stage embeds/selects the matching image.
RETAIL_RESIDENT_COMMON_SRC := src/loader/retail_resident.c src/core/retail_gd.c \
    src/core/retail_pace.c src/loader/minic.c src/core/retail_image.c \
    src/loader/retail_display.c
RETAIL_SCIF_SRC := $(RETAIL_RESIDENT_COMMON_SRC) src/loader/sd_reader.c src/loader/retail_sd.c
RETAIL_SCI_SRC := $(RETAIL_SCIF_SRC) src/loader/sci_sd_bus.c
RETAIL_IDE_SRC := $(RETAIL_RESIDENT_COMMON_SRC) src/core/ata.c src/dreamcast/ata_bus.c
# The background SCI reader (manifest readers 1 and 2): its own CMD18 stream
# engine and interrupt vectors replace the ordinary block reader. Its map
# holds 64 slots (tracks plus extents) and it runs on a 352-byte stack whose
# worst case is taken from the compiler's call graph
# (tools/check_retail_stack.py), not a frame sum.
RETAIL_SCIA_DEFS := -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 \
    -DKUI_SCI_SD_NO_BLOCK=1 -DKUI_RETAIL_MANIFEST_SLOTS=64
# Native and CE resume repairs retain their independently tested corrections.
RETAIL_NATIVE_SCIA_DEFS := $(RETAIL_SCIA_DEFS) $(RETAIL_NATIVE_DEFS) $(if $(filter 1,$(KUI_GENERAL_SCI_RESUME_FIX)),-DKUI_GENERAL_SCI_RESUME_FIX=1)
RETAIL_CE_SCIA_DEFS := $(RETAIL_SCIA_DEFS) -DKUI_RETAIL_CE=1 $(if $(filter 1,$(KUI_CE_SCI_RESUME_FIX)),-DKUI_CE_SCI_RESUME_FIX=1)
RETAIL_SCIA_SRC := src/loader/retail_resident.c src/core/retail_gd.c src/loader/minic.c \
    src/core/retail_image.c src/loader/retail_display.c src/loader/sci_sd_bus.c \
    src/core/retail_cursor.c src/loader/sci_stream.c src/loader/retail_async.c
RETAIL_SCIA_LINK := $(RETAIL_SCI_FLAGS) -Os -fstack-usage -fcallgraph-info=su -save-temps=obj -Wl,--relax \
    -Wl,-u,_memcpy -Wl,-u,_memset -Wl,-u,_kui_retail_resident_init \
    -Wl,-u,_kui_retail_resident_dispatch -Wl,-u,_kui_retail_gd_dispatch -Wl,-u,_kui_retail_async_irq
RETAIL_SCIF := $(patsubst %.c,build/retail/scif/%.o,$(RETAIL_SCIF_SRC)) build/retail/scif/src/loader/retail_resident_asm.o
RETAIL_SCI := $(patsubst %.c,build/retail/sci/%.o,$(RETAIL_SCI_SRC)) build/retail/sci/src/loader/retail_resident_asm.o
RETAIL_IDE := $(patsubst %.c,build/retail/ide/%.o,$(RETAIL_IDE_SRC)) build/retail/ide/src/loader/retail_resident_asm.o
RETAIL_SCIA := $(patsubst %.c,build/retail/scia/%.o,$(RETAIL_SCIA_SRC)) build/retail/scia/src/loader/retail_resident_asm.o
RETAIL_RESIDENT_BINS := build/retail/resident-scif.bin build/retail/resident-sci.bin build/retail/resident-ide.bin \
    build/retail/resident-scia.bin
RETAIL_STAGE := build/retail/src/loader/retail_stage_asm.o \
    build/retail/src/loader/retail_stage.o build/retail/src/core/game_ram_patches.o $(RETAIL_COMMON)
RETAIL_BENCH_STAGE := build/retail/src/loader/retail_stage_asm.o \
    build/retail-bench/retail_stage.o build/retail/src/loader/retail_sd_bench.o $(RETAIL_COMMON)
# The Windows CE placement probe: the same stage built with KUI_RETAIL_CE and
# its CE load planner, linked at KUI_RETAIL_CE_STAGE_ADDRESS.
RETAIL_CE_STAGE := build/retail-ce/retail_stage_asm.o build/retail-ce/retail_stage.o \
    build/retail-ce/ce_load_plan.o build/retail-ce/retail_display.o \
    $(patsubst build/retail/%,build/retail-ce/common/%,$(filter-out build/retail/src/loader/retail_display.o,$(RETAIL_COMMON)))

build/retail/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) -MMD -MP -c $< -o $@
build/retail/src/loader/retail_stage.o: src/loader/retail_stage.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_SKIES_DEFS) -DKUI_GAME_RAM_PATCHES_STAGE=$(if $(filter-out 0,$(KUI_RETAIL_STARTUP_TRACE) $(KUI_RETAIL_SONIC_STACK_TEST) $(KUI_RETAIL_RETURN_TRACE)),0,1) -MMD -MP -c $< -o $@
build/retail/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) -MMD -MP -c $< -o $@
build/retail/src/loader/retail_display.o: force-build-id
build/retail/scif/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_NATIVE_DEFS) -DKUI_RETAIL_TRANSPORT=0 -MMD -MP -c $< -o $@
build/retail/scif/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_NATIVE_DEFS) -DKUI_RETAIL_TRANSPORT=0 -MMD -MP -c $< -o $@
build/retail/scif/src/loader/retail_display.o: force-build-id
build/retail/resident-scif.elf: $(RETAIL_SCIF) $(RETAIL_RESIDENT_LD)
	sh-elf-gcc $(RETAIL_LINK) -T$(RETAIL_RESIDENT_LD) -Wl,-Map,build/retail/resident-scif.map -o $@ $(RETAIL_SCIF) -lgcc
build/retail/resident-scif.bin: build/retail/resident-scif.elf
	sh-elf-objcopy -O binary $< $@
build/retail/sci/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_NATIVE_SCI_DEFS) -DKUI_RETAIL_TRANSPORT=1 -MMD -MP -c $< -o $@
build/retail/sci/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_NATIVE_SCI_DEFS) -DKUI_RETAIL_TRANSPORT=1 -MMD -MP -c $< -o $@
build/retail/sci/src/loader/retail_display.o: force-build-id
build/retail/resident-sci.elf: $(RETAIL_SCI) $(RETAIL_RESIDENT_LD)
	@mkdir -p build/retail/sci/lto
	rm -f build/retail/resident-sci.elf.ltrans*.su build/retail/sci/lto/*.su
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCI_LINK) -T$(RETAIL_RESIDENT_LD) -Wl,-Map,build/retail/resident-sci.map -o $@ $(RETAIL_SCI) -lgcc
	cp build/retail/resident-sci.elf.ltrans*.su build/retail/sci/lto/
build/retail/resident-sci.bin: build/retail/resident-sci.elf
	sh-elf-objcopy -O binary $< $@
build/retail/ide/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_NATIVE_DEFS) -DKUI_RETAIL_TRANSPORT=2 -MMD -MP -c $< -o $@
build/retail/ide/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_NATIVE_DEFS) -DKUI_RETAIL_TRANSPORT=2 -MMD -MP -c $< -o $@
build/retail/ide/src/loader/retail_display.o: force-build-id
build/retail/resident-ide.elf: $(RETAIL_IDE) $(RETAIL_RESIDENT_LD)
	sh-elf-gcc $(RETAIL_LINK) -T$(RETAIL_RESIDENT_LD) -Wl,-Map,build/retail/resident-ide.map -o $@ $(RETAIL_IDE) -lgcc
build/retail/resident-ide.bin: build/retail/resident-ide.elf
	sh-elf-objcopy -O binary $< $@
build/retail/scia/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_NATIVE_SCIA_DEFS) -MMD -MP -c $< -o $@
build/retail/scia/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_NATIVE_SCIA_DEFS) -MMD -MP -c $< -o $@
build/retail/scia/src/loader/retail_display.o: force-build-id
build/retail/resident-scia.elf: $(RETAIL_SCIA) $(RETAIL_ASYNC_LD)
	@mkdir -p build/retail/scia/lto
	rm -f build/retail/resident-scia.elf.ltrans* build/retail/scia/lto/*
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCIA_LINK) -T$(RETAIL_ASYNC_LD) -Wl,-Map,build/retail/resident-scia.map -o $@ $(RETAIL_SCIA) -lgcc
	cp build/retail/resident-scia.elf.ltrans*.su build/retail/resident-scia.elf.ltrans*.ci build/retail/scia/lto/
build/retail/resident-scia.bin: build/retail/resident-scia.elf
	sh-elf-objcopy -O binary $< $@
build/retail/src/loader/retail_stage_asm.o: $(RETAIL_RESIDENT_BINS)
build/retail/stage.elf: $(RETAIL_STAGE) src/loader/retail_stage.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_stage.ld -Wl,-Map,build/retail/stage.map -o $@ $(RETAIL_STAGE) -lgcc
build/retail/stage.bin: build/retail/stage.elf
	sh-elf-objcopy -O binary $< $@
build/retail/src/loader/retail_entry_asm.o: build/retail/stage.bin
build/retail/entry.elf: build/retail/src/loader/retail_entry_asm.o src/loader/retail_entry.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,build/retail/entry.map -o $@ $<
	python3 tools/check_retail_instructions.py
	python3 tools/check_retail_loader_layout.py
	python3 tools/record_build.py $@

# The separate SD benchmark runs in the high stage. Share the exact ordinary
# resident and its assembly wrapper; the normal retail entry remains a game
# launcher. Top-level variant objects cannot be overwritten by the report copy.
build/retail-bench/retail_stage.o: src/loader/retail_stage.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_FLAGS) -DKUI_RETAIL_SD_BENCH=1 -MMD -MP -c $< -o $@
build/retail-bench/stage.elf: $(RETAIL_BENCH_STAGE) src/loader/retail_stage.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_stage.ld -Wl,-Map,build/retail-bench/stage.map -o $@ $(RETAIL_BENCH_STAGE) -lgcc
build/retail-bench/stage.bin: build/retail-bench/stage.elf
	sh-elf-objcopy -O binary $< $@
build/retail-bench/retail_entry_asm.o: src/loader/retail_entry.S build/retail-bench/stage.bin
	sh-elf-gcc $(RETAIL_FLAGS) -DKUI_RETAIL_STAGE_BIN='"build/retail-bench/stage.bin"' -MMD -MP -c $< -o $@
build/retail-bench/entry.elf: build/retail-bench/retail_entry_asm.o src/loader/retail_entry.ld build/retail/entry.elf
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,build/retail-bench/entry.map -o $@ $<
	cp build/retail/resident-*.elf build/retail/resident-*.bin build/retail/resident-*.map build/retail-bench/
	cp -r build/retail/src build/retail/scif build/retail/sci build/retail/ide build/retail/scia build/retail-bench/
	python3 tools/check_retail_instructions.py build/retail-bench
	python3 tools/check_retail_loader_layout.py build/retail-bench
	python3 tools/record_build.py $@

# The Windows CE boot test package (ce-probe.kui). It shares the ordinary
# SCIF and IDE residents; its stage C code, link address and SCI residents
# (standard and background) differ. Those (KUI_RETAIL_CE) touch CE's stack
# only with exceptions enabled and trace CE's calls; the standard one reads a
# fixed step without pacing.
RETAIL_CE_SCIF := $(patsubst %.c,build/retail-ce/scif/%.o,$(RETAIL_SCIF_SRC)) build/retail-ce/scif/src/loader/retail_resident_asm.o
RETAIL_CE_IDE := $(patsubst %.c,build/retail-ce/ide/%.o,$(RETAIL_IDE_SRC)) build/retail-ce/ide/src/loader/retail_resident_asm.o
build/retail-ce/scif/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_TRANSPORT=0 -MMD -MP -c $< -o $@
build/retail-ce/scif/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_TRANSPORT=0 -MMD -MP -c $< -o $@
build/retail-ce/scif/src/loader/retail_display.o: force-build-id
build/retail-ce/resident-scif.elf: $(RETAIL_CE_SCIF) src/loader/retail_resident.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_resident.ld -Wl,-Map,build/retail-ce/resident-scif.map -o $@ $(RETAIL_CE_SCIF) -lgcc
build/retail-ce/resident-scif.bin: build/retail-ce/resident-scif.elf
	sh-elf-objcopy -O binary $< $@
build/retail-ce/ide/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_TRANSPORT=2 -MMD -MP -c $< -o $@
build/retail-ce/ide/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_TRANSPORT=2 -MMD -MP -c $< -o $@
build/retail-ce/ide/src/loader/retail_display.o: force-build-id
build/retail-ce/resident-ide.elf: $(RETAIL_CE_IDE) src/loader/retail_resident.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_resident.ld -Wl,-Map,build/retail-ce/resident-ide.map -o $@ $(RETAIL_CE_IDE) -lgcc
build/retail-ce/resident-ide.bin: build/retail-ce/resident-ide.elf
	sh-elf-objcopy -O binary $< $@
RETAIL_CE_SCI := $(patsubst %.c,build/retail-ce/sci/%.o,$(RETAIL_SCI_SRC)) build/retail-ce/sci/src/loader/retail_resident_asm.o
build/retail-ce/sci/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) $(RETAIL_SCI_FLAGS) -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_CE=1 -MMD -MP -c $< -o $@
build/retail-ce/sci/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) $(RETAIL_SCI_FLAGS) -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_CE=1 -MMD -MP -c $< -o $@
build/retail-ce/sci/src/loader/retail_display.o: force-build-id
build/retail-ce/resident-sci.elf: $(RETAIL_CE_SCI) src/loader/retail_resident_ce.ld
	@mkdir -p build/retail-ce/sci/lto
	rm -f build/retail-ce/resident-sci.elf.ltrans*.su build/retail-ce/sci/lto/*.su
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCI_LINK) -Tsrc/loader/retail_resident_ce.ld -Wl,-Map,build/retail-ce/resident-sci.map -o $@ $(RETAIL_CE_SCI) -lgcc
	cp build/retail-ce/resident-sci.elf.ltrans*.su build/retail-ce/sci/lto/
build/retail-ce/resident-sci.bin: build/retail-ce/resident-sci.elf
	sh-elf-objcopy -O binary $< $@
# Its background reader (manifest readers 1 and 2): the native one's engine
# and stream, reached through CE's own interrupt handler table instead of
# vectors of its own, with room below bootstrap 2 for a 2 KiB stack.
RETAIL_CE_SCIA := $(patsubst %.c,build/retail-ce/scia/%.o,$(RETAIL_SCIA_SRC)) build/retail-ce/scia/src/loader/retail_resident_asm.o
build/retail-ce/scia/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_CE_SCIA_DEFS) -MMD -MP -c $< -o $@
build/retail-ce/scia/%_asm.o: %.S
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) $(RETAIL_SCI_FLAGS) $(RETAIL_CE_SCIA_DEFS) -MMD -MP -c $< -o $@
build/retail-ce/scia/src/loader/retail_display.o: force-build-id
build/retail-ce/resident-scia.elf: $(RETAIL_CE_SCIA) src/loader/retail_resident_ce_async.ld
	@mkdir -p build/retail-ce/scia/lto
	rm -f build/retail-ce/resident-scia.elf.ltrans* build/retail-ce/scia/lto/*
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCIA_LINK) -Wl,-u,_kui_retail_ce_irq -Tsrc/loader/retail_resident_ce_async.ld -Wl,-Map,build/retail-ce/resident-scia.map -o $@ $(RETAIL_CE_SCIA) -lgcc
	cp build/retail-ce/resident-scia.elf.ltrans*.su build/retail-ce/resident-scia.elf.ltrans*.ci build/retail-ce/scia/lto/
build/retail-ce/resident-scia.bin: build/retail-ce/resident-scia.elf
	sh-elf-objcopy -O binary $< $@
build/retail-ce/common/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -MMD -MP -c $< -o $@
build/retail-ce/retail_stage_asm.o: src/loader/retail_stage.S build/retail-ce/resident-scif.bin build/retail-ce/resident-ide.bin build/retail-ce/resident-sci.bin build/retail-ce/resident-scia.bin
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_CE=1 -MMD -MP -c $< -o $@
build/retail-ce/retail_stage.o: src/loader/retail_stage.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_CE=1 -MMD -MP -c $< -o $@
build/retail-ce/ce_load_plan.o: src/core/ce_load_plan.c
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -MMD -MP -c $< -o $@
build/retail-ce/retail_display.o: src/loader/retail_display.c force-build-id
	@mkdir -p $(@D)
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_CE=1 -MMD -MP -c $< -o $@
build/retail-ce/stage.elf: $(RETAIL_CE_STAGE) src/loader/retail_stage_ce.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_stage_ce.ld -Wl,-Map,build/retail-ce/stage.map -o $@ $(RETAIL_CE_STAGE) -lgcc
build/retail-ce/stage.bin: build/retail-ce/stage.elf
	sh-elf-objcopy -O binary $< $@
build/retail-ce/retail_entry_asm.o: src/loader/retail_entry.S build/retail-ce/stage.bin
	sh-elf-gcc $(RETAIL_LEGACY_FLAGS) -DKUI_RETAIL_CE=1 -DKUI_RETAIL_STAGE_BIN='"build/retail-ce/stage.bin"' -MMD -MP -c $< -o $@
build/retail-ce/entry.elf: build/retail-ce/retail_entry_asm.o src/loader/retail_entry.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,build/retail-ce/entry.map -o $@ $<
	python3 tools/check_retail_instructions.py build/retail-ce
	python3 tools/check_retail_loader_layout.py --ce build/retail-ce
	python3 tools/record_build.py $@

-include $(RETAIL_SCIF:.o=.d) $(RETAIL_SCI:.o=.d) $(RETAIL_IDE:.o=.d) $(RETAIL_SCIA:.o=.d) $(RETAIL_STAGE:.o=.d) build/retail/src/loader/retail_entry_asm.d
-include $(RETAIL_BENCH_STAGE:.o=.d) build/retail-bench/retail_entry_asm.d
$(RETAIL_SCIF) $(RETAIL_SCI) $(RETAIL_IDE) $(RETAIL_SCIA) $(RETAIL_STAGE) build/retail/src/loader/retail_entry_asm.o $(RETAIL_BENCH_STAGE) build/retail-bench/retail_entry_asm.o: build/retail/layout-config
$(filter-out $(RETAIL_COMMON),$(RETAIL_CE_STAGE)) $(RETAIL_CE_SCI) $(RETAIL_CE_SCIA) $(RETAIL_CE_SCIF) $(RETAIL_CE_IDE) build/retail-ce/retail_entry_asm.o: build/retail-ce/layout-config
-include $(RETAIL_CE_STAGE:.o=.d) $(RETAIL_CE_SCI:.o=.d) $(RETAIL_CE_SCIA:.o=.d) $(RETAIL_CE_SCIF:.o=.d) $(RETAIL_CE_IDE:.o=.d) build/retail-ce/retail_entry_asm.d

# Independent native single-track Standard-LZ4 ZSO reader. Its smaller map
# and specialized cooked-sector path fit the existing low reservation; no
# ordinary/CE/music object or owner RAM is reused as decoder workspace.
ZSO_DIR := build/retail-zso
ZSO_FLAGS := $(filter-out -DKUI_RETAIL_LOW_RESIDENT=% -DKUI_RETAIL_STARTUP_TRACE=% -DKUI_RETAIL_SONIC_STACK_TEST=%,$(RETAIL_FLAGS)) \
    -DKUI_RETAIL_LOW_RESIDENT=1 -DKUI_RETAIL_STARTUP_TRACE=0 -DKUI_RETAIL_SONIC_STACK_TEST=0 \
    -DKUI_ZSO_CODECS=1 -DKUI_RETAIL_ZSO=1 -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_MANIFEST_SLOTS=32 -DKUI_GAME_RAM_PATCHES_STAGE=0
ZSO_RESIDENT_SRC := $(filter-out src/core/retail_image.c,$(RETAIL_SCI_SRC)) src/core/retail_zso.c src/core/zso.c
ZSO_RESIDENT := $(patsubst %.c,$(ZSO_DIR)/resident/%.o,$(ZSO_RESIDENT_SRC)) $(ZSO_DIR)/resident/retail_resident_asm.o
ZSO_STAGE_SRC := src/loader/retail_stage.c src/loader/sd_reader.c src/loader/retail_sd.c \
    src/loader/sci_sd_bus.c src/loader/minic.c src/loader/retail_display.c \
    src/core/retail_image.c src/core/retail_zso.c src/core/zso.c
ZSO_STAGE := $(patsubst %.c,$(ZSO_DIR)/stage/%.o,$(ZSO_STAGE_SRC)) $(ZSO_DIR)/stage/retail_stage_asm.o
.PHONY: native-zso
native-zso: $(ZSO_DIR)/entry.elf
$(ZSO_DIR)/layout-config: force-retail-layout
	@mkdir -p $(@D)
	@printf '%s\n' 'ZSO=1 LOW=1 TRANSPORT=1 READER=0 SLOTS=32 PATCHES=0 BUILD=$(BUILD_ID)' > $@.new
	@if ! cmp -s $@.new $@; then mv $@.new $@; else rm $@.new; fi
$(ZSO_DIR)/resident/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ZSO_FLAGS) $(RETAIL_SCI_FLAGS) -fcallgraph-info=su -MMD -MP -c $< -o $@
$(ZSO_DIR)/resident/retail_resident_asm.o: src/loader/retail_resident.S
	@mkdir -p $(@D)
	sh-elf-gcc $(ZSO_FLAGS) $(RETAIL_SCI_FLAGS) -MMD -MP -c $< -o $@
$(ZSO_DIR)/resident/src/loader/retail_display.o: force-build-id
$(ZSO_DIR)/resident-sci.elf: $(ZSO_RESIDENT) src/loader/retail_resident_low.ld
	@mkdir -p $(ZSO_DIR)/sci/lto
	rm -f $(ZSO_DIR)/resident-sci.elf.ltrans* $(ZSO_DIR)/sci/lto/*
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCI_FLAGS) -Os -fstack-usage -fcallgraph-info=su -save-temps=obj -Wl,--relax -Wl,-u,_memcpy -Wl,-u,_memset -Wl,-u,_kui_retail_resident_init -Wl,-u,_kui_retail_resident_dispatch -Wl,-u,_kui_retail_gd_dispatch -Wl,-u,_kui_retail_zso_image_read -Wl,-u,_kui_zso_read_block -Wl,-u,_kui_loader_sd_stream_next -Wl,-u,_kui_sci_sd_acquire -Wl,-u,_kui_sci_sd_release -Tsrc/loader/retail_resident_low.ld -Wl,-Map,$(ZSO_DIR)/resident-sci.map -o $@ $(ZSO_RESIDENT) -lgcc
	cp $(ZSO_DIR)/resident-sci.elf.ltrans*.su $(ZSO_DIR)/resident-sci.elf.ltrans*.ci $(ZSO_DIR)/sci/lto/
$(ZSO_DIR)/resident-sci.bin: $(ZSO_DIR)/resident-sci.elf
	sh-elf-objcopy -O binary $< $@
$(ZSO_DIR)/stage/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(ZSO_FLAGS) -MMD -MP -c $< -o $@
$(ZSO_DIR)/stage/src/loader/retail_display.o: force-build-id
$(ZSO_DIR)/stage/retail_stage_asm.o: src/loader/retail_stage.S $(ZSO_DIR)/resident-sci.bin
	@mkdir -p $(@D)
	sh-elf-gcc $(ZSO_FLAGS) -MMD -MP -c $< -o $@
$(ZSO_DIR)/stage.elf: $(ZSO_STAGE) src/loader/retail_stage.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_stage.ld -Wl,-Map,$(ZSO_DIR)/stage.map -o $@ $(ZSO_STAGE) -lgcc
$(ZSO_DIR)/stage.bin: $(ZSO_DIR)/stage.elf
	sh-elf-objcopy -O binary $< $@
$(ZSO_DIR)/retail_entry_asm.o: src/loader/retail_entry.S $(ZSO_DIR)/stage.bin
	sh-elf-gcc $(ZSO_FLAGS) -DKUI_RETAIL_STAGE_BIN='"$(ZSO_DIR)/stage.bin"' -MMD -MP -c $< -o $@
$(ZSO_DIR)/entry.elf: $(ZSO_DIR)/retail_entry_asm.o src/loader/retail_entry.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,$(ZSO_DIR)/entry.map -o $@ $<
	python3 tools/check_zso_loader.py $(ZSO_DIR)
	python3 tools/record_build.py $@
$(ZSO_RESIDENT) $(ZSO_STAGE) $(ZSO_DIR)/retail_entry_asm.o: $(ZSO_DIR)/layout-config
-include $(ZSO_RESIDENT:.o=.d) $(ZSO_STAGE:.o=.d) $(ZSO_DIR)/retail_entry_asm.d

# Independently decoded historical LZO1X; the existing LZ4 target stays separate.
LZO_DIR := build/retail-lzo
LZO_FLAGS := $(filter-out -DKUI_RETAIL_LOW_RESIDENT=% -DKUI_RETAIL_STARTUP_TRACE=% -DKUI_RETAIL_SONIC_STACK_TEST=%,$(RETAIL_FLAGS)) \
    -DKUI_RETAIL_LOW_RESIDENT=1 -DKUI_RETAIL_STARTUP_TRACE=0 -DKUI_RETAIL_SONIC_STACK_TEST=0 \
    -DKUI_ZSO_CODECS=2 -DKUI_RETAIL_ZSO=1 -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_MANIFEST_SLOTS=32 -DKUI_GAME_RAM_PATCHES_STAGE=0
LZO_RESIDENT_SRC := $(filter-out src/core/retail_image.c,$(RETAIL_SCI_SRC)) src/core/retail_zso.c src/core/zso.c src/core/lzo1x.c
LZO_RESIDENT := $(patsubst %.c,$(LZO_DIR)/resident/%.o,$(LZO_RESIDENT_SRC)) $(LZO_DIR)/resident/retail_resident_asm.o
LZO_STAGE_SRC := src/loader/retail_stage.c src/loader/sd_reader.c src/loader/retail_sd.c \
    src/loader/sci_sd_bus.c src/loader/minic.c src/loader/retail_display.c \
    src/core/retail_image.c src/core/retail_zso.c src/core/zso.c src/core/lzo1x.c
LZO_STAGE := $(patsubst %.c,$(LZO_DIR)/stage/%.o,$(LZO_STAGE_SRC)) $(LZO_DIR)/stage/retail_stage_asm.o
.PHONY: native-lzo
native-lzo: $(LZO_DIR)/entry.elf
$(LZO_DIR)/layout-config: force-retail-layout
	@mkdir -p $(@D)
	@printf '%s\n' 'ZSO=1 CODEC=1 LOW=1 TRANSPORT=1 READER=0 SLOTS=32 PATCHES=0 BUILD=$(BUILD_ID)' > $@.new
	@if ! cmp -s $@.new $@; then mv $@.new $@; else rm $@.new; fi
$(LZO_DIR)/resident/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(LZO_FLAGS) $(RETAIL_SCI_FLAGS) -fcallgraph-info=su -MMD -MP -c $< -o $@
$(LZO_DIR)/resident/retail_resident_asm.o: src/loader/retail_resident.S
	@mkdir -p $(@D)
	sh-elf-gcc $(LZO_FLAGS) $(RETAIL_SCI_FLAGS) -MMD -MP -c $< -o $@
$(LZO_DIR)/resident/src/loader/retail_display.o: force-build-id
$(LZO_DIR)/resident-sci.elf: $(LZO_RESIDENT) src/loader/retail_resident_low.ld
	@mkdir -p $(LZO_DIR)/sci/lto
	rm -f $(LZO_DIR)/resident-sci.elf.ltrans* $(LZO_DIR)/sci/lto/*
	sh-elf-gcc $(RETAIL_LINK) $(RETAIL_SCI_FLAGS) -Os -fstack-usage -fcallgraph-info=su -save-temps=obj -Wl,--relax -Wl,-u,_memcpy -Wl,-u,_memset -Wl,-u,_kui_retail_resident_init -Wl,-u,_kui_retail_resident_dispatch -Wl,-u,_kui_retail_gd_dispatch -Wl,-u,_kui_retail_zso_image_read -Wl,-u,_kui_zso_read_block -Wl,-u,_kui_lzo1x_decode -Wl,-u,_kui_loader_sd_stream_next -Wl,-u,_kui_sci_sd_acquire -Wl,-u,_kui_sci_sd_release -Tsrc/loader/retail_resident_low.ld -Wl,-Map,$(LZO_DIR)/resident-sci.map -o $@ $(LZO_RESIDENT) -lgcc
	cp $(LZO_DIR)/resident-sci.elf.ltrans*.su $(LZO_DIR)/resident-sci.elf.ltrans*.ci $(LZO_DIR)/sci/lto/
$(LZO_DIR)/resident-sci.bin: $(LZO_DIR)/resident-sci.elf
	sh-elf-objcopy -O binary $< $@
$(LZO_DIR)/stage/%.o: %.c
	@mkdir -p $(@D)
	sh-elf-gcc $(LZO_FLAGS) -MMD -MP -c $< -o $@
$(LZO_DIR)/stage/src/loader/retail_display.o: force-build-id
$(LZO_DIR)/stage/retail_stage_asm.o: src/loader/retail_stage.S $(LZO_DIR)/resident-sci.bin
	@mkdir -p $(@D)
	sh-elf-gcc $(LZO_FLAGS) -DKUI_RETAIL_ZSO_RESIDENT_BIN='"$(LZO_DIR)/resident-sci.bin"' -MMD -MP -c $< -o $@
$(LZO_DIR)/stage.elf: $(LZO_STAGE) src/loader/retail_stage.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_stage.ld -Wl,-Map,$(LZO_DIR)/stage.map -o $@ $(LZO_STAGE) -lgcc
$(LZO_DIR)/stage.bin: $(LZO_DIR)/stage.elf
	sh-elf-objcopy -O binary $< $@
$(LZO_DIR)/retail_entry_asm.o: src/loader/retail_entry.S $(LZO_DIR)/stage.bin
	sh-elf-gcc $(LZO_FLAGS) -DKUI_RETAIL_STAGE_BIN='"$(LZO_DIR)/stage.bin"' -MMD -MP -c $< -o $@
$(LZO_DIR)/entry.elf: $(LZO_DIR)/retail_entry_asm.o src/loader/retail_entry.ld
	sh-elf-gcc $(RETAIL_LINK) -Tsrc/loader/retail_entry.ld -Wl,-Map,$(LZO_DIR)/entry.map -o $@ $<
	python3 tools/check_zso_loader.py --codec lzo $(LZO_DIR)
	python3 tools/record_build.py $@
$(LZO_RESIDENT) $(LZO_STAGE) $(LZO_DIR)/retail_entry_asm.o: $(LZO_DIR)/layout-config
-include $(LZO_RESIDENT:.o=.d) $(LZO_STAGE:.o=.d) $(LZO_DIR)/retail_entry_asm.d
