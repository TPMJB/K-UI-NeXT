# SPDX-License-Identifier: GPL-3.0-only
ifndef KOS_BASE
$(error Source .deps/kos/environ.sh before building)
endif

TARGET := build/kui-diagnostic.elf
RUNTIME := build/kui-runtime.elf
SOURCES := src/core/command.c src/core/data.c src/core/diskio.c src/core/storage_probe.c \
           src/core/report.c \
           src/dreamcast/main.c src/dreamcast/disc.c src/dreamcast/drive_bus.c src/dreamcast/sd.c
OBJECTS := $(patsubst %.c,build/dc/%.o,$(SOURCES)) build/dc/ff.o build/dc/ffunicode.o
LOADER_OBJECTS := build/dc/src/core/runtime_image.o build/dc/src/core/runtime_file.o build/dc/src/dreamcast/bootstrap.o
RUNTIME_OBJECTS := $(filter-out build/dc/src/dreamcast/main.o,$(OBJECTS)) build/dc/main-runtime.o
RUNTIME_OBJECTS += build/dc/src/core/hash.o build/dc/src/core/capture_plan.o build/dc/src/core/capture.o build/dc/src/dreamcast/capture.o
RUNTIME_OBJECTS += build/dc/src/dreamcast/memory.o
RUNTIME_OBJECTS += build/dc/src/core/timing.o
RUNTIME_OBJECTS += build/dc/src/core/known_dumps.o
RUNTIME_OBJECTS += build/dc/src/core/crc16.o
RUNTIME_OBJECTS += build/dc/src/core/settings.o build/dc/src/core/settings_file.o
RUNTIME_OBJECTS += build/dc/src/core/shell.o build/dc/src/dreamcast/shell_draw.o
RUNTIME_OBJECTS += build/dc/src/core/options.o build/dc/src/core/options_file.o build/dc/src/core/bench.o build/dc/src/dreamcast/bench.o
BUILD_ID ?= $(shell git rev-parse --short=12 HEAD 2>/dev/null || echo local)

.PHONY: all force-build-id
all: $(TARGET) $(RUNTIME)
include $(KOS_BASE)/Makefile.rules

CPPFLAGS += -Iinclude -Isrc/dreamcast -I.deps/fatfs/source -DKUI_BUILD_ID='"$(BUILD_ID)"'
# Experimental, never-run-on-hardware code (the GD-ROM DMA probe and its competing thread) is NOT in
# the default build. Opt in with: make diagnostic KUI_EXPERIMENTAL=1
ifdef KUI_EXPERIMENTAL
CPPFLAGS += -DKUI_EXPERIMENTAL_DMA=1
endif

# Refresh the visible source identifier after every commit, even if main.c did
# not change. Relinking also records the exact source state used by packaging.
build/dc/src/dreamcast/main.o build/dc/main-runtime.o: force-build-id
force-build-id:

build/dc/%.o: %.c
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -Werror -MMD -MP $(CPPFLAGS) -c $< -o $@
build/dc/main-runtime.o: src/dreamcast/main.c
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -Werror -MMD -MP $(CPPFLAGS) -DKUI_SD_RUNTIME=1 -c $< -o $@
build/dc/ff.o: .deps/fatfs/source/ff.c .deps/fatfs/source/ffconf.h
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -MMD -MP $(CPPFLAGS) -c $< -o $@
build/dc/ffunicode.o: .deps/fatfs/source/ffunicode.c .deps/fatfs/source/ffconf.h
	@mkdir -p $(@D)
	kos-cc -std=c11 -Wall -Wextra -MMD -MP $(CPPFLAGS) -c $< -o $@
$(TARGET): $(OBJECTS) $(LOADER_OBJECTS)
	kos-cc -o $@ $(OBJECTS) $(LOADER_OBJECTS) -Wl,-Map,build/kui-diagnostic.map
	python3 tools/record_build.py $@
$(RUNTIME): $(RUNTIME_OBJECTS)
	kos-cc -o $@ $(RUNTIME_OBJECTS) -Wl,-Map,build/kui-runtime.map
	python3 tools/record_build.py $@

-include $(OBJECTS:.o=.d) $(LOADER_OBJECTS:.o=.d) $(RUNTIME_OBJECTS:.o=.d)
