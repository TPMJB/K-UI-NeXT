+# The EXPERIMENTAL GD-ROM DMA probe (Trip 6a) is never in an ordinary build. Two ways to ask for
+# one, and it is empty for every other build:
+#   - push a branch whose name ends in "-experimental" (e.g. milestone/dma-experimental), or
+#   - run the workflow by hand with the box ticked, which needs the workflow file to exist on the
+#     DEFAULT branch: it does not here, so the branch name is the way that works today.
+# Its artifacts are named diagnostic-experimental and sd-update-experimental.
+env:
+  KUI_EXPERIMENTAL: ${{ (inputs.experimental || endsWith(github.ref_name, '-experimental')) && '1' || '' }}
