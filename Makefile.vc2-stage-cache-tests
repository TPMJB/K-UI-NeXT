BUILD ?= build/vc2-stage-cache-host
HOST_CC ?= cc
.DEFAULT_GOAL := vc2-stage-cache-tests
CACHE_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
 -ffunction-sections -fdata-sections -Iinclude -Isrc/loader \
 -DKUI_VMU_READONLY_PROOF=4 -DKUI_VMU_EXPERIMENTAL=0 -DKUI_VC2_VMU_PERSIST=1
CACHE_SOURCES := tests/test_vc2_ce_vmu_stage_cache.c src/loader/vc2_ce_vmu_stage_cache.c \
 src/loader/vmu_persist_stage.c src/core/vmu_durable.c src/core/vmu_persist_session.c \
 src/core/vmu_fs_admission.c src/core/vmu_persist_profile.c src/core/vmu_store.c \
 src/core/vmu_image.c src/core/hash.c src/core/retail_image.c
.PHONY: vc2-stage-cache-tests
vc2-stage-cache-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(CACHE_FLAGS) $(CACHE_SOURCES) -Wl,--gc-sections -o $(BUILD)/test-stage-cache
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-stage-cache
