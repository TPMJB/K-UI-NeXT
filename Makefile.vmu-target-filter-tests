BUILD ?= build/vmu-target-filter-host
HOST_CC ?= cc
.DEFAULT_GOAL := vmu-target-filter-tests
.PHONY: vmu-target-filter-tests
vmu-target-filter-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
	 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
	 -ffunction-sections -fdata-sections -Iinclude tests/test_vmu_fs_target_filter.c \
	 -Wl,--gc-sections -o $(BUILD)/test-target-filter
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-target-filter
