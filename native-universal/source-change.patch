+    public = {name: data for name, data in extras.items() if '/' not in name}
+    public.update({'README.md': files['README-FIRST.md'], 'SOURCE-RECOVERY.md': recovery,
+                   'checkout-source.py': checkout, 'source-change.patch': patch,
