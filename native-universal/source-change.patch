+/* SPDX-License-Identifier: GPL-3.0-only */
+#define KUI_VMU_NATIVE_BACKGROUND 1
+#define KUI_RETAIL_ASYNC_TEST 1
+#define KUI_NATIVE_READER_DIAGNOSTIC 1
+#define KUI_NATIVE_COOP_PUMP 1
