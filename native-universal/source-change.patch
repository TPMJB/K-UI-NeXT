@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef KUI_NATIVE_LOADER_TIMELINE_H
+#define KUI_NATIVE_LOADER_TIMELINE_H
+#include <stdint.h>
+
+#define KUI_NATIVE_TIMELINE_HZ 781250u
+#define KUI_NATIVE_TIMELINE_BIN_TICKS 488281u /* 0.62499968 seconds */
+#define KUI_NATIVE_TIMELINE_BINS 32u
+#define KUI_NATIVE_TIMELINE_LONGEST 8u
+#define KUI_NATIVE_TIMELINE_REQUESTS 16u
+#define KUI_NATIVE_TIMELINE_CHAIN_GAP 26042u /* proximity threshold, NOT a frame witness */
+enum kui_native_loader_event_flags {
+    KUI_NATIVE_TIMELINE_ENTER=1u,
+    KUI_NATIVE_TIMELINE_EXIT=2u,
+    KUI_NATIVE_TIMELINE_MAPLE=3u,
+    KUI_NATIVE_TIMELINE_KIND_MASK=15u,
+    KUI_NATIVE_TIMELINE_CLOCK_VALID=0x100u,
+    KUI_NATIVE_TIMELINE_CLOCK_BREAK=0x200u,
+    KUI_NATIVE_TIMELINE_READ=0x400u,
+    KUI_NATIVE_TIMELINE_PENDING=0x800u,
+    KUI_NATIVE_TIMELINE_COMPLETE=0x1000u,
+    KUI_NATIVE_TIMELINE_FAILED=0x2000u
+};
+enum kui_native_loader_request_flags {
+    KUI_NATIVE_TIMELINE_PARTIAL=1u,
+    KUI_NATIVE_TIMELINE_REQUEST_FAILED=2u,
+    KUI_NATIVE_TIMELINE_REPLACED=4u,
+    KUI_NATIVE_TIMELINE_BAD_CLOCK=8u
+};
+/* Raw observations. result is the actual GD return at EXIT; its bit pattern
+ * represents int32_t. progress is completed bytes. The collector owns no IO.
+ * CLOCK_VALID means the wrapper admitted the exact timer profile at this
+ * sample. CLOCK_BREAK starts another epoch; no duration crosses epochs.
+ * Neither a valid sample nor modulo arithmetic proves an unobserved timer
+ * stop/reset did not occur while game code ran. */
+struct kui_native_loader_event {
+    uint32_t tick,flags,function,result,token,lba,count,progress;
+    uint32_t caller_sr,vbr,iprb,chcr,tcr,dmaor,ssr,state;
+};
+struct kui_native_loader_bin {
+    uint32_t epoch,tick,gd_ticks,calls,read_starts,read_completes,maples,invalid;
+};
+struct kui_native_loader_call {
+    struct kui_native_loader_event begin,end;
+    uint32_t elapsed,gap,epoch;
+};
+struct kui_native_loader_request {
+    uint32_t epoch,token,lba,count,begin_tick,end_tick,total_ticks,inside_ticks;
+    uint32_t outside_ticks,calls,progress,result,flags,chain_length,chain_ticks,chain_inside;
+};
+struct kui_native_loader_timeline {
+    struct kui_native_loader_bin bins[KUI_NATIVE_TIMELINE_BINS];
+    struct kui_native_loader_call longest[KUI_NATIVE_TIMELINE_LONGEST];
+    struct kui_native_loader_request requests[KUI_NATIVE_TIMELINE_REQUESTS];
+    struct kui_native_loader_event entered;
+    struct kui_native_loader_request active;
+    uint32_t events,valid,invalid,epoch,clock_breaks,unmatched,overflow,saturated;
+    uint32_t have_clock,last_tick,origin_tick,epoch_bin,bin_count,have_enter,have_exit,last_exit;
+    uint32_t longest_count,request_count,request_next,have_request,last_token;
+    uint32_t chain_length,chain_begin,chain_end,chain_inside,chain_epoch;
+    uint32_t max_call_ticks,max_gap_ticks,max_chain_length,max_chain_ticks,max_chain_inside;
+};
+_Static_assert(sizeof(struct kui_native_loader_event)==64u,"timeline input remains sixteen words");
+_Static_assert(sizeof(struct kui_native_loader_timeline)<=4096u,"timeline owns at most four KiB");
+void kui_native_loader_timeline_reset(struct kui_native_loader_timeline *);
+void kui_native_loader_timeline_add(struct kui_native_loader_timeline *,const struct kui_native_loader_event *);
+#endif
diff --git a/include/kui/native_readahead.h b/include/kui/native_readahead.h
new file mode 100644
index 0000000..5ce071d
--- /dev/null
+++ b/include/kui/native_readahead.h
@@ -0,0 +1,146 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef KUI_NATIVE_READAHEAD_H
+#define KUI_NATIVE_READAHEAD_H
+#include <stdint.h>
+#include <stdbool.h>
+#include "kui/retail_cursor.h"
+#include "sci_stream.h"
+#include "retail_async.h"
+#include "kui/native_readahead_layout.h"
+enum kui_native_ra_event {
+    KUI_NATIVE_RA_DELIVER=1u,
+    KUI_NATIVE_RA_TICK=2u,
+    KUI_NATIVE_RA_QUIESCE=3u,
+    KUI_NATIVE_RA_RESUME=4u,
+    KUI_NATIVE_RA_RESET=5u,
+    KUI_NATIVE_RA_CAPTURE_START=6u
+};
+struct kui_retail_cursor;
+/* Every pointer is proved against the immutable low resident by the stage.
+ * The auxiliary code invokes these standard C entries on its own stack. */
+struct kui_native_ra_low_ops {
+    uint32_t magic,version,bytes;
+    kui_retail_async_region_type **region_storage;
+    void (*deliver)(uint32_t wait);
+    void (*hook)(void);
+    void (*unhook)(void);
+    enum kui_sci_stream_result (*fetch)(uint32_t lba,uint32_t token_limit,bool polled);
+    enum kui_sci_stream_result (*poll)(bool interrupt);
+    const uint8_t *(*take)(uint32_t lba,enum kui_sci_stream_result *result);
+    enum kui_sci_stream_result (*stop)(void);
+    bool (*busy)(void);
+    enum kui_game_result (*feed)(struct kui_retail_cursor *,const uint8_t block[512]);
+};
+typedef uint32_t (*kui_native_ra_visit)(uint32_t event,uint32_t arg,
+    kui_retail_async_region_type *region,uint32_t reserved);
+struct kui_native_ra_config {
+    uint32_t version,bytes;
+    kui_retail_async_region_type *region;
+    const struct kui_native_ra_low_ops *ops;
+    uint8_t *data;
+    uint32_t data_bytes,lease,lease_bytes;
+};
+/* The relocation domain includes exports, context, code and private stack;
+ * the separately owned data arena is passed by the cold stage, never relocated. */
+struct kui_native_ra_exports {
+    uint32_t magic,version,bytes;
+    kui_native_ra_visit visit;
+    int (*init)(const struct kui_native_ra_config *);
+    void *context;
+    uint32_t image_end,stack_bottom,stack_top,memory_end;
+    uint32_t reserved[6];
+};
+struct kui_native_ra_stats {
+    uint32_t hits,misses,hit_requests,producer_blocks,producer_visits;
+    uint32_t crc_errors,token_errors,abandoned,seeks,quiesces,resumes;
+    uint32_t full,extent_ends,heartbeat_visits,irq_visits,guard_faults;
+    uint32_t max_visit_ticks,clock_bad;
+};
+/* Appended diagnostic prefix: the existing statistics and guard word keep
+ * their original offsets. These observations never authorize recovery. */
+enum kui_native_ra_failure_stage {
+    KUI_NATIVE_RA_STAGE_NONE=0u,KUI_NATIVE_RA_STAGE_POLL,
+    KUI_NATIVE_RA_STAGE_TAKE,KUI_NATIVE_RA_STAGE_APPEND,
+    KUI_NATIVE_RA_STAGE_FETCH,KUI_NATIVE_RA_STAGE_RESUME,
+    KUI_NATIVE_RA_STAGE_QUIESCE,KUI_NATIVE_RA_STAGE_COUNT
+};
+#define KUI_NATIVE_RA_RESULT_COUNT 8u
+/* Under __kui_native_readahead_pio_auxiliary, the otherwise unused NONE
+ * histogram row contains producer-only metrics. Failure rows1..6 retain
+ * their original meaning; capture-start clears these metrics too. The
+ * distinct pair profile rejects zero elapsed time for completed512B work
+ * as an invalid per-attempt interval and never admits a second block then. */
+enum kui_native_ra_pio_metric {
+    KUI_NATIVE_RA_PIO_ATTEMPTS=0u,KUI_NATIVE_RA_PIO_MAX_TICKS,
+    KUI_NATIVE_RA_PIO_CLOCK_BAD,KUI_NATIVE_RA_PIO_SECOND_ATTEMPTS,
+    KUI_NATIVE_RA_PIO_SECOND_TIME_SKIPS,KUI_NATIVE_RA_PIO_MAX_SINGLE_TICKS,
+    KUI_NATIVE_RA_PIO_WINDOW_OVERRUNS
+};
+#define KUI_NATIVE_RA_PIO_BLOCK_LIMIT 2u
+#define KUI_NATIVE_RA_PIO_WINDOW_TICKS 2344u
+#define KUI_NATIVE_RA_PIO_RESERVE_TICKS 1200u
+#define KUI_NATIVE_RA_PIO_SECOND_LIMIT_TICKS \
+    (KUI_NATIVE_RA_PIO_WINDOW_TICKS-KUI_NATIVE_RA_PIO_RESERVE_TICKS)
+enum kui_native_ra_skip {
+    KUI_NATIVE_RA_SKIP_QUIESCED=0u,KUI_NATIVE_RA_SKIP_ABANDONED,
+    KUI_NATIVE_RA_SKIP_NO_SEED,KUI_NATIVE_RA_SKIP_LOAN,
+    KUI_NATIVE_RA_SKIP_ACTIVE,KUI_NATIVE_RA_SKIP_PENDING,
+    KUI_NATIVE_RA_SKIP_FAILED,KUI_NATIVE_RA_SKIP_NOT_OPENED,
+    KUI_NATIVE_RA_SKIP_PORT_FAULT,KUI_NATIVE_RA_SKIP_BUSY,
+    KUI_NATIVE_RA_SKIP_GUEST_DMA,KUI_NATIVE_RA_SKIP_STREAM_POSITION,
+    KUI_NATIVE_RA_SKIP_DEFERRED,KUI_NATIVE_RA_SKIP_SPEC_OWNED,
+    KUI_NATIVE_RA_SKIP_COUNT
+};
+enum kui_native_ra_snapshot_flag {
+    KUI_NATIVE_RA_SNAP_ACTIVE=1u,KUI_NATIVE_RA_SNAP_PENDING=2u,
+    KUI_NATIVE_RA_SNAP_EXECUTING=4u,KUI_NATIVE_RA_SNAP_FAILED=8u,
+    KUI_NATIVE_RA_SNAP_SPEC_OWNED=16u,KUI_NATIVE_RA_SNAP_DEFERRED=32u,
+    KUI_NATIVE_RA_SNAP_QUIESCED=64u,KUI_NATIVE_RA_SNAP_ABANDONED=128u,
+    KUI_NATIVE_RA_SNAP_HAVE_SEED=256u,KUI_NATIVE_RA_SNAP_ACQUIRED=512u,
+    KUI_NATIVE_RA_SNAP_PORT_FAULT=1024u,KUI_NATIVE_RA_SNAP_OPENED=2048u,
+    KUI_NATIVE_RA_SNAP_IRQ=4096u
+};
+struct kui_native_ra_hw_snapshot {
+    uint32_t sar,dar,tcr,chcr,dmaor;
+    /* SMR | BRR<<8 | SCR<<16 | SSR<<24. No RDR read occurs. */
+    uint32_t sci;
+    /* SPTR | STBCR<<8 | PDTR<<16. */
+    uint32_t pins,tmu;
+};
+struct kui_native_ra_failure_snapshot {
+    uint32_t stage,result,event,flags,token,cursor_block;
+    uint32_t stream_state,stream_position,cache_base,cache_count,cache_end;
+    /* Physical block attempted by the recorded operation. FETCH records
+     * its next LBA before that LBA becomes the owned speculative block. */
+    uint32_t operation_lba;
+    /* Native loan state in bits0..15; SCI stream.unrepaired in bits16..23.
+     * This is the transport's existing failed single-byte repair count,
+     * not the number of repairs attempted during this capture. */
+    uint32_t loan_state;
+    /* ready[0] | ready[1]<<8 | kept<<16 | fill<<24. */
+    uint32_t rx_flags,ready_lba[2],kept_lba,arrived;
+    /* lost[0] | lost[1]<<16; indexes remain meaningful if fill is invalid. */
+    uint32_t lost;
+    struct kui_native_ra_hw_snapshot pre,post;
+    uint32_t post_stream_state,post_stream_position;
+};
+struct kui_native_ra_diagnostics {
+    uint32_t failures;
+    uint32_t stage_result[KUI_NATIVE_RA_STAGE_COUNT][KUI_NATIVE_RA_RESULT_COUNT];
+    uint32_t skipped[KUI_NATIVE_RA_SKIP_COUNT];
+    struct kui_native_ra_failure_snapshot first,last;
+};
+struct kui_native_ra_public {
+    uint32_t busy;
+    struct kui_native_ra_stats stats;
+    struct kui_native_ra_diagnostics diagnostics;
+};
+_Static_assert(sizeof(struct kui_native_ra_hw_snapshot)==32u,"read-ahead hardware snapshot ABI");
+_Static_assert(sizeof(struct kui_native_ra_failure_snapshot)==148u,"read-ahead failure snapshot ABI");
+_Static_assert(sizeof(struct kui_native_ra_public)==656u,"read-ahead diagnostic prefix ABI");
+#if UINTPTR_MAX == UINT32_MAX
+_Static_assert(sizeof(struct kui_native_ra_low_ops)==52u,"read-ahead low operations ABI");
+_Static_assert(sizeof(struct kui_native_ra_exports)==64u,"read-ahead auxiliary exports ABI");
+_Static_assert(sizeof(struct kui_native_ra_config)==32u,"read-ahead configuration ABI");
+#endif
+#endif
diff --git a/include/kui/native_readahead_cache.h b/include/kui/native_readahead_cache.h
new file mode 100644
index 0000000..54aee46
--- /dev/null
+++ b/include/kui/native_readahead_cache.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef KUI_NATIVE_READAHEAD_CACHE_H
+#define KUI_NATIVE_READAHEAD_CACHE_H
+#include "kui/retail_image.h"
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define KUI_NATIVE_RA_CACHE_BLOCKS 384u
+#define KUI_NATIVE_RA_CACHE_BLOCK_BYTES 512u
+#define KUI_NATIVE_RA_CACHE_BYTES (KUI_NATIVE_RA_CACHE_BLOCKS * KUI_NATIVE_RA_CACHE_BLOCK_BYTES)
+
+/* One contiguous physical-card interval. data belongs to the admitted lease,
+ * not a guest destination. A valid entry is published only after all512bytes
+ * have been copied. Calls are serialized by the reader's existing mask/lock.
+ * The caller supplies only normalized, CRC-checked blocks from stream_take. */
+struct kui_native_ra_cache {
+    uint8_t *data;
+    uint32_t base,head,count,end;
+};
+
+/* Exact192KiB,32-byte aligned arena, disjoint from the metadata. No arena
+ * clearing or IO occurs. Invalid arguments preserve the previous metadata. */
+bool kui_native_ra_cache_init(struct kui_native_ra_cache *,void *data,size_t bytes);
+/* Discard validity and select [base,end), end exclusive. The geometry must
+ * fit uint32_t; a card extent ending at2^32 is conservatively not prefetched. */
+bool kui_native_ra_cache_rebase(struct kui_native_ra_cache *,uint32_t base,uint32_t end);
+/* On a hit discard only blocks BEFORE lba. The requested block remains valid
+ * for adjacent raw-sector requests sharing one physical512-byte boundary.
+ * A miss never changes the window. A returned pointer is valid only until
+ * the next serialized mutation; it must not be retained by a guest. */
+const uint8_t *kui_native_ra_cache_lookup(struct kui_native_ra_cache *,uint32_t lba);
+/* Append exactly the next contiguous checked block, within the admitted
+ * extent and available ring capacity. Source and destination may overlap. */
+bool kui_native_ra_cache_append(struct kui_native_ra_cache *,uint32_t lba,const uint8_t checked[512]);
+bool kui_native_ra_cache_next(const struct kui_native_ra_cache *,uint32_t *lba);
+
+/* Recheck the bounded64-slot retained map's track/extent geometry, then
+ * return the end of the physical extent containing lba. No request cursor
+ * length authorizes prefetch. Invalid or ambiguous ownership returns0.
+ * Legal shared-container boundary blocks receive the smaller owner bound. */
+uint32_t kui_native_ra_extent_end(const struct kui_retail_manifest *,uint32_t lba);
+#endif
