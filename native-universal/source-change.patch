+def flat_aux(aux):
+    loads=[p for p in aux[2] if p[0]==1 and p[4]]
+    length=max(physical(p[3])+p[4] for p in loads)-physical(BASE)
+    require(0x1002<=length<=0x5000,'read-ahead initialized auxiliary span differs')
+    output=bytearray(length)
