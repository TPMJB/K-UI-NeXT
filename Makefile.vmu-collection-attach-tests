BUILD ?= build/vmu-collection-attach-host
HOST_CC ?= cc
.DEFAULT_GOAL := vmu-collection-attach-tests
ATTACH_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
 -ffunction-sections -fdata-sections -Iinclude -Isrc/loader
ATTACH_CORE := src/core/vmu_fs_admission.c src/core/vmu_persist_profile.c \
 src/core/vmu_persist_session.c src/core/vmu_store.c src/core/vmu_image.c \
 src/core/hash.c src/core/retail_image.c
ATTACH_STAGE := src/loader/vmu_persist_stage.c src/core/vmu_durable.c
.PHONY: vmu-collection-attach-tests
vmu-collection-attach-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(ATTACH_FLAGS) tests/test_vmu_collection_attach.c $(ATTACH_CORE) $(ATTACH_STAGE) \
	 src/core/vmu_fs_witness.c -Wl,--gc-sections -o $(BUILD)/test-attach
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-attach
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 python3 tests/test_vmu_ownership_hash_oracle.py \
	 --binary $(BUILD)/test-attach --report $(BUILD)/ownership-sha-oracle.json
	$(HOST_CC) $(ATTACH_FLAGS) tests/test_vmu_persist_session.c $(ATTACH_CORE) \
	 -Wl,--gc-sections -o $(BUILD)/test-ordinary-session
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-ordinary-session
	$(HOST_CC) $(ATTACH_FLAGS) tests/test_vmu_persist_stage.c $(ATTACH_CORE) $(ATTACH_STAGE) \
	 -Wl,--gc-sections -o $(BUILD)/test-ordinary-stage
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-ordinary-stage
