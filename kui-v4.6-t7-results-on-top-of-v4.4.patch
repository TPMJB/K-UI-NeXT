+  "derived": {
+    "cpu_cycles_saved_per_byte_vs_kos": {
+      "table": 11.0,
+      "slice2": 13.9,
+      "nibble": -2.2
+    },
+    "projected_effect_on_the_t7_capture": {
+      "table": {
