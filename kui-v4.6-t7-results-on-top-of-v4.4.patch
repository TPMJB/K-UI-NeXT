+  "agree": "BENCH hash uihz=2 crc16 agree=OK (4 implementations, identical results)",
+  "sd_kib_s_by_command_size_sectors": {
+    "32": {
+      "write_expand0": 1088.7,
+      "write_expand1": 1110.5,
+      "read_expand0": 631.3,
+      "read_expand1": 631.5
+    },
+    "128": {
+      "write_expand0": 1126.9,
+      "write_expand1": 1125.1,
+      "read_expand0": 639.3,
+      "read_expand1": 642.5
