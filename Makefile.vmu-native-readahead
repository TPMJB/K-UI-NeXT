BUILD ?= build/native-readahead
include Makefile.vmu-native-sdk-sci-route
override TEST_GUIDE := docs/vmu-native-readahead-test.md
FLAGS += -DKUI_NATIVE_READAHEAD=1 \
 -DKUI_NATIVE_RA_AUX_BIN='"$(BUILD)/native-ra-aux.bin"' \
 -DKUI_NATIVE_RA_AUX_RELOC='"$(BUILD)/native-ra-aux.reloc"'
NATIVE_FLAGS += -DKUI_NATIVE_READAHEAD=1
RA_FLAGS = $(NATIVE_FLAGS) -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 \
 -DKUI_RETAIL_TRANSPORT=1 -DKUI_SCI_SD_NO_BLOCK=1 -DKUI_RETAIL_MANIFEST_SLOTS=64 \
 -DKUI_GENERAL_SCI_RESUME_FIX=1
RA_SRC = src/loader/native_readahead_aux.c src/core/native_readahead_cache.c src/loader/minic.c
RA_OBJ = $(patsubst %.c,$(BUILD)/ra/%.o,$(RA_SRC)) $(BUILD)/native_ra_aux_entry.o
$(RA_OBJ): $(BUILD)/readonly-config
$(BUILD)/ra/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(RA_FLAGS) -MMD -MP -c $< -o $@
$(BUILD)/native_ra_aux_entry.o: src/loader/native_readahead_aux_entry.S
	@mkdir -p $(@D)
	$(CC) $(RA_FLAGS) -c $< -o $@
$(BUILD)/native-ra-aux.elf: $(RA_OBJ) src/loader/native_readahead_aux.ld
	$(CC) $(LINK) -Wl,--emit-relocs -Tsrc/loader/native_readahead_aux.ld \
	 -Wl,-Map,$(BUILD)/native-ra-aux.map -o $@ $(RA_OBJ) -lgcc
$(BUILD)/native-ra-aux.bin: $(BUILD)/native-ra-aux.elf
	$(OBJCOPY) -O binary $< $@
$(BUILD)/native-ra-aux.reloc: $(BUILD)/native-ra-aux.elf $(BUILD)/native-ra-aux.bin
	python3 tools/vmu_native_relocations.py $< $(BUILD)/native-ra-aux.bin $@ --link-base 0x8c421000 --span-bytes 0x4000
$(BUILD)/stage/src/loader/vmu_native_heap_probe_stage.o: $(BUILD)/native-ra-aux.bin $(BUILD)/native-ra-aux.reloc
-include $(RA_OBJ:.o=.d)
.PHONY: readahead-cache-host-tests readahead-lease-host-tests readahead-aux-host-tests readahead-low-host-tests
readahead-cache-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) tests/test_native_readahead_cache.c \
	 src/core/native_readahead_cache.c src/core/retail_image.c src/core/hash.c src/core/data.c \
	 -Wl,--gc-sections -o $(BUILD)/test-ra-cache
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-ra-cache
readahead-lease-host-tests:
	python3 tests/test_vmu_native_readahead_lease.py
readahead-aux-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -O2 $(STALL_READER_FLAGS) -Itests \
	 -DKUI_NATIVE_READAHEAD=1 -DKUI_VMU_NATIVE_BACKGROUND=1 -DKUI_NATIVE_REQUEST_TIMING=1 \
	 -DKUI_NATIVE_READAHEAD_AUX_HOST_TEST=1 tests/test_native_readahead_aux.c \
	 src/loader/native_readahead_aux.c src/core/native_readahead_cache.c \
	 src/core/retail_cursor.c src/core/retail_image.c src/loader/sci_stream.c \
	 -Wl,--gc-sections -o $(BUILD)/test-ra-aux
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-ra-aux
readahead-low-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(PASSIVE_HOST_FLAGS) -O2 $(STALL_READER_FLAGS) \
	 -DKUI_NATIVE_REQUEST_TIMING=1 -DKUI_NATIVE_COOP_PUMP=1 -DKUI_NATIVE_IRQ_REARM=1 \
	 -DKUI_NATIVE_LOADER_TIMELINE=1 -DKUI_VMU_NATIVE_BACKGROUND=1 -DKUI_NATIVE_SDK_SCI_ROUTE=1 \
	 -DKUI_NATIVE_READAHEAD=1 $(STALL_READER_SRC) tests/test_retail_async_readahead_bridge.c \
	 -Wl,--gc-sections -o $(BUILD)/test-ra-low
	ASAN_OPTIONS=detect_leaks=0 $(BUILD)/test-ra-low
