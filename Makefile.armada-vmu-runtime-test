BUILD ?= build/armada-vmu-runtime-test
HOST_CC ?= cc
HOST_FLAGS ?= -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic
HOST_SANITIZERS ?= -fsanitize=address,undefined -fno-omit-frame-pointer -fno-pie -no-pie
.DEFAULT_GOAL := host-tests
.PHONY: host-tests
SOURCES := tests/test_armada_ce_vmu_runtime.c src/loader/armada_ce_vmu_runtime.c src/core/armada_ce_vmu_runtime_contract.c src/core/armada_ce_vmu_write.c src/core/vmu_deferred_io.c src/core/vmu_emulation.c src/core/vmu_durable.c src/core/retail_image.c
$(BUILD)/test-runtime: $(SOURCES) include/kui/armada_ce_vmu_runtime.h include/kui/armada_ce_vmu_sd.h include/kui/armada_ce_vmu_sd_pio.h
	@mkdir -p $(@D)
	$(HOST_CC) $(HOST_FLAGS) $(HOST_SANITIZERS) -ffunction-sections -fdata-sections -Iinclude -Isrc/loader -DKUI_ARMADA_CE_VMU_RUNTIME_TEST=1 -DKUI_ARMADA_CE_VMU_WRITE_RUNTIME=1 -DKUI_ARMADA_CE_MAPLE_WRITE_STAGING=1 -DKUI_ARMADA_CE_MAPLE_WRITE_LAYOUT=1 $(SOURCES) -Wl,--gc-sections -o $@
host-tests: $(BUILD)/test-runtime
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-runtime
