    "adaptations": [
      "src/libchdr_chd.c: reject unsupported legacy hunk map types instead of returning stale output",
      "src/libchdr_chd.c: replace v4/v5 self-reference recursion with iterative resolution capped at 4096 hops; validate complete 48-bit v5 target; retain optional cache for the resolved base hunk",
      "kui_config.h: shell-only low-memory full-CRC CD decoding and private newer-miniz symbol namespace; no capture codec replacement",
      "src/libchdr_huffman.c, src/libchdr_bitstream.c, src/libchdr_codec_huff.c: check constructor allocations and clean partial Huffman state; propagate allocation failures before dereferencing decoder/bitstream pointers",
      "src/libchdr_chd.c: free and zero partial lazy codec state after init failure, allowing close and retry without leaks or dangling pointers",
      "src/libchdr_codec_lzma.c: safely free before allocator initialization and report SDK allocation failure as out of memory",
      "src/libchdr_codec_zstd.c: report failed stream allocation as out of memory"
    ],
