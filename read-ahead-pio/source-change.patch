+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/retail_image.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include "stage_fast_crc32.h"
+static uint8_t image[8197];
+int main(void) {
+    assert(kui_stage_crc32(0,"123456789",9)==0xcbf43926u);
