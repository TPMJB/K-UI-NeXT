+DEFAULT_AT=REGION+0x534
+OWNER_AT=REGION+0x538
+FRAME=REGION+0x240
+HOOKED=REGION+0x2d0
+REARMS=REGION+0x2e4
+LOAN=REGION+0x2f4
+GUARD=0x8c007ba0
+PRIVATE_TOP=0x8c007cf0
