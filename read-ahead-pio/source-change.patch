+                    self.write(self.region+0x474,self.next+1)
+                    self.write(self.region+0x498,self.next+1)
+            elif name=='_kui_sci_stream_take':
+                assert args[0]==self.next
+                assert STACK_BOTTOM+16<=args[1]<=STACK_TOP-36
