+extern const struct kui_native_ra_low_ops kui_native_ra_reader_ops;
+static uint32_t clock_counter=UINT32_C(0x70000000),eri_slot,rxi_slot;
+void kui_retail_sdk_sci_entry(void) {}
+uint32_t kui_retail_async_test_read32(uint32_t address) {
+    if(address==UINT32_C(0xffd8000c)) {
+        uint32_t result=clock_counter;clock_counter-=19u;return result;
+    }
+    if(address==KUI_NATIVE_SDK_SCI_OWNER_VBR+KUI_NATIVE_SDK_SCI_ERI_SLOT_OFFSET)return eri_slot;
+    assert(address==KUI_NATIVE_SDK_SCI_OWNER_VBR+KUI_NATIVE_SDK_SCI_RXI_SLOT_OFFSET);
+    return rxi_slot;
+}
+volatile uint32_t kui_retail_hook_active,kui_retail_hook_fault;
+#define main original_async_main
+#define kui_sci_sd_acquire fixture_sci_sd_acquire
+#include "test_retail_async.c"
+#undef kui_sci_sd_acquire
+#undef main
+
+uint32_t kui_retail_async_vmu_test_sr(void) {return 0xf0u;}
+enum kui_loader_sd_result kui_sci_sd_acquire(void) {
+    enum kui_loader_sd_result result=fixture_sci_sd_acquire();
+    if(result==KUI_LOADER_SD_OK)R.shared.port.acquired=true;
+    return result;
+}
+void kui_sci_sd_release(void) {
+    CHECK(kui_retail_hook_active==1u && R.shared.port.acquired &&
+        !kui_sci_stream_busy() && !R.shared.stream.state &&
+        !R.engine.hooked && !R.engine.release.armed);
+    R.shared.port.acquired=false;
+}
+
+static void setup_sdk(unsigned how,bool ready) {
+    cooked_fixture=true;setup(KUI_NATIVE_SDK_SCI_OWNER_VBR,how,48u,false);mode(2048u);
+    kui_retail_hook_active=kui_retail_hook_fault=0u;
+    R.vector600[KUI_NATIVE_SDK_SCI_DEFAULT_INDEX]=UINT32_C(0x8c1add0c);
+    R.vector600[KUI_NATIVE_SDK_SCI_VBR_INDEX]=KUI_NATIVE_SDK_SCI_OWNER_VBR;
+    eri_slot=rxi_slot=(uint32_t)(uintptr_t)kui_retail_sdk_sci_entry;
+    if(ready)R.vector600[KUI_NATIVE_SDK_SCI_COOKIE_INDEX]=KUI_NATIVE_SDK_SCI_COOKIE;
+}
+static void complete(int32_t token) {
+    CHECK(finish(token,0u,1u)==KUI_GD_COMPLETED);
+    compare(45001u,64u,OUTPUT);
+    CHECK(!R.engine.hooked && !R.engine.release.armed && !hw.vbr_sets);
+}
+
+static unsigned deliveries,quiesces;
+static uint32_t delivered_wait,handled=1u,quiesce_ok=1u;
+static bool stop_speculation;
+static uint32_t auxiliary(uint32_t event,uint32_t arg,
+    kui_retail_async_region_type *region,uint32_t reserved) {
+    CHECK(region==&R && !reserved);
+    if(event==KUI_NATIVE_RA_DELIVER) {
+        ++deliveries;delivered_wait=arg;
+        return handled;
+    }
+    CHECK(event==KUI_NATIVE_RA_QUIESCE && !arg);
+    CHECK(kui_retail_hook_active==1u && !R.shared.service.pending &&
+        !R.shared.service.executing && !R.engine.active && !R.engine.in_irq);
+    ++quiesces;
+    if(stop_speculation) {
+        kui_native_ra_reader_ops.unhook();
+        CHECK(kui_native_ra_reader_ops.stop()==KUI_SCI_STREAM_OK);
+    }
+    return quiesce_ok;
+}
+static void bind_auxiliary(void) {
+    R.vector600[KUI_NATIVE_RA_ENTRY_INDEX]=(uint32_t)(uintptr_t)auxiliary;
+    deliveries=quiesces=0u;handled=quiesce_ok=1u;stop_speculation=false;
+}
+static void descriptor(void) {
+    const struct kui_native_ra_low_ops *ops=&kui_native_ra_reader_ops;
+    CHECK(ops->magic==KUI_NATIVE_RA_OPS_MAGIC && ops->version==KUI_NATIVE_RA_VERSION &&
+        ops->bytes==sizeof(*ops));
+    CHECK(ops->region_storage==&kui_retail_async_region_storage && ops->deliver &&
+        ops->hook && ops->unhook && ops->fetch==kui_sci_stream_fetch &&
+        ops->poll==kui_sci_stream_poll && ops->take==kui_sci_stream_take &&
+        ops->stop==kui_sci_stream_stop && ops->busy==kui_sci_stream_busy &&
+        ops->feed==kui_retail_cursor_feed);
+}
+static void deliver_handoff(void) {
+    setup_sdk(X,true);bind_auxiliary();
+    int32_t token=request(45001u,64u,OUTPUT);
+    CHECK(deliveries && !delivered_wait && !R.engine.cursor.done &&
+        !R.engine.stats.call_blocks && !kui_sci_stream_busy());
+    CHECK(gd(KUI_GD_CHECK,(uint32_t)token,STATUS)==KUI_GD_PROCESSING);
+    CHECK(delivered_wait==20u && !R.engine.cursor.done && !R.engine.stats.call_blocks);
+    handled=0u;complete(token); /* Invalid/unhandled auxiliary falls back. */
+    CHECK(R.engine.stats.call_blocks==256u && !quiesces);
+}
+static void speculative_irq_and_loan(void) {
+    setup_sdk(X,true);int32_t token=request(45001u,64u,OUTPUT);complete(token);
+    bind_auxiliary();
+    CHECK(kui_native_ra_reader_ops.fetch(R.engine.cursor.block+1u,65536u,false)==KUI_SCI_STREAM_OK);
+    CHECK(kui_sci_stream_busy() && !R.engine.active && !R.shared.service.pending);
+    kui_native_ra_reader_ops.hook();
+    CHECK(R.engine.hooked && kui_retail_sdk_sci_dispatch(0x4e0u)==0u);
+    CHECK(deliveries==1u && !delivered_wait && R.engine.hooked && kui_sci_stream_busy());
+    struct kui_loader_sd copied;
+    stop_speculation=true;
+    CHECK(kui_retail_native_async_loan_begin(&copied)==KUI_VMU_NATIVE_ASYNC_LOAN_OK);
+    CHECK(quiesces==1u && !kui_sci_stream_busy() && !R.engine.hooked &&
+        !R.engine.opened && !R.shared.port.acquired &&
+        R.engine.native_loan_state==KUI_VMU_NATIVE_ASYNC_LOAN_WRITER);
+    CHECK(kui_retail_native_async_loan_end(true)==KUI_VMU_NATIVE_ASYNC_LOAN_OK);
+    CHECK(!kui_retail_hook_active && R.engine.native_loan_state==KUI_VMU_NATIVE_ASYNC_LOAN_IDLE);
+    CHECK(quiesces==1u && deliveries==1u); /* Restart belongs to a later TICK. */
+}
+static void real_demand_and_refused_quiesce(void) {
+    setup_sdk(X,true);bind_auxiliary();handled=0u;
+    int32_t token=request(45001u,64u,OUTPUT);
+    struct kui_loader_sd copied;
+    CHECK(kui_retail_native_async_loan_begin(&copied)==KUI_VMU_NATIVE_ASYNC_LOAN_BUSY);
+    CHECK(!quiesces && !kui_retail_hook_active && R.shared.service.pending);
+    complete(token);
+    quiesce_ok=0u;
+    CHECK(!kui_sci_stream_busy());
+    CHECK(kui_retail_native_async_loan_begin(&copied)==KUI_VMU_NATIVE_ASYNC_LOAN_BUSY);
+    CHECK(quiesces==1u && !kui_retail_hook_active &&
+        R.engine.native_loan_state==KUI_VMU_NATIVE_ASYNC_LOAN_IDLE);
+    R.vector600[KUI_NATIVE_RA_ENTRY_INDEX]=0u;
+    CHECK(kui_retail_native_async_loan_begin(&copied)==KUI_VMU_NATIVE_ASYNC_LOAN_OK);
+    CHECK(kui_retail_native_async_loan_end(true)==KUI_VMU_NATIVE_ASYNC_LOAN_OK);
+}
+static void pre_quiesce_guards(void) {
+    for(unsigned cause=0u;cause<6u;cause++) {
+        setup_sdk(X,true);bind_auxiliary();handled=0u;
+        int32_t token=request(45001u,64u,OUTPUT);complete(token);
+        switch(cause) {
+        case 0u:R.shared.service.initialized=0u;break;
+        case 1u:R.shared.service.pending=1u;break;
+        case 2u:R.shared.service.executing=1u;break;
+        case 3u:R.engine.active=1u;break;
+        case 4u:R.engine.in_irq=1u;break;
+        default:R.engine.release.depth=1u;break;
+        }
+        kui_retail_async_region_type before=R;
+        struct kui_loader_sd copied={0},unchanged=copied;
+        unsigned clocks=card.clocks;
+        CHECK(kui_retail_native_async_loan_begin(&copied)==KUI_VMU_NATIVE_ASYNC_LOAN_BUSY);
+        CHECK(!quiesces && !kui_retail_hook_active && card.clocks==clocks &&
+            !memcmp(&before,&R,sizeof(R)) && !memcmp(&copied,&unchanged,sizeof(copied)));
+    }
+}
+int main(void) {
+    for(unsigned how=X;how<=Y;how++) {
+        setup_sdk(how,true);int32_t token=request(45001u,64u,OUTPUT);complete(token);
+    }
+    descriptor();deliver_handoff();
+    speculative_irq_and_loan();real_demand_and_refused_quiesce();pre_quiesce_guards();
+    printf("native read-ahead low bridge: %u checks; null/fallback, handled delivery, inactive speculative IRQ, quiesce and demand/loan exclusion passed\n",checks);
+    return 0;
+}
diff --git a/tests/test_retail_async_sdk_sci_route.c b/tests/test_retail_async_sdk_sci_route.c
new file mode 100644
index 0000000..fa6ff8d
--- /dev/null
+++ b/tests/test_retail_async_sdk_sci_route.c
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Real native reader C against the existing byte/card/DMA model. SDK callback
+ * assembly and original VBR restore are executed separately by SH tests. */
+#include <assert.h>
+#include <stdint.h>
+#include "kui/native_sdk_sci_runtime.h"
+static uint32_t clock_counter=UINT32_C(0x70000000),eri_slot,rxi_slot;
+static unsigned slot_reads;
+void kui_retail_sdk_sci_entry(void) {}
+uint32_t kui_retail_async_test_read32(uint32_t address) {
+    if(address==UINT32_C(0xffd8000c)) {
+        uint32_t result=clock_counter;clock_counter-=19u;return result;
+    }
+    ++slot_reads;
+    if(address==KUI_NATIVE_SDK_SCI_OWNER_VBR+KUI_NATIVE_SDK_SCI_ERI_SLOT_OFFSET)return eri_slot;
+    assert(address==KUI_NATIVE_SDK_SCI_OWNER_VBR+KUI_NATIVE_SDK_SCI_RXI_SLOT_OFFSET);
+    return rxi_slot;
+}
+volatile uint32_t kui_retail_hook_active,kui_retail_hook_fault;
+#define main original_async_main
+#include "test_retail_async.c"
+#undef main
+
+static uint32_t callback(void) {return (uint32_t)(uintptr_t)kui_retail_sdk_sci_entry;}
+static void setup_sdk(unsigned how,bool ready) {
+    cooked_fixture=true;setup(KUI_NATIVE_SDK_SCI_OWNER_VBR,how,48u,false);mode(2048u);
+    kui_retail_hook_active=kui_retail_hook_fault=0u;slot_reads=0u;
+    R.vector600[KUI_NATIVE_SDK_SCI_DEFAULT_INDEX]=UINT32_C(0x8c1add0c);
+    R.vector600[KUI_NATIVE_SDK_SCI_VBR_INDEX]=KUI_NATIVE_SDK_SCI_OWNER_VBR;
+    eri_slot=rxi_slot=callback();
+    if(ready)R.vector600[KUI_NATIVE_SDK_SCI_COOKIE_INDEX]=KUI_NATIVE_SDK_SCI_COOKIE;
+}
+static void complete(int32_t token) {
+    CHECK(finish(token,0u,1u)==KUI_GD_COMPLETED);
+    compare(45001u,64u,OUTPUT);
+    CHECK(!R.engine.hooked && !R.engine.release.armed && !hw.vbr_sets);
+}
+static void bootstrap_foreground(unsigned how) {
+    setup_sdk(how,false);hw.iprb=0x5a9fu;
+    int32_t token=request(45001u,64u,OUTPUT);
+    CHECK(R.engine.active && R.engine.hooked && !R.engine.release.armed);
+    CHECK(hw.iprb==0x5a0fu && !slot_reads && hw.vbr==KUI_NATIVE_SDK_SCI_OWNER_VBR);
+    unsigned before=R.engine.stats.call_blocks;
+    CHECK(gd(KUI_GD_CHECK,(uint32_t)token,STATUS)==KUI_GD_PROCESSING);
+    CHECK(R.engine.stats.call_blocks-before==(how==Y?25u:20u));
+    complete(token);CHECK(hw.iprb==0x5a9fu);
+}
+static void owned_interrupts(unsigned how) {
+    setup_sdk(how,true);
+    int32_t token=request(45001u,64u,OUTPUT);
+    CHECK(R.engine.hooked && R.engine.release.armed==0x10u && hw.iprb==0x5a1fu);
+    for(unsigned i=0u;i<6u;i++) {
+        m.delay=0u;elapse();unsigned before=R.engine.stats.irq_blocks;
+        CHECK(kui_retail_sdk_sci_dispatch(i&1u?0x500u:0x4e0u)==0u);
+        CHECK(R.engine.stats.irq_blocks-before==KUI_RETAIL_NATIVE_IRQ_BATCH_LIMIT);
+        CHECK(hw.vbr==KUI_NATIVE_SDK_SCI_OWNER_VBR && !hw.vbr_sets);
+    }
+    complete(token);CHECK(hw.iprb==0x5a0fu);
+}
+static void original_owner_fields(void) {
+    for(unsigned ready=0u;ready<2u;ready++)for(unsigned field=0u;field<0x100u;field+=0x10u) {
+        setup_sdk(X,ready!=0u);uint16_t original=(uint16_t)(0x5a0fu|field);hw.iprb=original;
+        int32_t token=request(45001u,64u,OUTPUT);
+        CHECK(R.engine.release.sci==field && R.engine.release.armed==(ready?0x10u:0u));
+        complete(token);CHECK(hw.iprb==original);
+    }
+}
+static void owner_field_changes(void) {
+    for(unsigned field=0u;field<0x100u;field+=0x10u) {
+        setup_sdk(X,true);hw.iprb=0x5a9fu;
+        int32_t token=request(45001u,64u,OUTPUT);
+        hw.iprb=(uint16_t)(0x5a0fu|field);
+        (void)gd(KUI_GD_DRIVE,STATUS,0u);
+        unsigned owner=field==0x10u?0x90u:field;
+        CHECK(hw.iprb==0x5a1fu && R.engine.release.sci==owner);
+        complete(token);CHECK(hw.iprb==(uint16_t)(0x5a0fu|owner));
+    }
+}
+static void lost_route(unsigned cause) {
+    setup_sdk(X,true);hw.iprb=0x5a9fu;
+    int32_t token=request(45001u,64u,OUTPUT);
+    CHECK(hw.iprb==0x5a1fu && R.engine.release.sci==0x90u);
+    switch(cause) {
+    case 0u:R.vector600[KUI_NATIVE_SDK_SCI_COOKIE_INDEX]^=1u;break;
+    case 1u:R.vector600[KUI_NATIVE_SDK_SCI_VBR_INDEX]^=4u;break;
+    case 2u:hw.vbr^=4u;break;
+    case 3u:eri_slot^=4u;break;
+    default:rxi_slot^=4u;break;
+    }
+    unsigned reads_before=slot_reads;
+    CHECK(kui_retail_sdk_sci_dispatch(0x4e0u)==UINT32_C(0x8c1add0c));
+    CHECK(hw.iprb==0x5a0fu && !R.engine.release.armed && R.engine.release.sci==0x90u);
+    if(cause<3u)CHECK(slot_reads==reads_before);
+    (void)gd(KUI_GD_DRIVE,STATUS,0u);
+    CHECK(hw.iprb==0x5a0fu && R.engine.release.sci==0x90u);
+    complete(token);CHECK(hw.iprb==0x5a9fu);
+}
+static void unowned_and_busy(void) {
+    setup_sdk(X,true);
+    CHECK(kui_retail_sdk_sci_dispatch(0x4e0u)==UINT32_C(0x8c1add0c));
+    int32_t token=request(45001u,64u,OUTPUT);
+    unsigned before=R.engine.stats.exec_int,progress=R.engine.cursor.done;
+    CHECK(kui_retail_sdk_sci_dispatch(0x420u)==UINT32_C(0x8c1add0c));
+    kui_retail_hook_active=1u;
+    CHECK(kui_retail_sdk_sci_dispatch(0x4e0u)==UINT32_C(0x8c1add0c));
+    kui_retail_hook_active=0u;R.engine.native_loan_state=KUI_VMU_NATIVE_ASYNC_LOAN_WRITER;
+    CHECK(kui_retail_sdk_sci_dispatch(0x500u)==UINT32_C(0x8c1add0c));
+    CHECK(R.engine.stats.exec_int==before && R.engine.cursor.done==progress);
+    R.engine.native_loan_state=KUI_VMU_NATIVE_ASYNC_LOAN_IDLE;
+    complete(token);
+}
+int main(void) {
+    bootstrap_foreground(X);bootstrap_foreground(Y);owned_interrupts(X);owned_interrupts(Y);
+    original_owner_fields();owner_field_changes();
+    for(unsigned cause=0u;cause<5u;cause++)lost_route(cause);
+    unowned_and_busy();
+    printf("native SDK SCI route: %u checks; bootstrapSCI0, readySCI1, all16ownerfields, lostroute masks, IRQdata, busy/loan/unowned forwarding and noVBRwrites passed\n",checks);
+    return 0;
+}
diff --git a/tests/test_retail_async_service_cadence.c b/tests/test_retail_async_service_cadence.c
new file mode 100644
index 0000000..df985be
--- /dev/null
+++ b/tests/test_retail_async_service_cadence.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Compare identical finite GD/IRQ schedules against real reader revisions.
+ * A round is a caller opportunity, not a Dreamcast video frame or timing
+ * measurement. Unlike finish(), this never supplies unlimited interrupts. */
+#if KUI_NATIVE_READER_DIAGNOSTIC
+#include <assert.h>
+#include <stdint.h>
+uint32_t kui_retail_async_test_read32(uint32_t address) {
+    static uint32_t counter;
+    assert(address==UINT32_C(0xffd8000c));
+    counter-=19u;return counter;
+}
+#endif
+#define main original_async_main
+#include "test_retail_async.c"
+#undef main
+
+struct counts {unsigned request,check,exec,irq;};
+static struct counts maximum;
+static unsigned delivered(void) {return R.engine.stats.call_blocks+R.engine.stats.irq_blocks;}
+static void update(unsigned *p,unsigned v) {if(v>*p)*p=v;}
+static int32_t call(uint32_t function,int32_t token) {
+    unsigned before=delivered();
+    int32_t result=gd(function,function==KUI_GD_CHECK?(uint32_t)token:0u,
+        function==KUI_GD_CHECK?STATUS:0u);
+    update(function==KUI_GD_EXEC?&maximum.exec:&maximum.check,delivered()-before);
+    return result;
+}
+static void scenario(unsigned how,bool cooked,unsigned delay,unsigned schedule) {
+    cooked_fixture=cooked;setup(GAME_VBR,how,48,false);mode(2048);
+    memset(&maximum,0,sizeof(maximum));m.delay=delay;
+    unsigned before=delivered();int32_t token=request(45001u,64u,OUTPUT);
+    maximum.request=delivered()-before;
+    unsigned rounds=0,irq_entries=0;
+    int32_t status=KUI_GD_PROCESSING;
+    while(R.engine.active) {
+        /* At most one in-flight reception finishes between caller visits.
+         * Time within an entry remains the existing model's register delay. */
+        elapse();
+        kui_retail_hook_sr=schedule==2u?0u:0xf0u;
+        if(schedule==2u && hooked() && kui_sci_stream_busy()) {
+            before=delivered();CHECK(!kui_retail_async_irq());
+            update(&maximum.irq,delivered()-before);++irq_entries;
+        }
+        if(schedule==1u)CHECK(call(KUI_GD_EXEC,token)==0);
+        status=call(KUI_GD_CHECK,token);
+        if(schedule==3u && status==KUI_GD_PROCESSING)status=call(KUI_GD_CHECK,token);
+        CHECK(++rounds<4096u);
+    }
+    if(status!=KUI_GD_COMPLETED)status=call(KUI_GD_CHECK,token);
+    CHECK(status==KUI_GD_COMPLETED);
+    compare(45001u,64u,OUTPUT);
+    CHECK(!kui_sci_stream_stats()->polled);
+    printf("{\"how\":%u,\"cooked\":%u,\"delay\":%u,\"schedule\":%u,"
+        "\"rounds\":%u,\"irq_entries\":%u,\"request_max\":%u,\"check_max\":%u,"
+        "\"exec_max\":%u,\"irq_max\":%u,\"exact_output\":true}\n",
+        how,cooked,delay,schedule,rounds,irq_entries,maximum.request,
+        maximum.check,maximum.exec,maximum.irq);
+}
+static void hot_interrupt(unsigned how) {
+    cooked_fixture=true;setup(GAME_VBR,how,48,false);mode(2048);
+    int32_t token=request(45001u,64u,OUTPUT);m.delay=0;elapse();
+    unsigned before=delivered();CHECK(!kui_retail_async_irq());
+    unsigned blocks=delivered()-before;
+    CHECK(finish(token,8,1)==KUI_GD_COMPLETED);compare(45001u,64u,OUTPUT);
+    printf("{\"hot_irq\":true,\"how\":%u,\"blocks_in_one_irq\":%u,\"exact_output\":true}\n",how,blocks);
+}
+int main(void) {
+    for(unsigned how=X;how<=Y;++how)
+        for(unsigned cooked=0;cooked<2u;++cooked)
+            for(unsigned delay=0;delay<3u;++delay)
+                for(unsigned schedule=0;schedule<4u;++schedule)
+                    scenario(how,cooked,delay==0u?0u:delay==1u?1000u:5000u,schedule);
+    hot_interrupt(X);hot_interrupt(Y);
+    return 0;
+}
