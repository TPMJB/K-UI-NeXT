+    append(&c,UINT32_MAX-2u);append(&c,UINT32_MAX-1u);
+    CHECK(!kui_native_ra_cache_next(&c,&next));
+    contents(kui_native_ra_cache_lookup(&c,UINT32_MAX-1u),UINT32_MAX-1u);
+    sentinels();
+}
