diff --git a/tests/test_native_compact_font.py b/tests/test_native_compact_font.py
new file mode 100644
index 0000000..f857e59
--- /dev/null
+++ b/tests/test_native_compact_font.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Compare every decoded low-resident glyph row with the original font."""
+import os,re,subprocess,tempfile
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+s=(root/'src/loader/retail_display.c').read_text()
+a=s.index('static const uint8_t glyphs[36][7]');b=s.index('\n};',a)
+expected=bytes(int(x) for row in re.findall(r'\{([^{}]+)\}',s[a:b]) for x in row.split(','))
+assert len(expected)==252
+a=s.index('static const uint8_t timeline_glyphs[158]');b=s.index('\n};',a)
+packed=bytes(int(x) for x in s[s.index('{',a)+1:b].replace('\n','').split(',') if x.strip())
+assert len(packed)==158
+decoded=[]
+for row in range(252):
+ bit=row*5;at=bit>>3
+ assert at+1<len(packed)
+ decoded.append(((packed[at]|packed[at+1]<<8)>>(bit&7))&31)
+assert bytes(decoded)==expected
+# Four unused bits in the final byte are padding, not another hidden row.
+assert not packed[-1]&0xf0
+with tempfile.TemporaryDirectory(prefix='kui-compact-font-') as t:
+ p=Path(t);source=p/'font.c';exe=p/'font'
+ source.write_text('#include <stdio.h>\n#include "'+str(root/'src/loader/retail_display.c')+'"\nint main(void){for(unsigned g=0;g<36u;++g)for(unsigned r=0;r<7u;++r)putchar((int)glyph_row(g,r));return 0;}\n')
+ for timeline in (0,1):
+  subprocess.run([os.environ.get('HOST_CC','cc'),'-std=c11','-Os','-Wall','-Wextra','-Werror','-ffunction-sections','-fdata-sections',
+   '-DKUI_NATIVE_COOP_PUMP=1','-DKUI_RETAIL_ASYNC=1','-DKUI_NATIVE_LOADER_TIMELINE='+str(timeline),
+   '-Iinclude','-Isrc/loader',str(source),'-Wl,--gc-sections','-o',str(exe)],cwd=root,check=True)
+  assert subprocess.check_output([str(exe)])==expected
+print('compact resident fonts: original 180B and contiguous 158B forms decode all 252 glyph rows exactly')
diff --git a/tests/test_native_loader_timeline.c b/tests/test_native_loader_timeline.c
new file mode 100644
index 0000000..53b10b4
--- /dev/null
+++ b/tests/test_native_loader_timeline.c
@@ -0,0 +1,187 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "kui/native_loader_timeline.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static unsigned checks;
+#define CHECK(c) do {++checks;assert(c);} while(0)
+static struct kui_native_loader_timeline trace;
+static struct kui_native_loader_event event;
+
+static void sample(uint32_t kind,uint32_t tick,uint32_t fn,uint32_t token,uint32_t flags) {
+    memset(&event,0,sizeof(event));
+    event.flags=kind|KUI_NATIVE_TIMELINE_CLOCK_VALID|flags;
+    event.tick=tick;event.function=fn;event.token=token;
+    event.lba=45000u+token;event.count=73u;event.progress=token*512u;
+    event.caller_sr=0x700000f1u;event.vbr=0x8c00f400u;event.iprb=0xa50fu;
+    event.chcr=0x4911u;event.tcr=513u;event.dmaor=0x8201u;event.ssr=0x84u;
+    event.state=0xb03u;
+    if(fn==0u && kind==KUI_NATIVE_TIMELINE_EXIT)event.result=token;
+    kui_native_loader_timeline_add(&trace,&event);
+}
+static void call(uint32_t before,uint32_t after,uint32_t fn,uint32_t token,uint32_t flags) {
+    if(fn==0u)sample(KUI_NATIVE_TIMELINE_ENTER,before,fn,
+        trace.have_request?trace.active.token:trace.last_token,
+        trace.have_request?KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING:0u);
+    else sample(KUI_NATIVE_TIMELINE_ENTER,before,fn,token,flags&~KUI_NATIVE_TIMELINE_COMPLETE);
+    sample(KUI_NATIVE_TIMELINE_EXIT,after,fn,token,flags);
+}
+static uint32_t loader_ticks(void) {
+    uint32_t total=0u;
+    for(unsigned i=0;i<trace.bin_count;++i)total+=trace.bins[i].gd_ticks;
+    return total;
+}
+static void test_calls_and_request_chain(void) {
+    kui_native_loader_timeline_reset(&trace);
+    /* An accepted REQUEST, a later EXEC and CHECK: real observed request
+     * time1000ticks, of which400were in the three loader calls. */
+    call(100000u,99900u,0u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    call(99500u,99300u,2u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    call(99100u,99000u,1u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.request_count==1u && !trace.have_request);
+    const struct kui_native_loader_request *r=&trace.requests[0];
+    CHECK(r->begin_tick==100000u && r->end_tick==99000u && r->total_ticks==1000u);
+    CHECK(r->inside_ticks==400u && r->outside_ticks==600u && r->calls==3u);
+    CHECK(r->lba==45001u && r->count==73u && !r->flags);
+    CHECK(trace.max_call_ticks==200u && trace.max_gap_ticks==400u && loader_ticks()==400u);
+    CHECK(trace.longest_count==3u && trace.longest[0].elapsed==200u);
+    CHECK(trace.longest[0].begin.caller_sr==0x700000f1u);
+    CHECK(trace.longest[0].end.vbr==0x8c00f400u && trace.longest[0].end.chcr==0x4911u);
+    CHECK(trace.longest[0].end.dmaor==0x8201u && trace.longest[0].end.state==0xb03u);
+    /* A distinct read begins after a small outside gap and ends200ticks
+     * later. Its chain includes the50tick proximity gap, not just IO time. */
+    call(98950u,98900u,0u,2u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    call(98800u,98750u,1u,2u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    r=&trace.requests[1];
+    CHECK(r->chain_length==2u && r->chain_ticks==1250u && r->chain_inside==500u);
+    CHECK(trace.max_chain_length==2u && trace.max_chain_ticks==1250u && trace.max_chain_inside==500u);
+    CHECK(trace.bins[0].calls==5u && trace.bins[0].read_starts==2u && trace.bins[0].read_completes==2u);
+    sample(KUI_NATIVE_TIMELINE_MAPLE,98700u,0u,0u,0u);
+    CHECK(trace.bins[0].maples==1u && trace.valid==11u && !trace.invalid);
+    /* A long gap starts a different proximity chain. */
+    call(50000u,49900u,0u,3u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.requests[2].chain_length==1u && trace.requests[2].total_ticks==100u);
+}
+static void test_bin_splitting_and_wrap(void) {
+    kui_native_loader_timeline_reset(&trace);
+    uint32_t origin=100u;
+    sample(KUI_NATIVE_TIMELINE_MAPLE,origin,0u,0u,0u);
+    uint32_t before=origin-KUI_NATIVE_TIMELINE_BIN_TICKS+10u;
+    call(before,before-30u,2u,0u,0u);
+    CHECK(trace.bin_count==2u && trace.bins[0].gd_ticks==10u && trace.bins[1].gd_ticks==20u);
+    CHECK(trace.bins[0].maples==1u && trace.bins[1].calls==1u);
+    CHECK(trace.epoch==1u && !trace.clock_breaks && trace.max_call_ticks==30u);
+    CHECK(trace.bins[1].tick==origin-KUI_NATIVE_TIMELINE_BIN_TICKS);
+    /* The raw downcounter wraps from5 through0 toUINT32_MAX. */
+    kui_native_loader_timeline_reset(&trace);
+    call(5u,UINT32_MAX-4u,2u,0u,0u);
+    CHECK(trace.max_call_ticks==10u && loader_ticks()==10u && trace.epoch==1u);
+}
+static void test_epochs_and_invalid_clocks(void) {
+    kui_native_loader_timeline_reset(&trace);
+    call(1000u,900u,0u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    sample(KUI_NATIVE_TIMELINE_ENTER,850u,2u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    event.flags=KUI_NATIVE_TIMELINE_EXIT;event.tick=800u;
+    kui_native_loader_timeline_add(&trace,&event);
+    CHECK(trace.invalid==1u && trace.clock_breaks==1u && !trace.have_request);
+    CHECK(trace.request_count==1u && (trace.requests[0].flags&KUI_NATIVE_TIMELINE_BAD_CLOCK));
+    CHECK(!trace.requests[0].total_ticks && trace.requests[0].inside_ticks==100u);
+    CHECK(trace.unmatched==1u && loader_ticks()==100u);
+    sample(KUI_NATIVE_TIMELINE_EXIT,700u,2u,1u,0u);
+    CHECK(trace.epoch==2u && trace.unmatched==2u && loader_ticks()==100u);
+    call(600u,500u,0u,2u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.requests[1].epoch==2u && trace.requests[1].chain_length==1u);
+    /* A counter that jumps backwards/up without wrapping within half the
+     * range starts another epoch and cannot form a huge call duration. */
+    sample(KUI_NATIVE_TIMELINE_ENTER,400u,2u,0u,0u);
+    sample(KUI_NATIVE_TIMELINE_EXIT,450u,2u,0u,0u);
+    CHECK(trace.epoch==3u && trace.clock_breaks==2u && trace.max_call_ticks==100u);
+    /* The wrapper may explicitly report profile changes even when the new
+     * current sample is itself an admitted profile. */
+    event.flags=KUI_NATIVE_TIMELINE_MAPLE|KUI_NATIVE_TIMELINE_CLOCK_VALID|KUI_NATIVE_TIMELINE_CLOCK_BREAK;
+    event.tick=300u;kui_native_loader_timeline_add(&trace,&event);
+    CHECK(trace.epoch==4u && trace.clock_breaks==3u && !trace.have_enter);
+}
+static void test_partial_replaced_and_failed(void) {
+    kui_native_loader_timeline_reset(&trace);
+    sample(KUI_NATIVE_TIMELINE_MAPLE,10000u,1u,11u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    call(9900u,9800u,1u,11u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.requests[0].flags==KUI_NATIVE_TIMELINE_PARTIAL);
+    CHECK(trace.requests[0].total_ticks==200u && trace.requests[0].inside_ticks==100u);
+    /* An already completed handle on subsequent CHECK must not fabricate a
+     * second request from the same token. */
+    call(9700u,9600u,1u,11u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.request_count==1u);
+    call(9500u,9400u,0u,12u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    /* A new accepted read replacing a still-open handle marks the old
+     * summary instead of attributing new-token progress to it. */
+    call(9300u,9200u,0u,13u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    CHECK(trace.request_count==2u && (trace.requests[1].flags&KUI_NATIVE_TIMELINE_REPLACED));
+    sample(KUI_NATIVE_TIMELINE_ENTER,9100u,1u,13u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    event.flags=KUI_NATIVE_TIMELINE_EXIT|KUI_NATIVE_TIMELINE_CLOCK_VALID|KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_FAILED;
+    event.tick=9000u;event.result=UINT32_MAX;kui_native_loader_timeline_add(&trace,&event);
+    CHECK(trace.request_count==3u && (trace.requests[2].flags&KUI_NATIVE_TIMELINE_REQUEST_FAILED));
+    CHECK(trace.requests[2].result==UINT32_MAX && !trace.requests[2].chain_length);
+    /* A read that becomes complete before the next call begins is closed
+     * at that first observation; the CHECK's body is not added to it. */
+    call(8900u,8800u,0u,14u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    sample(KUI_NATIVE_TIMELINE_ENTER,8700u,1u,14u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+    CHECK(trace.request_count==4u && trace.requests[3].inside_ticks==100u);
+    CHECK(trace.requests[3].outside_ticks==100u);
+}
+static void test_limits_and_stable_longest(void) {
+    kui_native_loader_timeline_reset(&trace);
+    uint32_t tick=100000u;
+    for(uint32_t i=1u;i<=24u;++i) {
+        call(tick,tick-i,0u,i,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+        tick-=100u;
+    }
+    CHECK(trace.request_count==16u && trace.request_next==8u && trace.requests[7].token==24u);
+    CHECK(trace.requests[8].token==9u && trace.longest_count==8u);
+    for(unsigned i=0;i<8u;++i) {
+        CHECK(trace.longest[i].elapsed==24u-i);
+        CHECK(trace.longest[i].end.token==24u-i && trace.longest[i].begin.function==0u);
+    }
+    CHECK(trace.max_chain_length==24u && trace.max_chain_ticks>trace.max_call_ticks);
+    /* Reset is complete, including all retained contexts and epoch state. */
+    kui_native_loader_timeline_reset(&trace);
+    CHECK(!trace.request_count && !trace.events && !trace.longest_count && !trace.bin_count);
+    sample(KUI_NATIVE_TIMELINE_MAPLE,100u,0u,0u,0u);
+    sample(KUI_NATIVE_TIMELINE_MAPLE,100u-KUI_NATIVE_TIMELINE_BINS*KUI_NATIVE_TIMELINE_BIN_TICKS,0u,0u,0u);
+    CHECK(trace.overflow==1u && trace.bin_count==1u); /* no out-of-bounds33rd bin */
+    trace.events=UINT32_MAX;sample(KUI_NATIVE_TIMELINE_MAPLE,99u-KUI_NATIVE_TIMELINE_BINS*KUI_NATIVE_TIMELINE_BIN_TICKS,0u,0u,0u);
+    CHECK(trace.events==UINT32_MAX && trace.saturated);
+    kui_native_loader_timeline_add(NULL,&event);kui_native_loader_timeline_add(&trace,NULL);
+    kui_native_loader_timeline_reset(NULL);
+}
+static void test_lifecycle_and_token_reuse(void) {
+    for(unsigned function=3u;function<=9u;function+=6u) {
+        kui_native_loader_timeline_reset(&trace);
+        call(10000u,9900u,0u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+        sample(KUI_NATIVE_TIMELINE_ENTER,9800u,function,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+        sample(KUI_NATIVE_TIMELINE_EXIT,9700u,function,0u,0u);
+        CHECK(!trace.have_request && !trace.last_token && trace.request_count==1u);
+        CHECK(trace.requests[0].flags&KUI_NATIVE_TIMELINE_REPLACED);
+        CHECK(trace.requests[0].total_ticks==300u && trace.requests[0].inside_ticks==200u);
+        call(9600u,9500u,0u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_COMPLETE);
+        CHECK(trace.request_count==2u && trace.requests[1].token==1u && !trace.requests[1].flags);
+        CHECK(trace.requests[1].chain_length==1u && trace.requests[1].total_ticks==100u);
+    }
+    /* ABORT's failure flag closes the read. An unrelated non-read token
+     * replacement cannot leave an old read open across later game work. */
+    kui_native_loader_timeline_reset(&trace);
+    call(10000u,9900u,0u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    call(9800u,9700u,8u,1u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_FAILED);
+    CHECK(trace.requests[0].flags&KUI_NATIVE_TIMELINE_REQUEST_FAILED);
+    call(9600u,9500u,0u,2u,KUI_NATIVE_TIMELINE_READ|KUI_NATIVE_TIMELINE_PENDING);
+    sample(KUI_NATIVE_TIMELINE_MAPLE,9400u,0u,0u,0u);
+    CHECK(trace.request_count==2u && !trace.have_request && !trace.last_token);
+    CHECK(trace.requests[1].flags&KUI_NATIVE_TIMELINE_REPLACED);
+}
+int main(void) {
+    test_calls_and_request_chain();test_bin_splitting_and_wrap();test_epochs_and_invalid_clocks();
+    test_partial_replaced_and_failed();test_limits_and_stable_longest();test_lifecycle_and_token_reuse();
+    printf("Native loader timeline: %u checks; %zu-byte state, call/idle split, request chains, clocks/wrap/epochs, rings and exact hardware contexts passed\n",checks,sizeof(trace));
+    return 0;
+}
diff --git a/tests/test_native_readahead_aux.c b/tests/test_native_readahead_aux.c
new file mode 100644
index 0000000..e6e0d79
--- /dev/null
+++ b/tests/test_native_readahead_aux.c
@@ -0,0 +1,745 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Auxiliary policy integration with the real sector cursor and pure cache.
+ * Low operations model one owned DMA/CRC completion at a time. Transport
+ * register/byte behaviour is covered by the separate real-reader suites. */
+#include "native_readahead_aux_internal.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#define kui_sci_stream_test_write model_stream_write
+#include "sci_stream_model.h"
+#undef kui_sci_stream_test_write
+static unsigned dma_register_writes;
+void kui_sci_stream_test_write(uint32_t address,uint32_t value,unsigned width) {
+    if(address>=SAR && address<=CHCR)++dma_register_writes;
+    model_stream_write(address,value,width);
+}
+
+#define C kui_native_readahead_aux_context
+static kui_retail_async_region_type region,other;
+kui_retail_async_region_type *kui_retail_async_region_storage=&region;
+static _Alignas(32) uint8_t arena[KUI_NATIVE_RA_DATA_BYTES];
+static uint8_t disk[640][512],output[128u*2048u];
+static struct kui_retail_manifest manifest;
+static unsigned checks,legacy_calls,fetches,stops,hooks,unhooks,feeds;
+static uint32_t pending_lba,kept_lba,token,clock_counter;
+static bool dma_available,receiving,kept_valid,raw,bad_clock;
+static bool real_model,refuse_append;
+static enum {POLL_GOOD,POLL_EARLY,POLL_REPAIR,POLL_CRC,POLL_MISSING} poll_case;
+static enum kui_sci_stream_result fetch_result;
+static enum kui_sci_stream_result stop_result;
+#define CHECK(x) do {++checks;assert(x);}while(0)
+enum {CLOSED,PAUSED,DMA,LOST,RESUME};
+static const uint32_t CARD_BASE=1000u,DISC_BASE=45000u;
+
+uint32_t kui_native_readahead_aux_test_read(uint32_t at,unsigned width) {
+    CHECK(at!=RDR); /* The observer must not consume a transport byte. */
+    if(real_model && (at==SAR || at==DAR || at==TCR || at==CHCR || at==DMAOR ||
+       at==SMR || at==BRR || at==SCR || at==SSR || at==SPTR || at==STBCR || at==PDTR))
+        return kui_sci_stream_test_read(at,width);
+    (void)width;
+    switch(at) {
+    case UINT32_C(0xffc00000):return bad_clock?0u:0xe0au;
+    case UINT32_C(0xffd80008):return UINT32_MAX;
+    case UINT32_C(0xffd80010):return 2u;
+    case UINT32_C(0xffd80004):return 1u;
+    case UINT32_C(0xffd8000c):clock_counter-=19u;return clock_counter;
+    case UINT32_C(0xffa0001c):return dma_available?0u:1u;
+    case UINT32_C(0xffa00040):return 1u;
+    case SAR:return UINT32_C(0x11111111);
+    case DAR:return UINT32_C(0x22222222);
+    case TCR:return UINT32_C(0x33);
+    case SMR:return 0x80u;
+    case BRR:case STBCR:return 0u;
+    case SCR:return 0x30u;
+    case SSR:return 0x84u;
+    case SPTR:return 0x82u;
+    case PDTR:return 0x80u;
+    default:assert(false);return 0u;
+    }
+}
+static uint8_t content(uint32_t file) {
+    uint32_t stride=raw?2352u:2048u,at=file%stride;
+    if(raw && at<16u) {
+        if(at && at<11u)return 255u;
+        return at==15u?1u:0u;
+    }
+    return (uint8_t)((file*13u)^(file>>8)^0x5au);
+}
+static void write_out(void *unused,uint32_t offset,const uint8_t *bytes,uint32_t count) {
+    (void)unused;
+    CHECK(offset<=sizeof(output) && count<=sizeof(output)-offset);
+    memcpy(output+offset,bytes,count);
+}
+static enum kui_game_result feed(struct kui_retail_cursor *cursor,const uint8_t block[512]) {
+    ++feeds;return kui_retail_cursor_feed(cursor,block);
+}
+static void hook(void) {++hooks;region.engine.hooked=1u;region.engine.release.armed=0x10u;}
+static void unhook(void) {++unhooks;region.engine.hooked=0u;region.engine.release.armed=0u;}
+static bool busy(void) {return receiving;}
+static enum kui_sci_stream_result fetch(uint32_t lba,uint32_t limit,bool polled) {
+    CHECK(!receiving && limit==256u && polled && dma_available);
+    CHECK(lba>=CARD_BASE && lba-CARD_BASE<640u);
+    CHECK(region.shared.stream.state==PAUSED && region.shared.stream.position==lba);
+    ++fetches;
+    if(fetch_result!=KUI_SCI_STREAM_OK) {
+        region.shared.stream.state=LOST;return fetch_result;
+    }
+    pending_lba=lba;kept_lba=lba;kept_valid=poll_case!=POLL_MISSING;
+    region.shared.stream.state=PAUSED;region.shared.stream.position=lba+1u;
+    return KUI_SCI_STREAM_OK;
+}
+static enum kui_sci_stream_result poll(bool interrupt) {
+    CHECK(receiving);
+    if(poll_case==POLL_EARLY) {poll_case=POLL_GOOD;return KUI_SCI_STREAM_PENDING;}
+    receiving=false;
+    if(poll_case==POLL_REPAIR) {
+        CHECK(interrupt);poll_case=POLL_GOOD;region.shared.stream.state=RESUME;
+        region.shared.stream.position=pending_lba;return KUI_SCI_STREAM_PENDING;
+    }
+    kept_valid=poll_case!=POLL_MISSING;kept_lba=pending_lba;
+    region.shared.stream.state=PAUSED;region.shared.stream.position=pending_lba+1u;
+    return KUI_SCI_STREAM_OK;
+}
+static const uint8_t *take(uint32_t lba,enum kui_sci_stream_result *result) {
+    if(!kept_valid || kept_lba!=lba) {*result=KUI_SCI_STREAM_PENDING;return NULL;}
+    if(poll_case==POLL_CRC) {
+        poll_case=POLL_GOOD;kept_valid=false;*result=KUI_SCI_STREAM_CRC;return NULL;
+    }
+    if(refuse_append)C.cache.count=KUI_NATIVE_RA_CACHE_BLOCKS;
+    *result=KUI_SCI_STREAM_OK;return disk[lba-CARD_BASE];
+}
+static enum kui_sci_stream_result stop(void) {
+    ++stops;receiving=false;kept_valid=false;region.shared.stream.state=CLOSED;
+    return stop_result;
+}
+static void legacy(uint32_t wait) {
+    (void)wait;++legacy_calls;
+    struct kui_retail_async *e=&region.engine;
+    unsigned maximum=e->in_irq?KUI_RETAIL_NATIVE_IRQ_BATCH_LIMIT:e->target;
+    for(unsigned n=0u;n<maximum && e->active && !e->failed;n++) {
+        uint32_t block=e->cursor.block;CHECK(block>=CARD_BASE && block-CARD_BASE<640u);
+        kept_valid=true;kept_lba=block;receiving=false;
+        region.shared.stream.state=PAUSED;region.shared.stream.position=block+1u;
+        CHECK(feed(&e->cursor,disk[block-CARD_BASE])==KUI_GAME_OK);
+        ++e->since;
+        if(e->in_irq)++e->stats.irq_blocks;else ++e->stats.call_blocks;
+        if(e->cursor.done==e->cursor.count)e->active=0u;
+    }
+}
+static const struct kui_native_ra_low_ops ops={
+    KUI_NATIVE_RA_OPS_MAGIC,KUI_NATIVE_RA_VERSION,sizeof(ops),
+    &kui_retail_async_region_storage,legacy,hook,unhook,fetch,poll,take,stop,busy,feed
+};
+static struct kui_native_ra_config configuration(void) {
+    return (struct kui_native_ra_config){KUI_NATIVE_RA_VERSION,sizeof(struct kui_native_ra_config),
+        &region,&ops,arena,sizeof(arena),UINT32_C(0x0c400000),KUI_NATIVE_RA_LEASE_BYTES};
+}
+static void setup(bool raw_sectors) {
+    memset(&C,0,sizeof(C));memset(&region,0,sizeof(region));memset(&other,0,sizeof(other));
+    memset(&manifest,0,sizeof(manifest));memset(output,0xa5,sizeof(output));
+    legacy_calls=fetches=stops=hooks=unhooks=feeds=0u;
+    token=0u;receiving=kept_valid=false;dma_available=true;raw=raw_sectors;bad_clock=false;
+    poll_case=POLL_GOOD;fetch_result=stop_result=KUI_SCI_STREAM_OK;
+    clock_counter=UINT32_C(0x70000000);
+    real_model=refuse_append=false;dma_register_writes=0u;
+    kui_retail_async_region_storage=&region;
+    manifest.card_sectors=10000u;manifest.partition_start=100u;manifest.partition_end=9000u;
+    manifest.track_count=manifest.extent_count=1u;
+    manifest.slots[0].track=(struct kui_retail_track){DISC_BASE,DISC_BASE+128u,1u,1u,
+        (uint8_t)(4u|(raw?0u:KUI_RETAIL_TRACK_COOKED))};
+    manifest.slots[1].extent=(struct kui_retail_extent){0u,CARD_BASE,
+        (128u*(raw?2352u:2048u)+511u)/512u};
+    for(unsigned block=0;block<640u;block++)for(unsigned byte=0;byte<512u;byte++)
+        disk[block][byte]=content(block*512u+byte);
+    region.engine.manifest=&manifest;region.engine.target=20u;
+    region.engine.opened=1u;region.shared.port.acquired=true;
+    region.shared.service.initialized=1u;
+    struct kui_native_ra_config cfg=configuration();CHECK(kui_native_readahead_aux_init(&cfg)==0);
+}
+static void begin(uint32_t sector,uint32_t count) {
+    memset(output,0xa5,sizeof(output));
+    struct kui_retail_async *e=&region.engine;
+    e->token=++token;e->active=1u;e->failed=e->retries=e->since=0u;e->in_irq=0u;
+    e->opened=1u;region.shared.port.acquired=true;
+    struct kui_retail_gd *g=&region.shared.service;
+    g->token=token;g->pending=1u;g->status=KUI_GD_PROCESSING;g->completed_bytes=0u;
+    g->lba=sector;g->count=count;g->sector_bytes=2048u;
+    CHECK(kui_retail_cursor_begin(&e->cursor,&manifest,sector,count,KUI_GAME_SECTOR_MODE1,
+        write_out,NULL)==KUI_GAME_OK);
+}
+static uint32_t visit(uint32_t event) {
+    uint32_t pending=region.shared.service.pending;
+    int32_t status=region.shared.service.status;
+    uint32_t completed=region.shared.service.completed_bytes,old_fetch=fetches;
+    unsigned old_feeds=feeds;
+    uint32_t result=kui_native_readahead_aux_dispatch(event,20u,&region,0u);
+    CHECK(region.shared.service.pending==pending && region.shared.service.status==status &&
+        region.shared.service.completed_bytes==completed);
+    CHECK(fetches-old_fetch<=1u);
+    if(event==KUI_NATIVE_RA_DELIVER)CHECK(feeds-old_feeds<=
+        (region.engine.in_irq?KUI_RETAIL_NATIVE_IRQ_BATCH_LIMIT:region.engine.target));
+    return result;
+}
+static void report(void) {
+    struct kui_retail_gd *g=&region.shared.service;
+    g->completed_bytes=region.engine.cursor.done*g->sector_bytes;
+    if(!region.engine.active && !region.engine.failed) {g->pending=0u;g->status=KUI_GD_COMPLETED;}
+}
+static void compare(uint32_t sector,uint32_t count) {
+    uint32_t stride=raw?2352u:2048u;
+    uint32_t bytes=region.shared.service.sector_bytes;
+    for(unsigned n=0;n<count;n++)for(unsigned b=0;b<bytes;b++)
+        CHECK(output[n*bytes+b]==content((sector-DISC_BASE+n)*stride+
+            (raw && bytes==2048u?16u:0u)+b));
+    CHECK(output[count*bytes]==0xa5u);
+}
+static void complete(uint32_t sector,uint32_t count) {
+    unsigned turns=0u;
+    while(region.engine.active && turns++<128u) {CHECK(visit(KUI_NATIVE_RA_DELIVER)==1u);report();}
+    CHECK(!region.engine.active && !region.engine.failed && !region.shared.service.pending);
+    compare(sector,count);
+}
+static void warm(unsigned blocks) {
+    uint32_t initial=C.stats.producer_blocks;
+    for(unsigned n=0u;n<blocks+2u && C.stats.producer_blocks-initial<blocks;n++)
+        CHECK(visit(KUI_NATIVE_RA_TICK)==1u);
+    CHECK(C.stats.producer_blocks-initial==blocks);
+}
+static void init_guards(void) {
+    setup(false);struct kui_native_ra_config cfg=configuration();
+    CHECK(kui_native_readahead_aux_init(&cfg)==-1);
+    memset(&C,0,sizeof(C));cfg.data_bytes--;
+    CHECK(kui_native_readahead_aux_init(&cfg)==-1 && !C.initialized);
+    cfg=configuration();kui_retail_async_region_storage=&other;
+    CHECK(kui_native_readahead_aux_init(&cfg)==-1 && !C.initialized);
+    kui_retail_async_region_storage=&region;cfg.version++;
+    CHECK(kui_native_readahead_aux_init(&cfg)==-1 && !C.initialized);
+    cfg=configuration();CHECK(kui_native_readahead_aux_init(&cfg)==0);
+    unsigned old_fetch=fetches,old_legacy=legacy_calls;
+    CHECK(kui_native_readahead_aux_dispatch(KUI_NATIVE_RA_DELIVER,20u,&other,0u)==1u);
+    CHECK(kui_native_readahead_aux_dispatch(KUI_NATIVE_RA_QUIESCE,0u,&region,1u)==0u);
+    CHECK(C.stats.guard_faults==2u && fetches==old_fetch && legacy_calls==old_legacy);
+}
+static void sequential(void) {
+    setup(false);begin(DISC_BASE,16u);complete(DISC_BASE,16u);
+    CHECK(C.cache.count==1u && C.cache.base==CARD_BASE+63u && !fetches);
+    warm(96u);unsigned old_legacy=legacy_calls;
+    begin(DISC_BASE+16u,16u);complete(DISC_BASE+16u,16u);
+    CHECK(C.stats.hits==64u && C.stats.hit_requests==1u && legacy_calls==old_legacy);
+    CHECK(C.cache.base==CARD_BASE+127u && C.stats.max_visit_ticks && !C.stats.clock_bad);
+    bad_clock=true;CHECK(visit(KUI_NATIVE_RA_TICK)==1u && C.stats.clock_bad==1u);
+}
+static void shared_raw_boundary(void) {
+    setup(true);begin(DISC_BASE,1u);complete(DISC_BASE,1u);
+    CHECK(C.cache.base==CARD_BASE+4u && C.cache.count==1u);
+    warm(12u);unsigned old_legacy=legacy_calls;
+    begin(DISC_BASE+1u,1u);CHECK(region.engine.cursor.block==CARD_BASE+4u);
+    complete(DISC_BASE+1u,1u);CHECK(legacy_calls==old_legacy && C.stats.hits==5u);
+}
+static void partial_hit_cap(void) {
+    setup(false);begin(DISC_BASE,1u);complete(DISC_BASE,1u);warm(2u);
+    begin(DISC_BASE+1u,1u);unsigned old_legacy=legacy_calls,old_feeds=feeds;
+    poll_case=POLL_EARLY;
+    CHECK(visit(KUI_NATIVE_RA_DELIVER)==1u);
+    CHECK(feeds-old_feeds==2u && legacy_calls==old_legacy && region.engine.active);
+    report();complete(DISC_BASE+1u,1u);CHECK(legacy_calls==old_legacy+1u);
