+        ('pending','r',0x370,2,0),('executing','r',0x374,2,0),
+        ('failed','r',0x2c0,2,0),('closed','r',0x2c4,2,0),
+        ('not_acquired','r',0x4eb,2,0),('port_fault','r',0x4ec,2,0),
