+        def plain(self,op,pc):
+            if op&0xf00f==0x6007: # NOT Rm,Rn; does not modify T.
+                self.r[op>>8&15]=(~self.r[op>>4&15])&MASK;return
+            if op>>8==0xca: # XOR #imm,R0; does not modify T.
+                self.r[0]^=op&255;return
