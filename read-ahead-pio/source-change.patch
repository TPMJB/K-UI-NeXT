+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT/'tools'),str(ROOT/'tests')]
+PIO_MARKER='__kui_native_readahead_pio_auxiliary'
+
+
+def require(ok,message):
