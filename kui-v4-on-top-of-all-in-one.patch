+      "svc0": 7.9,
+      "svc1000": 5.8,
+      "svc4000": 0.9,
+      "svc10000": 0.9
+    },
+    "slice_bytes_of_cpu_work": {
+      "note": "CPU work that fits in one slice at the measured rates (ui_hz=0): SD write 1180 KiB/s, SHA-256 2480 KiB/s",
+      "sd_write_bytes": {
