+uint16_t kui_crc16_ref(uint16_t crc, const void *data, size_t bytes) {
+    const uint8_t *p = data;
+    uint16_t tmp;
+    while(bytes--) {
+        tmp = (uint16_t)((crc >> 8) ^ *p++);
+        tmp ^= (uint16_t)(tmp >> 4);
+        crc = (uint16_t)((crc << 8) ^ (tmp << 12) ^ (tmp << 5) ^ tmp);
+    }
+    return crc;
+}
+
+uint16_t kui_crc16_table(uint16_t crc, const void *data, size_t bytes) {
+    const uint8_t *p = data;
+    while(bytes--) crc = (uint16_t)((crc << 8) ^ T0[(crc >> 8) ^ *p++]);
+    return crc;
+}
+
+/* Two bytes fold into the state at once; the two lookups are independent, so the
+ * second does not wait for the first. An odd final byte takes the one-byte step. */
+uint16_t kui_crc16_slice2(uint16_t crc, const void *data, size_t bytes) {
+    const uint8_t *p = data;
+    while(bytes >= 2) {
+        unsigned x = crc ^ (unsigned)((p[0] << 8) | p[1]);
+        crc = (uint16_t)(T2A[x >> 8] ^ T2B[x & 0xff]);
+        p += 2; bytes -= 2;
+    }
+    if(bytes) crc = (uint16_t)((crc << 8) ^ T0[(crc >> 8) ^ *p]);
+    return crc;
+}
+
+uint16_t kui_crc16_nibble(uint16_t crc, const void *data, size_t bytes) {
+    const uint8_t *p = data;
+    while(bytes--) {
+        unsigned b = *p++;
+        crc = (uint16_t)((crc << 4) ^ TN[((crc >> 12) ^ (b >> 4)) & 15]);
+        crc = (uint16_t)((crc << 4) ^ TN[((crc >> 12) ^ (b & 15)) & 15]);
+    }
+    return crc;
+}
