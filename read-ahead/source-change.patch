+    old_legacy=legacy_calls;begin(DISC_BASE+1u,1u);region.shared.service.sector_bytes=2352u;
+    CHECK(kui_retail_cursor_begin(&region.engine.cursor,&manifest,DISC_BASE+1u,1u,
