+    expected=(0x4b524131,1,64,visit,init,context[0],AUX+len(binary),STACK_BOTTOM,STACK_TOP,STACK_TOP,0,0,0,0,0,0)
+    require(header==struct.pack('<16I',*expected),'read-ahead exports/context/code/stack bindings differ')
