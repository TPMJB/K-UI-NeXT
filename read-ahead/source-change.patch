+def worker_bindings(resident,worker):
+    pins={}
+    for name,(count,digest) in WORKER_PINS.items():
+        address,body,section=symbol_bytes(worker,name,2)
+        require((len(body),sha(body))==(count,digest) and section[2]&7==6,
