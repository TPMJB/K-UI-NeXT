+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Reproduce the excluded mapper-cache prototype and baseline component checks."""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--cc", default=os.environ.get("CC", "cc"))
+parser.add_argument("--no-sanitizers", action="store_true")
+args = parser.parse_args()
+root = Path(__file__).resolve().parents[1]
+flags = ["-std=c11", "-O2", "-g", "-Wall", "-Wextra", "-Werror", "-Wpedantic",
+         "-Iinclude", "-Isrc/loader"]
+if not args.no_sanitizers:
+    flags += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
+prototype = ["src/core/retail_image.c", "src/core/retail_interleave_cache.c",
+             "src/loader/retail_sd.c", "src/loader/sd_reader.c",
+             "tests/test_retail_interleave_cache.c"]
+cases = [
+    ("cache-serial-crc", [], prototype),
+    ("cache-folded-crc", ["-DKUI_RETAIL_FAST_IO=1"], prototype),
+    ("baseline-mapper", [], ["src/core/retail_image.c", "tests/test_retail_image.c"]),
+    ("baseline-sd-protocol", ["-DKUI_RETAIL_FAST_IO=1"],
+     ["src/loader/sd_reader.c", "tests/test_loader_sd.c"]),
+    ("baseline-sci-bus", ["-DKUI_SCI_SD_TEST=1", "-DKUI_SCI_DMA_REUSE_TDRE=0"],
+     ["src/loader/sci_sd_bus.c", "tests/test_sci_sd_bus.c"]),
+    ("baseline-pilot-sci-paced", ["-DKUI_SCI_SD_TEST=1", "-DKUI_RETAIL_TRANSPORT=1",
+     "-DKUI_RETAIL_SCI_DIAGNOSTIC=1", "-DKUI_SCI_DMA_PACED=1", "-DKUI_SCI_DMA_REUSE_TDRE=0"],
+     ["src/loader/sci_sd_bus.c", "tests/test_sci_sd_dma_pacing.c"]),
+]
+environment = dict(os.environ)
+environment.setdefault("ASAN_OPTIONS", "detect_leaks=0")
+with tempfile.TemporaryDirectory(prefix="kui-interleave-cache-") as directory:
+    for name, extra, sources in cases:
+        print(name, flush=True)
+        binary = Path(directory) / name
+        subprocess.run([args.cc, *flags, *extra, *sources, "-o", str(binary)],
+                       cwd=root, check=True)
+        subprocess.run([str(binary)], cwd=root, env=environment, check=True)
+print("All six prototype/baseline configurations passed.", flush=True)
