  "source_contracts": [
    {
      "id": "phase_geometry",
      "module": "mapledev.dll",
      "rva": "0x000038a8",
      "end_rva_exclusive": "0x00003934",
      "bytes": 140,
      "rom_storage_address": "0x8c10a8a8",
      "kernel_file_offset": "0x000fb0a8",
      "sha256": "25fd08566ca81c11058df793fa35db771490008080b1e7a5d69173f6770086b8",
      "crc32_ieee": "406b03d1",
      "finding": "Block bytes are32*(decoded size field+1). Read/write phase counts are the low/high nibbles of the decoded geometry byte. Phase byte sizes are ceiling(block bytes/phase count), stored at state+48/+50."
    },
    {
      "id": "command13_finalizer",
      "module": "mapledev.dll",
      "rva": "0x000042a0",
      "end_rva_exclusive": "0x00004324",
      "bytes": 132,
      "rom_storage_address": "0x8c10b2a0",
      "kernel_file_offset": "0x000fbaa0",
      "sha256": "c63d7192c4c26c3d8a779dedc72bd4c17c754cf78e4c6c16954074ae664f66ab",
      "crc32_ieee": "c909554f",
      "finding": "Copies the supplied phase directly into the location selector, submits MEMCARD CMD13 with8-byte receive capacity, accepts response7, maps FILEERR251 to0x86850010 and every other response including AGAIN252 to0x868500b0. There is no response retry in this function."
    },
    {
      "id": "packet_submit_wait_and_timeout_poke",
      "module": "mapledev.dll",
      "rva": "0x00004c14",
      "end_rva_exclusive": "0x00004d8c",
      "bytes": 376,
      "rom_storage_address": "0x8c10bc14",
      "kernel_file_offset": "0x000fc414",
      "sha256": "058c09aa24c6b10ea191ee3f221b7f3889e62927dc9e58198318f89a64b34205",
      "crc32_ieee": "5a9c9fea",
      "finding": "Builds the generic raw-frame IOCTL request and derives its payload/receive word counts from caller byte sizes. The loop waits16ms and submits a current-token validation IOCTL after a wait timeout; this historical cancel/poke does not cancel the original raw IRP or replay an AGAIN response. The submitted location block field is restored on the normal completed-response path; early submission/wait errors can bypass that restoration."
    },
    {
      "id": "whole_read_retry",
      "module": "mapledev.dll",
      "rva": "0x00007c74",
      "end_rva_exclusive": "0x00007cc0",
      "bytes": 76,
      "rom_storage_address": "0x8c10ec74",
      "kernel_file_offset": "0x000ff474",
      "sha256": "672886c05448ee69bcbced1a6e309241fdd4a6cfca66c52fa553358e3ced82f0",
      "crc32_ieee": "a81ec2ad",
      "finding": "Invokes the whole block reader at0x7d0c up to3 total attempts, repeating only for0x86850010. It does not retry0x868500b0."
    },
    {
      "id": "whole_write_retry",
      "module": "mapledev.dll",
      "rva": "0x00007cc0",
      "end_rva_exclusive": "0x00007d0c",
      "bytes": 76,
      "rom_storage_address": "0x8c10ecc0",
      "kernel_file_offset": "0x000ff4c0",
      "sha256": "c5fb57540452514671e5291cdfa348ad89f303b6a066d4e78fb0a7aa5fc70c4b",
      "crc32_ieee": "ade5da49",
      "finding": "Invokes the whole block writer at0x7ea0 up to3 total attempts, repeating only for0x86850010. A repeat starts all write phases again; this is not a final-SYNC-only retry."
    },
    {
      "id": "read_phases_and_finalizer",
      "module": "mapledev.dll",
      "rva": "0x00007d0c",
      "end_rva_exclusive": "0x00007ea0",
      "bytes": 404,
      "rom_storage_address": "0x8c10ed0c",
      "kernel_file_offset": "0x000ff50c",
      "sha256": "c1b5b4ae1e58fb26e10cd42625fb9b2b73aed37e91f23a960743e75f2ec717ae",
      "crc32_ieee": "5e2239f4",
      "finding": "Reads phase data and checks response8, word count, function and full echoed location. After the loop, the one-phase path passes phase0 to the command13 finalizer. Other phase counts pass the advanced phase byte."
    },
    {
      "id": "write_phases_and_finalizer",
      "module": "mapledev.dll",
      "rva": "0x00007ea0",
      "end_rva_exclusive": "0x0000801c",
      "bytes": 380,
      "rom_storage_address": "0x8c10eea0",
      "kernel_file_offset": "0x000ff6a0",
      "sha256": "5bf583416ca5383e49e4b73ce10da1d2afaa70bf48dcce3337a56fbfdc512a2a",
      "crc32_ieee": "96ce6a04",
      "finding": "Starts location.phase at0; copies/pads one geometry-sized phase into the outgoing request, submits CMD12 with4-byte receive capacity, accepts only response7 with zero payload words, then increments phase and byte offset. After all block bytes, passes the advanced phase byte directly to finalizer0x42a0. A phase response other than this ACK maps to0x86850010; finalizer errors are propagated."
    },
    {
      "id": "raw_ioctl_dispatch",
      "module": "maple.dll",
      "rva": "0x00002170",
      "end_rva_exclusive": "0x000023b8",
      "bytes": 584,
      "rom_storage_address": "0x8c0b0170",
      "kernel_file_offset": "0x000a0970",
      "sha256": "74969200cdbc9e83d607facefbcaa9506faf2a7ccb2d4ef58450d0f9db32434d",
      "crc32_ieee": "c2a92603",
      "finding": "IOCTL0x220480 dispatches to raw submission0x2e60; IOCTL0x220484 dispatches to0x2f2c. Neither dispatch path supplies a worker critical-section lease."
    },
    {
      "id": "token_lookup",
      "module": "maple.dll",
      "rva": "0x000023b8",
      "end_rva_exclusive": "0x00002448",
      "bytes": 144,
      "rom_storage_address": "0x8c0b03b8",
      "kernel_file_offset": "0x000a0bb8",
      "sha256": "f595a062aca736bb221f1862d813de5e5db8aa72ec310af8d37ff944177f60a7",
      "crc32_ieee": "3cf613e2",
      "finding": "Decodes and resolves the token to a current unit/function and compares the complete function token. Failure reports an invalid/currently missing owner; success returns its unit/function coordinates."
    },
    {
      "id": "raw_request_enqueue",
      "module": "maple.dll",
      "rva": "0x00002e60",
      "end_rva_exclusive": "0x00002f1c",
      "bytes": 188,
      "rom_storage_address": "0x8c0b0e60",
      "kernel_file_offset": "0x000a1660",
      "sha256": "650171923d2332ba4604d6dfa4a4b7053cc75ec517f143333faf2d2685f19ae4",
      "crc32_ieee": "ebf9bdf5",
      "finding": "Retains the raw IRP in function+28, sets expected_response+21 to zero, captures request/capacity fields and allocates the pooled RX. A second raw request on that function is refused while its IRP is pending."
    },
    {
      "id": "timeout_poke_ioctl",
      "module": "maple.dll",
      "rva": "0x00002f2c",
      "end_rva_exclusive": "0x00002f7c",
      "bytes": 80,
      "rom_storage_address": "0x8c0b0f2c",
      "kernel_file_offset": "0x000a172c",
      "sha256": "4d697b75f39f03adc967f9a4bca1e06edfde1ea3794a4a21eae8bedd921aea6c",
      "crc32_ieee": "1ae3f766",
      "finding": "IOCTL0x220484 loads the supplied token, calls current-token lookup, and on success sets this IOCTL IRP status/information to zero. It neither cancels nor completes the original pending raw IRP and does not clear/free its RX or function state."
    },
    {
      "id": "generic_response_completion",
      "module": "maple.dll",
      "rva": "0x00002bd4",
      "end_rva_exclusive": "0x00002c4c",
      "bytes": 120,
      "rom_storage_address": "0x8c0b0bd4",
      "kernel_file_offset": "0x000a13d4",
      "sha256": "e4ccb9f83149ffc64e341d1a6d2330d66b7cbac1bcaa2edd7cd49b882880a9c7",
      "crc32_ieee": "a0292dc7",
      "finding": "Copies min(received payload bytes+4, caller output capacity) into the original raw IRP output, frees the pooled RX, clears pending request fields, sets successful status and completes the original IRP. No AGAIN-specific replay occurs here."
    },
    {
      "id": "response_walker",
      "module": "maple.dll",
      "rva": "0x00005b0c",
      "end_rva_exclusive": "0x00005d28",
      "bytes": 540,
      "rom_storage_address": "0x8c0b3b0c",
      "kernel_file_offset": "0x000a430c",
      "sha256": "171c5335957be9b7cc646a2543d6520296583741be22726f341a3b317c2c694d",
      "crc32_ieee": "04354275",
      "finding": "Expected-response zero bypasses response-code filtering, so raw storage AGAIN/FILEERR reach generic completion. The all-FF timeout path can remove a unit. This ordinary consumer runs on the same main worker; the window does not acquire a critical section."
    },
    {
      "id": "main_worker_completion_lifetime",
      "module": "maple.dll",
      "rva": "0x00005d4c",
      "end_rva_exclusive": "0x00005dd6",
      "bytes": 138,
      "rom_storage_address": "0x8c0b3d4c",
      "kernel_file_offset": "0x000a454c",
      "sha256": "76760eb4a395bfcc932f57eea999b66b5d20320f79437201903a5b8f7036ebdc",
      "crc32_ieee": "a6df4757",
      "finding": "The main worker invokes completion0x5b0c only after the ordinary interrupt status, then calls InterruptDone18 and reads the mapped port. No Enter/LeaveCriticalSection encloses completion. The call to0x16dc queries interrupt flags through KernelIoControl; it is not a critical-section operation."
    },
    {
      "id": "root_shutdown_lifetime",
      "module": "maple.dll",
      "rva": "0x00001934",
      "end_rva_exclusive": "0x00001abe",
      "bytes": 394,
      "rom_storage_address": "0x8c0af934",
      "kernel_file_offset": "0x000a0134",
      "sha256": "e35cb6be1e6482367744afbbbb6663f6bedbb64a10a992583bb783d7dbb7100f",
      "crc32_ieee": "447e02fe",
      "finding": "Root shutdown sets extension word0 to1, signals the worker, waits1000ms and may TerminateThread before releasing transport/RX-pool state. Ordinary timeout-poke behavior does not establish exclusion of this external lifecycle."
    },
    {
      "id": "raw_ioctl_request_dispatch",
      "module": "wdmlib.dll",
      "rva": "0x000014dc",
      "end_rva_exclusive": "0x00001634",
      "bytes": 344,
      "rom_storage_address": "0x8c0a64dc",
      "kernel_file_offset": "0x00096cdc",
      "sha256": "6cb68cd9ef43acaeacecf13d2daec31591a441144689e37fd9c0d98673f851e6",
      "crc32_ieee": "445bf661",
      "finding": "ControlWDMDevice builds a separate IRP for each IOCTL, assigns its own completion/overlapped context and calls IoCallDriver. STATUS_PENDING handling and optional per-file event serialization do not establish a critical section held by the MAPLE worker. The timeout poke uses a different IOCTL IRP from the pending raw request."
    },
    {
      "id": "call_driver",
      "module": "wdmlib.dll",
      "rva": "0x00001dbc",
      "end_rva_exclusive": "0x00001df4",
      "bytes": 56,
      "rom_storage_address": "0x8c0a6dbc",
      "kernel_file_offset": "0x000975bc",
      "sha256": "1fbb5659999e770354fb3773cafac040a27999a8a52ac16132bb04a40d792984",
      "crc32_ieee": "fccb82e8",
      "finding": "IoCallDriver advances the IRP stack and invokes the selected driver major-function pointer. This wrapper does not acquire or release a critical section around MAPLE dispatch."
    },
    {
      "id": "gd_read_submit_and_completion",
      "module": "wsegacd.dll",
      "rva": "0x00002d82",
      "end_rva_exclusive": "0x00002dd8",
      "bytes": 86,
      "rom_storage_address": "0x8c0abd82",
      "kernel_file_offset": "0x0009c582",
      "sha256": "1d4cded9d416a9d8a516727ebeacf8655dfa8d07eee010473e937a6125aa33ed",
      "crc32_ieee": "a0e244e7",
      "finding": "GD request commands17 and38 call the request vector, retain its returned token in r10, then pass that token as the completion helper argument. A zero request token therefore reaches the same helper as an immediate failure, not a pending job."
    },
    {
      "id": "gd_zero_token_is_io_error",
      "module": "wsegacd.dll",
      "rva": "0x000019bc",
      "end_rva_exclusive": "0x00001a14",
      "bytes": 88,
      "rom_storage_address": "0x8c0aa9bc",
      "kernel_file_offset": "0x0009b1bc",
      "sha256": "91fd2f77cf9dca3a899038bd1f6a45e747a2d535715e87bed16ad9ea984f55b8",
      "crc32_ieee": "948c4598",
      "finding": "The completion helper tests its token argument first. Zero returns STATUS_IO_DEVICE_ERROR0xc0000185 immediately, without resubmitting a GD request. A nonzero token is stored for the ordinary completion path."
    },
    {
      "id": "ce_wait_argument_homes",
      "module": "coredll.dll",
      "rva": "0x0000877c",
      "end_rva_exclusive": "0x00008788",
      "bytes": 12,
      "rom_storage_address": "0x8c03877c",
      "kernel_file_offset": "0x00028f7c",
      "sha256": "eb4ff033e28645b20333d091360c6f2b3c616b3be66fa24dc1994bb625ebc6ef",
      "crc32_ieee": "3da9df2c",
      "finding": "COREDLL export497 WaitForSingleObject pushes8 callee bytes, then writes all four argument homes at incoming caller SP+0,+4,+8,+12. The caller must reserve16 writable bytes independently of its saved PR/callee-saved registers."
    },
    {
      "id": "ce_wait_body",
      "module": "coredll.dll",
      "rva": "0x0000877c",
      "end_rva_exclusive": "0x000087bc",
      "bytes": 64,
      "rom_storage_address": "0x8c03877c",
      "kernel_file_offset": "0x00028f7c",
      "sha256": "69da824d76fa7ee8c4ccedfc9553fdf2e242d826688e4ebc64a0d1edccc4e598",
      "crc32_ieee": "dce93764",
      "finding": "Reviewed original WaitForSingleObject body and literals containing the argument-home prologue. An authored GNU-SH caller requires an explicit ABI adapter before entering this WinCE import."
    },
    {
      "id": "vblank_dma_configuration",
      "module": "maple.dll",
      "rva": "0x00001e24",
      "end_rva_exclusive": "0x00001ea8",
      "bytes": 132,
      "rom_storage_address": "0x8c0afe24",
      "kernel_file_offset": "0x000a0624",
      "sha256": "887bf8212c5aebc0b6237e5de8a48d5ca04d2704b4c2703f4dc137e91d868106",
      "crc32_ieee": "388afd03",
      "finding": "Initializes MDTSEL1, MDSTAR and MDEN1. Re-enabling MDEN permits a later VBlank to replay the current descriptor list without the ordinary worker advancing it."
    },
    {
      "id": "builder_receive_clear",
      "module": "maple.dll",
      "rva": "0x0000582c",
      "end_rva_exclusive": "0x00005a22",
      "bytes": 502,
      "rom_storage_address": "0x8c0b382c",
      "kernel_file_offset": "0x000a402c",
      "sha256": "df75f1ba377ec110c41daa5d6c4a5b29bfd82f6a3713e27ef928c246ae53f978",
      "crc32_ieee": "7a939946",
      "finding": "Rebuilds the ordinary descriptor list. The call at5964 passes function RX+0c, value0 and capacity+10 to COREDLL memset1047 through stub63b0, zeroing the receive allocation before the next DMA response. Worker call5d84 performs this rebuild before ready-write5d90 and event-wait5d9a."
    },
    {
      "id": "completion_status_query",
      "module": "nk.exe",
      "rva": "0x0001c928",
      "end_rva_exclusive": "0x0001c95a",
      "bytes": 50,
      "rom_storage_address": "0x8c02c928",
      "kernel_file_offset": "0x0001d128",
      "sha256": "1a3df3816153c237d1c3a58e675795080d9de093100a950f441ed6bf869c992d",
      "crc32_ieee": "6a2c04d7",
      "finding": "KernelIoControl10000 obtains the interrupt descriptor cached status+16. When zero, it reads the raw ASIC status through descriptor+0, masks by+12, caches the result at+16 and acknowledges those captured raw bits at1c94c. MAPLE queries this before entering its original completion consumer."
    },
    {
      "id": "normal_completion_interrupt_dispatch",
      "module": "nk.exe",
      "rva": "0x0001d158",
      "end_rva_exclusive": "0x0001d1f0",
      "bytes": 152,
      "rom_storage_address": "0x8c02d158",
      "kernel_file_offset": "0x0001d958",
      "sha256": "aacd327bc5df1f55e1efe74063afc681167b51729b8adb67f3f5091bc8e03b00",
      "crc32_ieee": "8261b81a",
      "finding": "Masks normal Maple interrupt bits and returns SYSINTR18. Masking interrupt delivery does not clear a later raw completion status bit or prevent a VBlank-triggered DMA while MDEN remains enabled."
    },
    {
      "id": "completion_interrupt_done",
      "module": "nk.exe",
      "rva": "0x0001c5c8",
      "end_rva_exclusive": "0x0001c5ec",
      "bytes": 36,
      "rom_storage_address": "0x8c02c5c8",
      "kernel_file_offset": "0x0001cdc8",
      "sha256": "ee91850d795f509679dba18f1367b53d79c7dce1a158909821383f6e0e26158b",
      "crc32_ieee": "57d26816",
      "finding": "Re-enables the descriptor interrupt mask and clears its cached status+16. It does not acknowledge a raw ASIC completion bit set after the earlier status query. A late coalesced completion can therefore be delivered to the next worker wait after RX has been rebuilt and zeroed."
    }
