# /KUI/bench.cfg  -  copy to the SD card as KUI/bench.cfg and edit freely.
# One key=value per line. '#' starts a comment. Missing file = these defaults.
# Every value is echoed into diagnostics.txt as OPTIONS lines, so a report
# always shows the settings that produced it.

# SD sweep: chunk sizes in raw 2352-byte sectors, up to 8 entries, each 1..512.
# 32 = today's capture chunk (75,264 B). 512 = 1.2 MB, about ten exFAT clusters.
# With a 2x2 transport sweep, each extra chunk size multiplies the run time;
# one chunk and expand=off keeps a full transport comparison near two minutes.
chunks=128

# MiB written (then read back) per SD run. 8 MiB at 512 sectors is only ~7
# writes, so go bigger if a large-chunk number looks noisy.
sd_mib=8

# Also run each SD chunk with f_expand() preallocation (contiguous file).
# Compare expand=1 vs expand=0 lines for the same chunk to see fragmentation cost.
expand=off

# MiB hashed per SHA-256 and CRC32 run. Pure CPU; 8 MiB takes a few seconds.
hash_mib=8

# Fixed optical range. 45150 is the start of the high-density area on every
# GD-ROM, so this range compares across discs. 4096 sectors = 9.6 MB.
optical_fad=45150
optical_sectors=4096

# SD transports to sweep, in one run: scif = bit-banged SPI, what KOS's
# sd_init() hardcodes and what every run so far used; sci = the SH4's
# synchronous serial mode, DMA capable, but it needs an adapter wired to the
# SCI pins. If yours is not, the run logs the failure, says it fell back, and
# skips that setting rather than filing SCIF numbers under "sci".
# Listing both measures both without touching the card between runs.
sd_if=scif,sci

# CRC16 read-verification settings to sweep. KOS computes this CRC on writes
# regardless, so it only moves the read rate. Listing both measures the cost.
sd_crc=on,off

# PIO service quantum for disc.c (microseconds between thd_pass yields).
# Applies to captures too. 100..20000.
yield_us=2000

# Free text for the report: card, drive, anything that could confound a run.
note=

# ---------------------------------------------------------------------------
# Experiment keys. Everything below is OFF by default: uncomment to use.
# docs/experiment-plan.md says what to run and how to read it; ready-made files
# for each step are in docs/bench-cfgs/.
#
# UI redraws per second while an operation runs, one full pass of the selected
# sections per value (0..30, or 'full' = the old unthrottled loop). DEFAULT 2:
# measured on the console, the unthrottled UI took ~32% of the CPU and 2 Hz costs
# ~5% (SD write +43%). The UI thread shares the one CPU with the measurement, so
# every result depends on it; each pass is tagged uihz= in its lines and BENCH cpu
# lines report the UI's share. It also applies to real captures (the first
# value). 0 freezes the screen while busy (B still stops). Up to 4 values.
#ui_hz=full,8,2,0
#
# Which sections run. Default optical,hash,sd. 'sweep' is the optical sweep.
#sections=optical,hash,sd,sweep
#
# The optical sweep (needs 'sweep' in sections and sweep_chunks set): reads
# sweep_sectors sectors at every combination of the lists below.
#sweep_chunks=8,16,32,64,128   # sectors per read command, 1..128, up to 8
#sweep_fads=45150,150000       # start sectors, up to 4 (default: optical_fad)
#sweep_gap_us=0,2000,10000     # CPU-busy spin after each command, up to 4
#sweep_service_us=0,1000,4000  # spin after each firmware poll inside a command
#sweep_sectors=2048            # per point; 32..65536
#sweep_verify=on               # prove every read size returns identical bytes
#                               (data tracks only; turn off for audio)
#sweep_mode=pio,dma            # EXPERIMENTAL, opt-in build only (KUI_EXPERIMENTAL=1): also read with GD-ROM DMA (even sector
#                               counts; a DMA that never completes turns DMA off until
#                               reboot). See docs/bench-cfgs/t6a-dma-probe.cfg
#sweep_spin=off,on             # run a competing CPU-bound thread; reports free= (its
#                               CPU share) and what it costs the read
#
# Extra SD write sizes in BYTES (whole 512-byte blocks, 4096..1204224, up to 6),
# run in addition to chunks= to test alignment with the 128 KiB clusters.
#sd_bytes=65536,131072,262144,524288
#
# Capture engine choices. These are real options of the capture engine: a REAL
# capture uses the FIRST value of each list; the bench's `capture` section runs
# the engine at every combination. Defaults are the engine as it has always been.
#capture_hash=both,crc32      # both = SHA-256 + CRC32; crc32 = CRC32 only (a job keeps
#                               the mode it started with; schema 2 manifest)
#end_readback=on,off          # re-read every saved byte after capture. off is for
#                               crc32 jobs only; Verify always re-reads
#resume_check=full,size       # size: sizes only, crc32 jobs only. It cannot see a
#                               corrupted prefix; the end read-back or PC verifier will
#sample_readback=0,32         # re-read + compare 1 chunk in N while capturing
#capture_sectors=4096         # bench: sectors per capture run
#capture_fad=45150            # bench: where it starts (default optical_fad)
#capture_type=data            # data (EDC checked) or audio
#sections=capture             # run the capture section
