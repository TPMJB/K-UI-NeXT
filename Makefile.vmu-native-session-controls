# Opt-in native SCI session services. Keep the established 112 KiB worker /
# 324 KiB complete lease and full 192 KiB cache; compact baseline is separate.
BUILD ?= build/native-session-controls
include Makefile.vmu-native-split-controller-stream-guard
# The base stamp is also consulted when switching BACK to an ordinary
# General build. Distinguish this ABI there, not only in session-config,
# whose dependency disappears outside the optional profile. This variable
# selects only the incremental-build witness, never compiled reader policy.
override VMU_READER_PROFILE = session-controls-$(if $(filter -DKUI_VMU_VIRTUAL_A1=1,$(FLAGS)),a1,a2)
FLAGS += -DKUI_NATIVE_SESSION_CONTROLS=1
NATIVE_FLAGS += -DKUI_NATIVE_SESSION_CONTROLS=1 -DKUI_RETAIL_MANIFEST_SLOTS=64
# The worker operates on the exact native reader region during a pinned
# loan, so its shared structures use the reader's complete layout selectors.
NATIVE_FLAGS += -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 \
 -DKUI_RETAIL_LOW_RESIDENT=1 -DKUI_GENERAL_SCI_RESUME_FIX=1 -DKUI_RETAIL_TRANSPORT=1 -DKUI_SCI_SD_NO_BLOCK=1
# The optional lifecycle state uses the fixed vector gaps occupied by the
# old timing-only high-water counters. Preserve every vector address rather
# than enlarging low state or reducing the complete read-ahead cache.
FLAGS := $(filter-out -DKUI_NATIVE_REQUEST_TIMING=1,$(FLAGS)) -DKUI_NATIVE_REQUEST_TIMING=0
NATIVE_FLAGS := $(filter-out -DKUI_NATIVE_REQUEST_TIMING=1,$(NATIVE_FLAGS)) -DKUI_NATIVE_REQUEST_TIMING=0
NATIVE_SRC += src/core/native_session.c src/core/native_return.c \
 src/core/native_disc_set.c src/core/retail_gd.c src/core/storage_policy.c src/loader/native_return_hardware.c
NATIVE_OBJ += $(BUILD)/native_return_hardware_asm.o
override STAGE_SRC += src/core/native_session.c src/core/native_return.c src/core/storage_policy.c
override VMU_READER_EXPORTS += -Wl,-u,_kui_retail_native_session_control
$(BUILD)/native_return_hardware_asm.o: src/loader/native_return_hardware.S $(BUILD)/readonly-config
	@mkdir -p $(@D)
	$(CC) $(NATIVE_FLAGS) -c $< -o $@
$(BUILD)/native-worker.elf: $(NATIVE_OBJ)
$(BUILD)/stage.elf: $(STAGE_OBJ)
$(RESIDENT_OBJ) $(LEGACY_OBJ) $(STAGE_OBJ) $(NATIVE_OBJ) $(WORKER_OBJ) $(RA_OBJ): $(BUILD)/readonly-config
# Every effective profile flag participates in the incremental-build witness;
# readonly-config predates this optional profile and omits arbitrary FLAGS.
session_quote = '$(subst ','"'"',$(1))'
.PHONY: session-config-force
session-config-force:
$(BUILD)/session-config: session-config-force
	@mkdir -p $(@D)
	@printf '%s\n' $(call session_quote,CC=$(CC)) $(call session_quote,FLAGS=$(FLAGS)) \
	 $(call session_quote,NATIVE_FLAGS=$(NATIVE_FLAGS)) \
	 $(call session_quote,SESSION=1 TIMING=0 MANIFEST=64 A1=$(filter -DKUI_VMU_VIRTUAL_A1=1,$(FLAGS))) >$@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp
$(RESIDENT_OBJ) $(LEGACY_OBJ) $(STAGE_OBJ) $(NATIVE_OBJ) $(WORKER_OBJ) $(RA_OBJ): \
 Makefile.vmu-native-session-controls Makefile.vmu-native-session-controls-a1 $(BUILD)/session-config
$(BUILD)/retail-native-session-controls.kui: $(BUILD)/retail-native-dual.kui
	cp $< $@
all: $(BUILD)/retail-native-session-controls.kui

.PHONY: session-config-host-tests
session-config-host-tests:
	python3 tests/test_native_session_config.py
