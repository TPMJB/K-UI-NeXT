BUILD ?= build/vmu-runtime-test
HOST_CC ?= cc
HOST_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-omit-frame-pointer -fno-pie -no-pie
.DEFAULT_GOAL := test
.PHONY: test native-object
$(BUILD)/runtime: tests/test_vmu_native_runtime.c src/core/vmu_native_runtime.c \
 include/kui/vmu_native_runtime.h include/kui/vmu_native_discovery.h
	@mkdir -p $(@D)
	$(HOST_CC) $(HOST_FLAGS) -Iinclude tests/test_vmu_native_runtime.c src/core/vmu_native_runtime.c -o $@
test: $(BUILD)/runtime
	ASAN_OPTIONS=detect_leaks=0 $<
native-object:
	@mkdir -p $(BUILD)
	sh-elf-gcc -std=c11 -Os -Wall -Wextra -Werror -m4-single -ml -ffreestanding \
	 -fno-builtin -fstack-usage -Iinclude -c src/core/vmu_native_runtime.c -o $(BUILD)/native-runtime.o
