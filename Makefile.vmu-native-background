# SPDX-License-Identifier: GPL-3.0-only
# Explicit native Background SCI + virtual A2 candidate. Standard keeps its
# independently linked module and synchronous storage gateway.
BUILD ?= build/vmu-native-background
override VMU_READER_PROFILE := background
override RESIDENT_LAYOUT := src/loader/vmu_native_background_resident.ld
override RESIDENT_SRC := src/loader/vmu_native_background_resident.c src/core/retail_gd.c \
 src/core/retail_pace.c src/loader/minic.c src/core/retail_image.c \
 src/loader/retail_display.c src/loader/sci_sd_bus.c src/core/retail_cursor.c \
 src/loader/sci_stream.c src/loader/retail_async.c
override VMU_INIT_EXPORT := -Wl,-u,_kui_vmu_native_background_init
override VMU_READER_EXPORTS := -Wl,-u,_kui_retail_async_irq -Wl,-u,_kui_retail_irq_entry \
 -Wl,-u,_kui_vmu_native_background_manifest_bind
include Makefile.vmu-native-compat
FLAGS += -DKUI_VMU_NATIVE_BACKGROUND=1 -DKUI_RETAIL_NATIVE_HYBRID=1
RESIDENT_FLAGS += -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 -DKUI_SCI_SD_NO_BLOCK=1

.PHONY: background-host-tests
background-host-tests:
	python3 tests/test_vmu_native_async_loan.py
	python3 tests/test_vmu_native_async_vectors.py
	python3 tests/test_vmu_native_background_gateway.py
	python3 tests/test_vmu_native_background_init.py
	python3 tests/test_vmu_native_background_bind.py
	$(HOST_CC) -std=c11 -O2 -Wall -Wextra -Werror -pedantic -Iinclude \
	 tests/test_vmu_native_background_map.c -o $(BUILD)/test-background-map
	$(BUILD)/test-background-map
