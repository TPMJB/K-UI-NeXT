BUILD ?= build/vc2-read-cache-host
HOST_CC ?= cc
FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
 -ffunction-sections -fdata-sections -Iinclude -Isrc/loader \
 -DKUI_VC2_VMU_PERSIST=1 -DKUI_ARMADA_CE_VMU_RUNTIME_TEST=1 \
 -DKUI_ARMADA_CE_VMU_WRITE_RUNTIME=1 -DKUI_ARMADA_CE_MAPLE_WRITE_LAYOUT=1 \
 -DKUI_ARMADA_CE_MAPLE_WRITE_STAGING=1
.PHONY: all
all:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(FLAGS) tests/test_vc2_ce_vmu_read_cache.c src/core/vmu_deferred_io.c \
	 src/core/retail_image.c -Wl,--gc-sections -o $(BUILD)/cache
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/cache
