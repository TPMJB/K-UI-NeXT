  "decision": {
    "add_previous_four_holes": false,
    "reason": "Every proposed hole cuts populated pads and routed copper. Inserting these holes would require moving components/rerouting and native DRC/connectivity requalification. It cannot preserve the current layout unchanged.",
    "reuse_module_only_geometry": "Official source hash, C5 origin and all sixteen spring-centroid positions agree. The former module pocket and corner bearing patches are useful reference geometry, but the complete bases/caps/backers are incompatible because their attachment is through the four obstructed holes.",
    "selected_next_path": "Independent rigid carrier support and C5 end clamp anchored outside current populated/routed carrier. Exact chassis/fixture anchors must come from physical fit measurements; do not infer mounting points from the paper perimeter.",
    "new_fixture_cad_generated": false,
    "new_fixture_cad_reason": "Current carrier provides no proven native mounting holes and no measured external anchor/obstacle map. A printable fixture would invent its attachment geometry.",
    "bounded_hole_relocation_review_performed": false,
    "bounded_hole_relocation_reason": "No new design loop was authorized for this one-pass reconciliation; changing hole positions would also change arm/pocket geometry and require full copper, component and force validation."
  },
  "required_physical_checks": [
    {
      "check": "Print carrier template at 100%; measure both 50 mm calibration bars, then confirm board perimeter and north/south registration against assembled console.",
      "purpose": "Choose verified independent support points without exposing or assuming motherboard clearance."
    },
    {
      "check": "Measure modified USB-free C5 bare PCB thickness, total height, antenna connector/cable and removal envelope.",
      "purpose": "Replace source thickness metadata and qualify actual clamp seat and shield clearance."
    },
    {
      "check": "Map local underside obstacles and shield height at all independent fixture anchors and C5 corners.",
      "purpose": "2.5 mm underside stand-off and 8 mm upper region are nominal assumptions, not verified clearances."
    },
    {
      "check": "Use insulating precision supports to establish 0.90 mm nominal module underside-to-carrier gap; measure loaded gap at all corners to0.87\u20130.93mm and confirm XYalignment within\u00b10.10mm.",
      "purpose": "Keep sixteen contacts within published working limits without relying on raw printer dimensions."
    },
    {
      "check": "Bench-test retention above 6.24 N aggregate spring reaction, including spring maximum/lot variation, PCB deflection, fastener retention and operating-temperature creep.",
      "purpose": "6.24 N is a minimum-contact-force sum; it is not an established maximum force or mechanical load proof."
    }
  ],
  "contact_height_and_load_contract": {
    "mpn": "Harwin S7221-45R",
    "recommended_working_gap_mm": 0.9,
    "minimum_working_gap_mm": 0.63,
    "free_height_range_mm": [
      1.1,
      1.23
    ],
    "minimum_contact_force_N": 0.39,
    "contacts": 16,
    "minimum_total_contact_force_N": 6.24,
    "source": "Existing manufacturer-derived spring contract in design/sources/xiao-c5-spring-contact-placement.json; exact dimensional/force qualification remains required."
  },
  "limitations": [
    "This audit establishes that the former four holes are destructive on the current carrier; it does not establish that every possible new mounting position is impossible.",
    "Previous module-only component-interference checks and elastic estimates do not qualify a carrier attachment, spring maximum, installed console fit or thermal endurance.",
    "Do not drill the carrier or fabricate the old attachment models from this review."
  ],
