diff --git a/docs/bench-cfgs/t9-pipeline.cfg b/docs/bench-cfgs/t9-pipeline.cfg
new file mode 100644
index 0000000..efb69ee
--- /dev/null
+++ b/docs/bench-cfgs/t9-pipeline.cfg
@@ -0,0 +1,27 @@
+# TRIP 9 - does overlapping the disc read with the SD write actually work?  (about 3 minutes)
+# This measures a capture's inner loop - read a chunk, write it to the card, CRC32 it - three
+# ways on the real drive and the real card, WITHOUT touching the capture engine or writing a
+# dump. The scratch file is deleted afterwards.
+#
+#   pio-sequential   what the engine does today
+#   dma-sequential   the same, read by DMA: isolates the read
+#   dma-overlapped   double-buffered: the drive fills the next chunk while the CPU writes and
+#                    CRC32s this one. This is the design Trip 6a argues for.
+#
+# All three CRC32 the same bytes, so the three crc32= values MUST be identical. If they are
+# not, the overlap is broken and nothing built on it can be trusted.
+#
+# Needs the EXPERIMENTAL build (a branch whose name ends in -experimental). Without it the run
+# says so and measures pio-sequential only.
+#
+# Predicted from Trip 6a and T7 (docs/evidence/): dma-overlapped should approach the SD write's
+# own rate, since the disc time hides behind it. If dma-overlapped is no faster than
+# dma-sequential, the overlap is not happening and the engine change is not worth making.
+
+ui_hz=2
+sections=pipeline
+
+capture_fad=45150
+capture_sectors=4096
+
+note=T9 pipeline overlap. card=<model> disc=<title>
