# Actual production loan C, modeled only at SR/cache operation boundaries.
BUILD ?= build/vc2-loan-host
HOST_CC ?= cc
.DEFAULT_GOAL := vc2-loan-host-tests
VC2_LOAN_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie \
 -Iinclude -Isrc/loader -DKUI_RETAIL_MANIFEST_SLOTS=48 \
 -DKUI_RETAIL_NATIVE_HYBRID=1 -DKUI_RETAIL_ASYNC=1 -DKUI_RETAIL_GD_ASYNC=1 \
 -DKUI_RETAIL_TRANSPORT=1 -DKUI_RETAIL_LOW_RESIDENT=1 \
 -DKUI_NATIVE_STANDALONE_READER=1 -DKUI_NATIVE_STANDALONE_FOREGROUND=1 \
 -DKUI_NATIVE_OCRAM_BOOTSTRAP=1 -DKUI_NATIVE_REQUEST_TIMING=1 \
 -DKUI_NATIVE_GD_LEGACY_STREAM=1 -DKUI_NATIVE_GD_MMU_BUFFERS=1 \
 -DKUI_NATIVE_GD_DMA_STREAM=1 -DKUI_NATIVE_GD_PIO_STREAM=1 \
 -DKUI_NATIVE_GD_VRAM_DMA=1 -DKUI_ARMADA_CE_VMU_WRITE_RUNTIME=0
.PHONY: vc2-loan-host-tests
vc2-loan-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LOAN_FLAGS) tests/test_vc2_ce_vmu_loan.c -o $(BUILD)/test-vc2-loan
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-vc2-loan
