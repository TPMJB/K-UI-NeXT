# Production foreground/card C with modeled SCI registers and card bytes.
# This establishes no SH exception/cache behavior, SD timing or compatibility.
BUILD ?= build/vc2-late-host
HOST_CC ?= cc
.DEFAULT_GOAL := vc2-late-host-tests
VC2_LATE_COMMON := $(shell python3 -c "from tools.run_native_standalone_foreground import DEFINITIONS, FLAGS; print(' '.join((*FLAGS,*('-D'+x for x in DEFINITIONS))))")
VC2_LATE_FLAGS := $(VC2_LATE_COMMON) -DKUI_NATIVE_OCRAM_BOOTSTRAP=1 \
 -DKUI_NATIVE_GD_LEGACY_STREAM=1 -DKUI_NATIVE_GD_MMU_BUFFERS=1 \
 -DKUI_NATIVE_GD_DMA_STREAM=1 -DKUI_NATIVE_GD_PIO_STREAM=1 \
 -DKUI_NATIVE_GD_VRAM_DMA=1 -DKUI_VC2_VMU_LATE=1
VC2_LATE_SOURCES := tests/test_retail_async_foreground.c \
 src/loader/retail_async.c src/loader/sci_stream.c src/core/retail_cursor.c \
 src/core/retail_image.c src/core/retail_gd.c
VC2_LATE_PURE_FLAGS := -std=c11 -O1 -g -Wall -Wextra -Werror -Wpedantic \
 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-pie -no-pie -Iinclude
VC2_LATE_GATE_FLAGS := $(VC2_LATE_PURE_FLAGS) -Isrc/loader \
 -DKUI_RETAIL_ASYNC_TEST=1 -DKUI_NATIVE_OCRAM_BOOTSTRAP=1 -DKUI_NATIVE_GD_LEGACY_STREAM=1
VC2_LATE_GATE_SOURCES := tests/test_vc2_ce_vmu_gate.c src/loader/vc2_ce_vmu_service.c
.PHONY: vc2-late-header-tests vc2-late-gate-tests vc2-late-ui-tests vc2-late-report-tests
vc2-late-report-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LATE_PURE_FLAGS) tests/test_vc2_ce_vmu_late_report.c -o $(BUILD)/test-late-report
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-report
vc2-late-header-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LATE_PURE_FLAGS) tests/test_vc2_ce_vmu_late.c -o $(BUILD)/test-late-header
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-header
vc2-late-gate-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LATE_GATE_FLAGS) -DKUI_VC2_VMU_LATE=0 $(VC2_LATE_GATE_SOURCES) -o $(BUILD)/test-gate-staged
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-gate-staged
	$(HOST_CC) $(VC2_LATE_GATE_FLAGS) -DKUI_VC2_VMU_LATE=1 $(VC2_LATE_GATE_SOURCES) -o $(BUILD)/test-gate-late
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-gate-late
vc2-late-ui-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LATE_PURE_FLAGS) -ffunction-sections -fdata-sections \
	 -DKUI_VMU_GAME_CARDS=1 -DKUI_RETAIL_EXTENDED_MAP=1 -I.deps/fatfs/source -Isrc/dreamcast \
	 tests/test_vc2_ce_vmu_late_prepare.c src/core/retail_image.c -Wl,--gc-sections -o $(BUILD)/test-late-ui
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-ui
.PHONY: vc2-late-host-tests
vc2-late-host-tests:
	@mkdir -p $(BUILD)
	$(HOST_CC) $(VC2_LATE_FLAGS) -fsanitize=undefined $(VC2_LATE_SOURCES) \
	 -Wl,--wrap=kui_sci_stream_stop -o $(BUILD)/test-late-ubsan
	UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-ubsan
	UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-ubsan --vc2-late-stop
	$(HOST_CC) $(VC2_LATE_FLAGS) -fsanitize=address,undefined $(VC2_LATE_SOURCES) \
	 -Wl,--wrap=kui_sci_stream_stop -o $(BUILD)/test-late-asan
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-asan
	ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 $(BUILD)/test-late-asan --vc2-late-stop
