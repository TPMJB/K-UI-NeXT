new file mode 100644
index 0000000..681cb94
--- /dev/null
+++ b/docs/bench-cfgs/t10-capture-dma.cfg
@@ -0,0 +1,32 @@
+# TRIP 10 - the overlapped capture engine, on the real engine.  (about 6 minutes)
+# EXPERIMENTAL build only (a branch whose name ends in -experimental).
+#
+# capture_read=pio,dma runs the SAME capture twice: once reading the disc as the engine
+# always has, once reading it with GD-ROM DMA and starting the next chunk's read while the
+# current one is written and hashed. Everything else is identical, so the difference is the
+# overlap and nothing else.
+#
+# What to read:
+#   BENCH capture ... kib_s      the two rates. Trip 9 measured the loop at +34%; this is the
+#                                engine, which also does EDC, checkpoints and the plan.
+#   BENCH capture parts ... disc  should collapse on the dma row: that time is now hidden.
+#
+# The engine falls back to an ordinary PIO read for any chunk it cannot overlap: an odd
+# sector count, or the single-sector reads that follow a bad sector. The bytes are the same
+# either way; tests/test_capture_options.py proves that on the host against a byte-for-byte
+# reference, including a bad EDC, a stop and resume, and a drive that refuses DMA.
+#
+# This publishes nothing and deletes its jobs. Do a real rip (t7 with capture_read=dma) and
+# verify it on the PC before trusting it.
+
+ui_hz=2
+sections=capture
+
+capture_fad=45150
+capture_sectors=4096
+capture_type=data
+capture_hash=crc32
+end_readback=off
+capture_read=pio,dma
+
+note=T10 overlapped capture. card=<model> disc=<title>
